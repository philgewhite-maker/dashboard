# This repo is PUBLIC (it's what GitHub Pages serves), so anything committed
# here is world-readable. sync.php holds the shared secret once configured,
# so the working copy is ignored and only sync.php.example — which carries
# the placeholder — is tracked. Copy the example, fill in your secret, and
# upload that; never rename it back.
server/sync.php
# notion.php holds your Notion integration token, which can read and write
# your entire workspace. Same rule: only the .example is tracked.
server/notion.php
# files.php holds the same shared secret as sync.php. Same rule again.
server/files.php
# image-proxy.php holds the same shared secret too.
server/image-proxy.php
# recipe-fetch.php holds the same shared secret too.
server/recipe-fetch.php
# health.php holds the same shared secret too.
server/health.php
# telegram-bot.php holds the same shared secret, PLUS a Telegram bot token
# and a separate webhook secret -- same rule again.
server/telegram-bot.php

# The synced document and its lock/temp files, in case anyone ever points
# $DATA_FILE inside the repo folder while testing.
dashboard-data.json
*.json.lock
*.json.tmp
health-data.jsonl
telegram-inbox.jsonl
*.jsonl.lock

# Scratch folder for pasting real screenshots/photos in for debugging --
# never belongs in a public repo.
Debug/
# gemini-transcribe.php holds the same shared secret PLUS a Gemini API key.
# It was tracked by mistake while every other secret-carrying file was not:
# the key was still a placeholder so nothing leaked, but one fill-in-and-commit
# would have published it. Same rule as the rest now.
server/gemini-transcribe.php
# claude-test.php holds its own separate secret (deliberately never the
# same as any of the above -- see the .example's own comment). Same rule.
server/claude-test.php
# This session's own copy of that secret, for curling claude-test.php
# directly from here -- never committed, never pasted into chat.
.claude/nas-test.env
