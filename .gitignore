# This repo is PUBLIC (it's what GitHub Pages serves), so anything committed
# here is world-readable. The server files in server/ hold no secrets; every
# secret and key lives in dashboard-config.php on the web host only. Ignored
# by name in case a filled-in copy ever lands in this folder.
dashboard-config.php

# The synced document and its lock/temp files, in case anyone ever points
# $DATA_FILE inside the repo folder while testing.
dashboard-data.json
*.json.lock
*.json.tmp
health-data.jsonl
telegram-inbox.jsonl
*.jsonl.lock

# Scratch folder for pasting real screenshots/photos in for debugging --
# never belongs in a public repo.
Debug/
# gemini-transcribe.php holds the same shared secret PLUS a Gemini API key.
# It was tracked by mistake while every other secret-carrying file was not:
# the key was still a placeholder so nothing leaked, but one fill-in-and-commit
# would have published it. Same rule as the rest now.
server/gemini-transcribe.php
# claude-test.php holds its own separate secret (deliberately never the
# same as any of the above -- see the .example's own comment). Same rule.
server/claude-test.php
# This session's own copy of that secret, for curling claude-test.php
# directly from here -- never committed, never pasted into chat.
.claude/nas-test.env

# switchadvisor.php holds its own admin secret; switchadvisor-scan.php
# holds a commands.php device token PLUS an Anthropic API key. Same rule
# as every other secret-carrying file: only the .example is tracked.
server-switchadvisor/switchadvisor.php
server-switchadvisor/switchadvisor-scan.php
server-switchadvisor/switchadvisor-scan-config.php
# The invite-only app's own two documents, same reasoning as
# dashboard-data.json above -- never actually written here (they live one
# directory above public_html on the real host), just a guard in case
# anyone points the config at a path inside the repo while testing.
switchadvisor-data.json
switchadvisor-cache.json

# Real (non-.example) secret-bearing server files; only the .example is tracked.
# (records.php and sync-connections.php are tracked on purpose and not listed.)
server/auth.php
server/commands.php
server/pair.php
server/agent-write.php
server/ai-runs.php
server/ics-proxy.php
server/product-image-proxy.php
# Env files, personal review material, local tool config, python cache.
.env
*.env
!*.env.example
Files for review by Claude/
.claude/
__pycache__/
*.pyc
