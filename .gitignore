# This repo is PUBLIC (it's what GitHub Pages serves), so anything committed
# here is world-readable. sync.php holds the shared secret once configured,
# so the working copy is ignored and only sync.php.example — which carries
# the placeholder — is tracked. Copy the example, fill in your secret, and
# upload that; never rename it back.
server/sync.php
# notion.php holds your Notion integration token, which can read and write
# your entire workspace. Same rule: only the .example is tracked.
server/notion.php
# files.php holds the same shared secret as sync.php. Same rule again.
server/files.php
# image-proxy.php holds the same shared secret too.
server/image-proxy.php
# recipe-fetch.php holds the same shared secret too.
server/recipe-fetch.php
# health.php holds the same shared secret too.
server/health.php

# The synced document and its lock/temp files, in case anyone ever points
# $DATA_FILE inside the repo folder while testing.
dashboard-data.json
*.json.lock
*.json.tmp
health-data.jsonl
*.jsonl.lock
