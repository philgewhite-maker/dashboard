<?php
declare(strict_types=1);

/**
 * Fetches an image server-side and hands back the raw bytes.
 *
 * Why this exists: an <img> tag can display an image from these hosts fine,
 * but the browser can't always read those bytes back out via fetch() — no
 * Access-Control-Allow-Origin header — which an AI comparison or a saved
 * photo attachment needs (the bytes have to travel somewhere as base64 or a
 * blob, not just render on screen). Google Photos never sends that header;
 * Tinder's photo CDN turned out to be inconsistent about it — the exact
 * same URL shape 200'd with the header present on one fetch and absent on
 * another, confirmed live. PHP has no CORS restriction at all (that's a
 * browser concept), so this endpoint fetches the URL on the server and
 * returns the bytes to the browser, which is then free to use them however
 * it likes.
 *
 *   GET ?url=<allowed-hosted-image-url>   -> the image bytes
 *
 * This is deliberately NOT a general-purpose proxy. `$ALLOWED_HOSTS` is the
 * entire safety model: without it, this would fetch any URL a caller (or an
 * attacker who obtained the secret) supplied, including internal network
 * addresses — a classic SSRF hole. Every URL is checked against that list
 * before any request is made.
 *
 * Upload next to sync.php and files.php (cPanel -> File Manager) and set
 * $SECRET to the SAME value as those. See README.md, "Photo comparison".
 */

// ---- Configuration ---------------------------------------------------

// Must match sync.php and files.php exactly.
$SECRET = 'PUT-A-LONG-RANDOM-STRING-HERE';

// Only these hosts can ever be fetched.
$ALLOWED_HOSTS = [
    // Google Photos serves images from both of these depending on context
    // (album covers vs. direct photo links).
    'photos.fife.usercontent.google.com',
    'lh3.googleusercontent.com',
    // Tinder's profile photo CDN.
    'images-ssl.gotinder.com',
];

$MAX_BYTES = 8 * 1024 * 1024;
$TIMEOUT_SECONDS = 10;

$ALLOWED_ORIGINS = [
    'https://philgewhite-maker.github.io',
    'http://localhost:8743',
    'http://localhost:5173',
];

// ---- End of configuration --------------------------------------------

$origin = $_SERVER['HTTP_ORIGIN'] ?? '';
if ($origin !== '' && in_array($origin, $ALLOWED_ORIGINS, true)) {
    header('Access-Control-Allow-Origin: ' . $origin);
    header('Vary: Origin');
}
header('Access-Control-Allow-Headers: X-Sync-Secret');
header('Access-Control-Allow-Methods: GET, OPTIONS');
header('Access-Control-Max-Age: 86400');
header('Cache-Control: no-store');
header('X-Content-Type-Options: nosniff');

if (($_SERVER['REQUEST_METHOD'] ?? '') === 'OPTIONS') {
    http_response_code(204);
    exit;
}

function fail(int $code, string $message): void {
    http_response_code($code);
    header('Content-Type: application/json');
    echo json_encode(['error' => $message]);
    exit;
}

$provided = $_SERVER['HTTP_X_SYNC_SECRET'] ?? '';
if ($SECRET === '' || $SECRET === 'PUT-A-LONG-RANDOM-STRING-HERE') {
    fail(500, 'Server not configured: set $SECRET in image-proxy.php');
}
if (!is_string($provided) || !hash_equals($SECRET, $provided)) {
    fail(401, 'Bad or missing sync secret');
}

if (($_SERVER['REQUEST_METHOD'] ?? 'GET') !== 'GET') {
    fail(405, 'Use GET');
}

$url = $_GET['url'] ?? '';
$parts = is_string($url) ? parse_url($url) : false;
if (
    !is_array($parts)
    || ($parts['scheme'] ?? '') !== 'https'
    || !isset($parts['host'])
    || !in_array($parts['host'], $ALLOWED_HOSTS, true)
) {
    fail(400, 'That URL is not on an allowed image host');
}

$ch = curl_init($url);
curl_setopt_array($ch, [
    CURLOPT_RETURNTRANSFER => true,
    // Google's own signed image URLs commonly 302 to a different Google
    // host before serving the bytes (confirmed live: a real album cover
    // URL 302'd rather than serving directly) — refusing to follow that
    // broke every real fetch, not just a hypothetical one. Followed, but
    // capped at 3 hops and re-checked against the SAME host allowlist
    // below once curl is done: the attacker's only lever is the URL given
    // in the first place, already checked above, and Google's own servers
    // choosing where their own signed link redirects isn't something an
    // external caller controls.
    CURLOPT_FOLLOWLOCATION => true,
    CURLOPT_MAXREDIRS => 3,
    CURLOPT_TIMEOUT => $TIMEOUT_SECONDS,
    CURLOPT_MAXFILESIZE => $MAX_BYTES,
    CURLOPT_PROTOCOLS => CURLPROTO_HTTPS,
    CURLOPT_REDIR_PROTOCOLS => CURLPROTO_HTTPS,
    CURLOPT_USERAGENT => 'dashboard-image-proxy/1.0',
]);
$bytes = curl_exec($ch);
$httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
$contentType = curl_getinfo($ch, CURLINFO_CONTENT_TYPE) ?: 'image/jpeg';
$effectiveUrl = curl_getinfo($ch, CURLINFO_EFFECTIVE_URL);
$err = curl_error($ch);
curl_close($ch);

if ($bytes === false) {
    fail(502, "Could not fetch the image: $err");
}
if ($httpCode < 200 || $httpCode >= 300) {
    fail(502, "The source returned HTTP $httpCode for that image");
}
$landedHost = parse_url((string) $effectiveUrl, PHP_URL_HOST);
if (!in_array($landedHost, $ALLOWED_HOSTS, true)) {
    fail(502, 'A redirect led somewhere unexpected — refusing to return it');
}
if (strlen($bytes) > $MAX_BYTES) {
    fail(502, 'Image exceeded the size limit');
}
if (strpos($contentType, 'image/') !== 0) {
    fail(502, 'That URL did not return an image');
}

header('Content-Type: ' . $contentType);
header('Content-Length: ' . (string) strlen($bytes));
echo $bytes;
