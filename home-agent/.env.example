# Copy to .env next to docker-compose.yml and fill in. This file stays on
# the NAS: it holds the only copy of your Plex token, which is exactly why
# the agent polls outward instead of anything reaching in.

# The sync URL the dashboard uses (Settings -> Live sync). commands.php is
# found next to it automatically.
DASHBOARD_SYNC_URL=https://example.co.uk/sync.php

# Give the agent its OWN token rather than the shared secret. It can't open
# a pairing link, but redeeming a code is just a POST, so:
#
#   1. Dashboard -> Settings -> Devices -> Add a device, note the code.
#   2. curl -s -X POST "https://example.co.uk/pair.php?action=redeem" \
#        -H "Content-Type: application/json" \
#        -d '{"code":"ABCD-EFGH","label":"QNAP agent"}'
#   3. Paste the `token` from the reply below.
#
# Worth the extra minute: the NAS then shows up in the device list with a
# last-used time, and if it is ever compromised you revoke that one row
# instead of re-pairing every phone and laptop you own. The shared secret
# still works too, unless you have set $DASH_ALLOW_MASTER_SECRET = false in
# auth.php -- in which case this is the only way in.
DASHBOARD_SECRET=a-device-token-from-pair.php

# Plex. With network_mode: host in docker-compose.yml, localhost is the NAS
# itself; otherwise use its LAN address, e.g. http://192.168.1.10:32400
PLEX_URL=http://localhost:32400
# Get one from Plex Web: play something, ... -> Get Info -> View XML, and
# copy the X-Plex-Token from the URL that opens.
PLEX_TOKEN=

# Radarr and Sonarr, if you've set them up (see nas-stack/SETUP.md). With
# network_mode: host these are on localhost; each API key is in that app's
# Settings -> General. Leave blank and download requests simply report
# that they're not configured.
RADARR_URL=http://localhost:7878
RADARR_API_KEY=
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# How often the agent asks the web host for work. This is also how long
# anything you press in the app may sit waiting before the agent even
# looks, so it is an interactivity setting more than a load one: 15s is
# four requests a minute to your own host, which is nothing.
POLL_SECONDS=15

# Which browser page.fetch should look like, below the headers. Worth
# trying for any site that refuses a plain request outright (Cloudflare's
# "Just a moment" page) -- changing it is a restart, not a rebuild:
#   docker compose up -d
# Try in order, checking `docker logs` for the byte count each one gets:
# chrome124, chrome120, chrome116, safari17_0, edge101.
#
# NOT the answer for Agent Provocateur specifically. Every target here
# plateaued at the same 73,705 bytes against AP's 194,677 in a real
# browser -- confirmed, not merely untried. What's missing there is added
# by JavaScript after the page loads, which no amount of fingerprinting
# supplies; see page.render and BROWSER_URL below for that one.
PAGE_IMPERSONATE=chrome

# page.render: a real browser, for pages like AP's product pages where
# the set is added by JavaScript and no plain request -- however it's
# dressed up -- ever receives it. Needs the `browser` service in
# docker-compose.yml running (`docker compose up -d`); leave BROWSER_URL
# blank to leave it unused, which is the default and costs nothing extra.
#
# http://localhost:3000 works because the browser service publishes to
# 127.0.0.1 and this agent runs with network_mode: host -- the same
# connection sees both. BROWSER_TOKEN only needs to match the browser
# service's own TOKEN below; it's not a secret from the internet, since
# nothing outside the NAS can reach port 3000 at all.
# Blank until you've brought the `browser` service up -- see
# docker-compose.yml. Once it's running, this is the value to uncomment:
#   BROWSER_URL=http://localhost:3000
BROWSER_URL=
BROWSER_TOKEN=
