# Copy to .env next to docker-compose.yml and fill in. This file stays on
# the NAS: it holds the only copy of your Plex token, which is exactly why
# the agent polls outward instead of anything reaching in.

# The same sync URL and secret the dashboard uses (Settings -> Live sync).
# commands.php is found next to it automatically.
DASHBOARD_SYNC_URL=https://example.co.uk/sync.php
DASHBOARD_SECRET=the-same-string-as-sync.php

# Plex. With network_mode: host in docker-compose.yml, localhost is the NAS
# itself; otherwise use its LAN address, e.g. http://192.168.1.10:32400
PLEX_URL=http://localhost:32400
# Get one from Plex Web: play something, ... -> Get Info -> View XML, and
# copy the X-Plex-Token from the URL that opens.
PLEX_TOKEN=

# Radarr and Sonarr, if you've set them up (see nas-stack/SETUP.md). With
# network_mode: host these are on localhost; each API key is in that app's
# Settings -> General. Leave blank and download requests simply report
# that they're not configured.
RADARR_URL=http://localhost:7878
RADARR_API_KEY=
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# How often to ask for work. Lower feels snappier and costs a request each
# time; 45s is a reasonable idle cost for a box that's always on.
POLL_SECONDS=45
