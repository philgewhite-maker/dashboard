<?php
declare(strict_types=1);

/**
 * Weekly scrape for the bank-switch advisor's shared cache.
 *
 * Runs ONCE for every invited user at once — the whole point of caching
 * (see server-switchadvisor/README.md). Reuses the dashboard's own NAS
 * home-agent channel (commands.php's enqueue/pending/result/status
 * protocol — "one shared Chrome container", see home-agent/agent.py) to
 * fetch MoneySavingExpert's switch-offers page and the CASS participant
 * list through a real residential browsing session, exactly the way
 * js/features/switchoffers.js already does for the personal dashboard.
 * This script just triggers it on a schedule and writes the RESULT to
 * its own, separate cache file — it never touches dashboard-data.json.
 *
 * Turning the MSE page's prose into structured {bank, amount,
 * conditions, ...} rows is the one AI call in this whole app (see the
 * plan's "why deterministic matching, not AI-per-request") — it runs
 * HERE, once per scrape, never per user request. The CASS participant
 * list needs no AI at all: it's a clean data-value attribute on the
 * page, same regex js/features/switchoffers.js already uses.
 *
 * Trigger: a cPanel cron job hitting this URL weekly, e.g.
 *   wget -q -O /dev/null "https://yourdomain/switchadvisor-scan.php?secret=YOUR_SCAN_SECRET"
 * or the admin page's own "Refresh now" button (same URL, same secret).
 *
 * Setup: copy to switchadvisor-scan.php, fill in every value below,
 * upload next to switchadvisor.php. See server-switchadvisor/README.md
 * for pairing this script as its own home-agent "device" and for where
 * the Anthropic key comes from.
 */

// ---- Configuration ---------------------------------------------------

// The five values only you know -- $SCAN_SECRET, $COMMANDS_URL,
// $COMMANDS_SECRET, $ANTHROPIC_API_KEY and $KRAKEN_TERMS_URL -- live in
// switchadvisor-scan-config.php next to this file (copy it from
// switchadvisor-scan-config.php.example). Kept out of this script so that
// uploading a newer copy of it never wipes them: every earlier update
// reset the Anthropic key and the Kraken URL to placeholders.
$configFile = __DIR__ . '/switchadvisor-scan-config.php';
if (!is_file($configFile)) {
    http_response_code(500);
    header('Content-Type: application/json');
    echo json_encode(['ok' => false, 'error' => 'Server not configured: upload switchadvisor-scan-config.php next to this file (copy switchadvisor-scan-config.php.example and fill it in)']);
    exit;
}
require $configFile;

// Not secret, so they stay here and update with the script.
$ANTHROPIC_MODEL = 'claude-sonnet-5-5';
$MSE_SWITCH_URL = 'https://www.moneysavingexpert.com/banking/compare-best-bank-accounts/#switch';
$CASS_LIST_URL = 'https://www.currentaccountswitch.co.uk/banks-building-societies/';
// "Current account" searches on both cashback sites. Bank deals are flat
// sums ("£25"), not percentages, so the dashboard's own rate parser
// (js/cashback.js) can't read them, and bank merchant pages sit at
// addresses that can't be guessed (/first-direct/ and /santander/ both
// missed); one search per site lists every current-account deal together.
$TOPCASHBACK_SEARCH_URL = 'https://www.topcashback.co.uk/search/merchants/?s=current%20account';
$QUIDCO_SEARCH_URL = 'https://www.quidco.com/search/?search=current%20account';

// Same path switchadvisor.php's own $CACHE_FILE points at — MUST match.
$CACHE_FILE = dirname(__DIR__) . '/switchadvisor-cache.json';

// Oldest-first, capped — mirrors data.switchOffersHistory's own cap in
// the dashboard (~2 years of weekly snapshots).
$HISTORY_CAP = 104;

// ---- End of configuration --------------------------------------------

header('Content-Type: application/json');
header('Cache-Control: no-store');

function fail(int $code, string $message): void {
    http_response_code($code);
    echo json_encode(['ok' => false, 'error' => $message]);
    exit;
}

if ($SCAN_SECRET === '' || strpos($SCAN_SECRET, 'PUT-') === 0) fail(500, 'Server not configured: set $SCAN_SECRET');
$provided = (string) ($_GET['secret'] ?? $_SERVER['HTTP_X_SCAN_SECRET'] ?? '');
if (!hash_equals($SCAN_SECRET, $provided)) fail(401, 'Bad or missing scan secret');

set_time_limit(400);

// ---- Talk to commands.php, same protocol the home-agent itself expects --

// Diagnostic cache, surfaced in the final error so a failed run says WHY
// rather than just "didn't work" — a self-to-self curl call (this script
// and commands.php live on the same host) is exactly the kind of thing
// that fails silently on shared hosting (loopback/firewall blocks), and
// without this there's no log file to check for the real reason.
$GLOBALS['__last_commands_call_debug'] = null;

function commands_call(string $url, string $secret, string $method, string $query, array $body = []) {
    $ch = curl_init($url . '?' . $query);
    $opts = [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_HTTPHEADER => ['Content-Type: application/json', 'X-Sync-Secret: ' . $secret],
        CURLOPT_TIMEOUT => 30,
        CURLOPT_CONNECTTIMEOUT => 10,
    ];
    if ($method === 'POST') {
        $opts[CURLOPT_POST] = true;
        $opts[CURLOPT_POSTFIELDS] = json_encode($body);
    }
    curl_setopt_array($ch, $opts);
    $start = microtime(true);
    $response = curl_exec($ch);
    $elapsed = round(microtime(true) - $start, 2);
    $curlErrno = curl_errno($ch);
    $curlError = curl_error($ch);
    $status = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    $GLOBALS['__last_commands_call_debug'] = "{$method} {$query} -> HTTP {$status} in {$elapsed}s" . ($curlError ? " | curl errno {$curlErrno}: {$curlError}" : '') . ($response !== false ? ' | body: ' . substr((string) $response, 0, 200) : ' | no response body');
    if ($response === false) return ['ok' => false, 'error' => "curl errno {$curlErrno}: {$curlError}"];
    $parsed = json_decode($response, true);
    return ['ok' => $status === 200, 'status' => $status, 'data' => is_array($parsed) ? $parsed : null];
}

// Enqueues a page.render for each URL, then polls `status` every 5s
// until every job is done/error or $maxSeconds runs out — the agent
// itself is paced ~4s between fetches, so this just needs to outlast
// however many pages are queued.
function fetch_pages(string $commandsUrl, string $secret, array $urls, int $maxSeconds = 150): array {
    $ids = [];
    foreach ($urls as $key => $url) {
        $r = commands_call($commandsUrl, $secret, 'POST', 'action=enqueue', ['verb' => 'page.render', 'args' => ['url' => $url]]);
        if (!$r['ok'] || empty($r['data']['id'])) { $ids[$key] = null; continue; }
        $ids[$key] = $r['data']['id'];
    }
    $results = [];
    $deadline = time() + $maxSeconds;
    while (time() < $deadline) {
        $pending = array_filter($ids, fn($id, $key) => $id && !isset($results[$key]), ARRAY_FILTER_USE_BOTH);
        if (!$pending) break;
        $idList = implode(',', array_filter($ids));
        $r = commands_call($commandsUrl, $secret, 'GET', 'action=status&ids=' . urlencode($idList));
        if ($r['ok'] && !empty($r['data']['commands'])) {
            foreach ($r['data']['commands'] as $c) {
                $key = array_search($c['id'], $ids, true);
                if ($key === false || isset($results[$key])) continue;
                if (in_array($c['status'] ?? '', ['done', 'error'], true)) $results[$key] = $c;
            }
        }
        if (count($results) >= count(array_filter($ids))) break;
        sleep(5);
    }
    return $results;
}

// ---- HTML -> plain text, same sibling-walk-from-an-anchor idea as
// js/features/switchoffers.js's own extractSection, since the real page
// anchors its switch-offers section on the <h2 id="switch"> itself. --

function strip_html_to_text(string $html): string {
    $html = preg_replace('/(?is)<(script|style|noscript|svg|nav|footer|header|aside|form|iframe|button|select|label)[^>]*>.*?<\/\1>/', ' ', $html) ?? $html;
    $text = preg_replace('/(?s)<[^>]+>/', ' ', $html) ?? $html;
    $text = html_entity_decode($text, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    return trim(preg_replace('/\s+/', ' ', $text) ?? $text);
}

function extract_section(string $html, string $anchorId, int $maxChars): string {
    if (!preg_match('/id=["\']' . preg_quote($anchorId, '/') . '["\']/', $html, $m, PREG_OFFSET_CAPTURE)) {
        return substr(strip_html_to_text($html), 0, $maxChars);
    }
    $start = $m[0][1];
    $chunk = substr($html, $start, $maxChars * 8);
    return substr(strip_html_to_text($chunk), 0, $maxChars);
}

// The text of ONE <h2 id="..."> section of the page, up to the next <h2> --
// bounded by the page's own structure rather than a character guess, so a
// section that grows is never silently cut off mid-offer.
function extract_h2_section(string $html, string $id, int $maxChars): string {
    if (!preg_match('/<h2[^>]*id=["\']' . preg_quote($id, '/') . '["\']/', $html, $m, PREG_OFFSET_CAPTURE)) return '';
    $start = $m[0][1];
    $end = strpos($html, '<h2', $start + 10);
    return substr(strip_html_to_text(substr($html, $start, ($end === false ? strlen($html) - $start : $end - $start))), 0, $maxChars);
}

function extract_cass_participants(string $html): array {
    preg_match_all('/accordion__item banks-and-building-societies__accordion-item[^>]*data-value=["\']([^"\']+)["\']/', $html, $m);
    return array_values(array_unique(array_map(fn($v) => html_entity_decode($v, ENT_QUOTES | ENT_HTML5, 'UTF-8'), $m[1] ?? [])));
}

// ---- The one AI call: turn the switch-offers prose (and, if
// configured, Kraken's tier terms) into structured JSON. -----------------

function call_anthropic(string $apiKey, string $model, string $prompt, int $maxTokens): array {
    $ch = curl_init('https://api.anthropic.com/v1/messages');
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST => true,
        CURLOPT_HTTPHEADER => ['Content-Type: application/json', 'x-api-key: ' . $apiKey, 'anthropic-version: 2023-06-01'],
        CURLOPT_POSTFIELDS => json_encode(['model' => $model, 'max_tokens' => $maxTokens, 'messages' => [['role' => 'user', 'content' => $prompt]]]),
        CURLOPT_TIMEOUT => 170,
    ]);
    $response = curl_exec($ch);
    $status = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    if ($response === false) return ['ok' => false, 'error' => 'unreachable'];
    if ($status !== 200) return ['ok' => false, 'error' => "Anthropic returned HTTP {$status}: " . substr((string) $response, 0, 300)];
    $parsed = json_decode($response, true);
    $text = '';
    foreach (($parsed['content'] ?? []) as $block) {
        if (($block['type'] ?? '') === 'text') $text .= $block['text'];
    }
    // Strip a markdown fence if the model added one despite being asked not to.
    $text = preg_replace('/^```(json)?|```$/m', '', trim($text)) ?? $text;
    $json = json_decode(trim($text), true);
    if (!is_array($json)) return ['ok' => false, 'error' => 'Could not parse a JSON object from the response'];
    return ['ok' => true, 'data' => $json];
}

// ---- Run ---------------------------------------------------------------

if ($COMMANDS_URL === '' || strpos($COMMANDS_URL, 'yourdomain') !== false) fail(500, 'Server not configured: set $COMMANDS_URL');
if ($COMMANDS_SECRET === '' || strpos($COMMANDS_SECRET, 'PUT-') === 0) fail(500, 'Server not configured: set $COMMANDS_SECRET');
if ($ANTHROPIC_API_KEY === '' || strpos($ANTHROPIC_API_KEY, 'PUT-') === 0) fail(500, 'Server not configured: set $ANTHROPIC_API_KEY');

$urls = ['mse' => $MSE_SWITCH_URL, 'cass' => $CASS_LIST_URL, 'tcb' => $TOPCASHBACK_SEARCH_URL, 'quidco' => $QUIDCO_SEARCH_URL];
if ($KRAKEN_TERMS_URL !== '') $urls['kraken'] = $KRAKEN_TERMS_URL;

$pages = fetch_pages($COMMANDS_URL, $COMMANDS_SECRET, $urls);

// page.render answers {pages: [{url, status, html}]} -- one entry per URL
// asked for, so one here. Reading result.html directly was the bug that
// made every scan report "no result" even though all the pages had come
// back fine (the debug output showed the jobs "done" with the HTML in
// result.pages[0]); the dashboard's own JS reads it the same way, as
// `const { pages } = await run('page.render', ...)`.
function rendered_html($job): string {
    if (!is_array($job) || ($job['status'] ?? '') !== 'done') return '';
    $page = $job['result']['pages'][0] ?? null;
    return is_array($page) ? (string) ($page['html'] ?? '') : '';
}

$mseHtml = rendered_html($pages['mse'] ?? null);
if ($mseHtml === '') {
    $mseJob = $pages['mse'] ?? null;
    $why = is_array($mseJob) ? ($mseJob['error'] ?? ($mseJob['result']['pages'][0]['error'] ?? ('job status ' . ($mseJob['status'] ?? 'unknown') . ', no HTML in the result'))) : 'the job never finished in time';
    fail(502, 'Could not fetch the MSE switch-offers page via the home agent — is it running? (' . $why . ') [debug: ' . ($GLOBALS['__last_commands_call_debug'] ?? 'no calls made') . ']');
}
$scanWarnings = [];
$switchText = extract_h2_section($mseHtml, 'switch', 60000);
if ($switchText === '') $switchText = extract_section($mseHtml, 'switch', 30000);
$ongoingText = extract_h2_section($mseHtml, 'cashback', 30000);

$cassHtml = rendered_html($pages['cass'] ?? null);
$cassParticipants = $cassHtml !== '' ? extract_cass_participants($cassHtml) : [];

// ---- Cashback deals ---------------------------------------------------------
// Plain text split on tags, so a deal reads as a short run of tokens
// ("first direct", "Current Account", "£25 Cashback") rather than markup.
function html_to_tokens(string $html): array {
    $html = preg_replace('/(?is)<(script|style|noscript|svg)[^>]*>.*?<\/\1>/', ' ', $html) ?? $html;
    $text = preg_replace('/(?s)<[^>]+>/', '|', $html) ?? $html;
    $text = html_entity_decode($text, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    return array_values(array_filter(array_map('trim', explode('|', $text)), fn($p) => $p !== ''));
}

// Quidco lists "<name> | Earn | £20 | cashback". Its page says all rates shown
// are the PREMIUM-member rate, which the recommendations repeat.
function parse_quidco_deals(array $t): array {
    $deals = [];
    for ($i = 1; $i + 2 < count($t); $i++) {
        if ($t[$i] !== 'Earn' || strtolower($t[$i + 2]) !== 'cashback') continue;
        if (!preg_match('/^£(\d+(?:\.\d+)?)$/u', $t[$i + 1], $m)) continue;
        $name = $t[$i - 1];
        if (stripos($name, 'current account') === false) continue;
        $deals[] = ['provider' => 'quidco', 'name' => $name, 'amount' => (float) $m[1]];
    }
    return $deals;
}

// TopCashback splits the name across elements ("first direct", "Current
// Account", a badge, then "£25 Cashback"), so a deal is everything since the
// previous deal's amount. Results run from the column header to "You may also
// be interested in", after which come OTHER merchants (confirmed on the live
// page: "NatWest Rooster Money £7") that must not be read as bank deals.
function parse_topcashback_deals(array $t): array {
    $deals = [];
    $from = array_search('Highest %', $t, true);
    $from = $from === false ? 0 : $from + 1;
    $to = count($t);
    foreach ($t as $i => $tok) {
        if (stripos($tok, 'You may also be interested') === 0) { $to = $i; break; }
    }
    $name = [];
    for ($i = $from; $i < $to; $i++) {
        $tok = $t[$i];
        if (preg_match('/^£(\d+(?:\.\d+)?) Cashback$/iu', $tok, $m)) {
            $amount = (float) $m[1];
            $full = trim(implode(' ', $name));
            $name = [];
            if (stripos($full, 'current account') !== false) $deals[] = ['provider' => 'topcashback', 'name' => $full, 'amount' => $amount];
            continue;
        }
        if (stripos($tok, 'Exclusive Offer') === 0 || $tok === 'Popularity') continue;
        $name[] = $tok;
    }
    return $deals;
}

$cashbackDeals = [];
$tcbHtml = rendered_html($pages['tcb'] ?? null);
if ($tcbHtml !== '') $cashbackDeals = array_merge($cashbackDeals, parse_topcashback_deals(html_to_tokens($tcbHtml)));
$quidcoHtml = rendered_html($pages['quidco'] ?? null);
if ($quidcoHtml !== '') $cashbackDeals = array_merge($cashbackDeals, parse_quidco_deals(html_to_tokens($quidcoHtml)));

// ---- Reading the offers into a structured shape (schema 2) ---------------------
// Three kinds of call, all through the same helper:
//   1. a short one that lists the offers on the page and the banking groups;
//   2. several in parallel, each extracting the full structure for a few named
//      offers (a narrow task, so each is read closely, and none runs long);
//   3. one for the "ongoing cashback & perks" accounts you can keep.
// Whatever comes back is validated; an offer that cannot be read this week is
// carried over from the last good scan rather than dropped.

$OFFER_SCHEMA = <<<'TXT'
Each offer is ONE JSON object in exactly this shape. Use null (or [] / false) for anything the page does not state — never guess a number. Dates are "YYYY-MM-DD". For a DEADLINE (a switch must start/complete by, an offer end date) with no year, use the next occurrence of it on or after today's date. This does NOT apply to the eligibility rules below.

{
 "id": "lowercase-hyphenated product name, e.g. 'barclays-premier'",
 "bank": "short bank name, e.g. 'Barclays'",
 "product": "the account's own name, e.g. 'Barclays Premier'",
 "tier": "'standard', or 'high-earner' when it is one of the premier-style accounts aimed at high salaries or large savings",
 "serviceRating": number or null (the '% great' figure),
 "jointAllowed": true / false / null,
 "howToOpen": "one short sentence: app / online / branch, sole or joint",
 "conditions": "two sentences at most summarising what you have to do and who is excluded",
 "switch": {
   "required": true unless the page states a genuine no-switch route (then still true for the switch route),
   "minDirectDebits": number or null (Direct Debits/standing orders that must be switched in),
   "withinDaysOfOpening": number or null (days after opening within which the switch must be done),
   "startBy": date or null (the switch must START by), "completeBy": date or null (must COMPLETE by),
   "notFromGroups": ["names of banks/groups you must not switch FROM, e.g. 'Halifax', 'Bank of Scotland'"]
 },
 "requirements": [ one entry per thing you must do, each with its own numbers:
   {"id": "short unique id like 'dd','sal1','dep','cards','login'",
    "type": "direct-debits | salary | pay-in | debit-card-payments | card-spend | app-login | min-balance | keep-open | other",
    "count": number or null (how many Direct Debits, or how many card payments),
    "amount": number or null (GBP: the salary per month, the deposit, the spend),
    "period": "'once' (a single event), 'each-month' (repeated every month), or 'total' (a one-off amount that may be paid in several parts)",
    "months": number or null (for 'each-month' items: how many months from the FIRST month, counting it, the requirement must hold for the payment that depends on it to be earned; e.g. salary in the first month plus five more = 6. A requirement about the FIRST month only (\"within 30 days\", \"in the first month\") is months 1. If the page does not say how many months a monthly requirement lasts, it MUST be null — never a guess),
    "withinDays": number or null (days allowed to meet it),
    "anchor": "'opening' (days counted from opening the account), 'switch-start', or 'switch-complete'",
    "source": "for pay-in/salary: 'employer' when it must be salary/pension/benefit by Bacs from an employer or similar (not your own accounts), 'any' when money from anywhere counts, otherwise null",
    "mustStayDays": number or null (how long a deposit must remain; 24 hours = 1),
    "assumed": true only if you filled a number the page did not state,
    "text": "one plain sentence on exactly what counts, including what the page does NOT say (e.g. 'The page does not say whether transfers from your own accounts count')"} ],
 "payments": [ one entry per distinct payment; a monthly instalment series is ONE entry with count and intervalMonths:
   {"amount": number (each instalment), "count": number (instalments, default 1), "intervalMonths": 1 for monthly or null,
    "anchor": "'conditions-met' (paid a while after you meet the conditions — the usual case), 'switch-start' (paid within N days of the switch STARTING whatever else you do), or 'switch-complete'",
    "conditionsWithinDays": number or null (days you have to meet this payment's conditions),
    "paidWithin": {"value": number, "unit": "'working days', 'days', or 'day-of-following-month' (e.g. 'paid by the 20th of the following month' = value 20)"},
    "requirementIds": ["ids of the requirements this payment depends on"],
    "note": "e.g. '£150 upfront' or '5 x £30'"} ],
 "eligibility": {
   "heldAccount": {"mode": "'since' = excluded if you held an account at any time since/after the date ('since 1 Jan 2023'); 'on' = excluded only if you held one ON that day ('No Santander current account on 1 Jan 2026'); 'open-by' = excluded if you still have an open account that was opened on or before the date ('no currently open account on or before 1 Oct')", "since": date or null (only when the page gives a FULL date including the year, e.g. 'since 1 Jan 2023' or 'on 1 Jan 2026'), "dateText": "when the rule's date has NO year (e.g. 'on or before 1 Oct', 'on 6 May', 'on or after 2 Sep'), the phrase exactly as written, and leave since null — never turn a year-less date into a since date", "ever": true if it is for people who have NEVER had any product/account with the bank, "scope": "which banks the rule covers, e.g. 'HSBC or First Direct'"},
   "bonusReceived": {"since": date or null (no previous switch bonus since this date; if only a year is given use 1 January of it), "ever": true if any previous switch bonus from the bank excludes you, "scope": "..."},
   "otherBankRules": [{"group": "ANOTHER bank group's name", "event": "'opened-account' or 'held-account'", "since": date or null}],
   "income": {"minAnnual": number or null (only when the page states an EARNINGS requirement, e.g. 'Earn £100,000+ a year'. A monthly pay-in that the page merely says is 'equivalent to' a salary — e.g. 'pay in £5,000 a month (equivalent to an £85,000 salary)' — is a pay-in requirement, NOT an earnings requirement: leave this null), "basis": "'gross' (before tax) or 'net' only if the page says so, else null", "altRoute": "a way to qualify that is not salary, e.g. '£100,000+ saved/invested', else ''", "altRouteNoSwitch": true if that alternative needs no switch}
 },
 "fees": {"monthly": number or null, "waivedBy": "what waives it, else ''"},
 "perks": [{"name": "what you get, e.g. 'Apple TV included'", "annualValue": number or null (only when the page states or clearly implies a yearly value), "needs": "what it requires"}],
 "ongoing": [{"kind": "'cashback', 'interest', 'saver' or 'perk'", "name": "...", "annualValue": number or null (NET of the account's own fee, only if stated or clearly computable from the page), "needs": "what you must do to get it"}]
}

A WORKED EXAMPLE of the format (an invented bank; do not copy its values): "Exampleshire Plus" pays £100 upfront for switching 2+ Direct Debits and paying in £500+ within 30 days of opening, then £20 a month for three months if you also make 5+ card payments each month; the £100 is paid within 14 working days of meeting the conditions and each £20 within 28 days; not for anyone who held an Exampleshire account since 1 Jan 2024.
{"id":"exampleshire-plus","bank":"Exampleshire","product":"Exampleshire Plus","tier":"standard","serviceRating":60,"jointAllowed":true,"howToOpen":"Open in the app.","conditions":"£100 for switching 2+ Direct Debits and paying in £500+, then £20 a month for three months.","switch":{"required":true,"minDirectDebits":2,"withinDaysOfOpening":null,"startBy":null,"completeBy":null,"notFromGroups":[]},"requirements":[{"id":"dd","type":"direct-debits","count":2,"amount":null,"period":"once","months":null,"withinDays":null,"anchor":"opening","source":null,"mustStayDays":null,"assumed":false,"text":"Switch in 2+ Direct Debits."},{"id":"dep","type":"pay-in","count":null,"amount":500,"period":"total","months":null,"withinDays":30,"anchor":"opening","source":"any","mustStayDays":null,"assumed":false,"text":"Pay in £500+ within 30 days of opening; the page does not say whether it must stay."},{"id":"cards","type":"debit-card-payments","count":5,"amount":null,"period":"each-month","months":4,"withinDays":null,"anchor":"opening","source":null,"mustStayDays":null,"assumed":false,"text":"5+ card payments in each of the three months after the first."}],"payments":[{"amount":100,"count":1,"intervalMonths":null,"anchor":"conditions-met","conditionsWithinDays":30,"paidWithin":{"value":14,"unit":"working days"},"requirementIds":["dd","dep"],"note":"£100 upfront"},{"amount":20,"count":3,"intervalMonths":1,"anchor":"conditions-met","conditionsWithinDays":null,"paidWithin":{"value":28,"unit":"days"},"requirementIds":["cards"],"note":"3 x £20"}],"eligibility":{"heldAccount":{"since":"2024-01-01","dateText":"","ever":false,"scope":"Exampleshire"},"bonusReceived":{"since":null,"ever":false,"scope":""},"otherBankRules":[],"income":{"minAnnual":null,"basis":null,"altRoute":"","altRouteNoSwitch":false}},"fees":{"monthly":null,"waivedBy":""},"perks":[],"ongoing":[]}
TXT;

// The model sometimes wraps the JSON in a sentence or adds a trailing remark;
// take the outermost object if the text as a whole doesn't parse.
function parse_json_loose(string $text): ?array {
    $text = preg_replace('/^```(json)?|```$/m', '', trim($text)) ?? $text;
    $j = json_decode(trim($text), true);
    if (is_array($j)) return $j;
    $a = strpos($text, '{');
    $b = strrpos($text, '}');
    if ($a === false || $b === false || $b <= $a) return null;
    $j = json_decode(substr($text, $a, $b - $a + 1), true);
    return is_array($j) ? $j : null;
}

function slugify_id(string $s): string { return trim(preg_replace('/[^a-z0-9]+/', '-', strtolower($s)), '-'); }

// Parallel version of call_anthropic: all requests go out at once and the
// results come back keyed the same way.
function call_anthropic_multi(string $apiKey, string $model, array $jobs): array {
    $mh = curl_multi_init();
    $handles = [];
    foreach ($jobs as $key => $job) {
        $ch = curl_init('https://api.anthropic.com/v1/messages');
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true, CURLOPT_POST => true,
            CURLOPT_HTTPHEADER => ['Content-Type: application/json', 'x-api-key: ' . $apiKey, 'anthropic-version: 2023-06-01'],
            CURLOPT_POSTFIELDS => json_encode(['model' => $model, 'max_tokens' => $job['maxTokens'], 'messages' => [['role' => 'user', 'content' => $job['prompt']]]]),
            CURLOPT_TIMEOUT => 170,
        ]);
        curl_multi_add_handle($mh, $ch);
        $handles[$key] = $ch;
    }
    do {
        $status = curl_multi_exec($mh, $running);
        if ($running) curl_multi_select($mh, 1.0);
    } while ($running && $status === CURLM_OK);
    $out = [];
    foreach ($handles as $key => $ch) {
        $response = curl_multi_getcontent($ch);
        $code = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_multi_remove_handle($mh, $ch);
        curl_close($ch);
        if ($code !== 200 || !is_string($response)) { $out[$key] = ['ok' => false, 'error' => "HTTP {$code}: " . substr((string) $response, 0, 200)]; continue; }
        $parsed = json_decode($response, true);
        $text = '';
        foreach (($parsed['content'] ?? []) as $block) if (($block['type'] ?? '') === 'text') $text .= $block['text'];
        $json = parse_json_loose($text);
        $out[$key] = $json !== null ? ['ok' => true, 'data' => $json] : ['ok' => false, 'error' => 'not valid JSON (' . ($parsed['stop_reason'] ?? '?') . '), starts: ' . substr(trim($text), 0, 120) . ' ... ends: ' . substr(trim($text), -160)];
    }
    curl_multi_close($mh);
    return $out;
}

function offer_total_amount(array $o): float {
    $t = 0.0;
    foreach ((array) ($o['payments'] ?? []) as $p) $t += (float) ($p['amount'] ?? 0) * max(1, (int) ($p['count'] ?? 1));
    return $t;
}

// Cheap structural checks; the engine validates and derives the rest.
function scan_offer_ok(array $o): bool {
    return !empty($o['bank']) && !empty($o['product']) && is_array($o['payments'] ?? null) && offer_total_amount($o) > 0
        && is_array($o['requirements'] ?? null);
}

$today = date('Y-m-d');
$listPrompt = "Today's date is {$today}. Below is text from MoneySavingExpert's bank switch-offers page. List every switch bonus for opening a NEW account (both the main list and the high-earner/premier list), and the banking groups it names.\n\nPAGE TEXT:\n{$switchText}\n\nReturn ONLY JSON: {\"offers\": [{\"bank\": \"short bank name\", \"product\": \"the account's own name\", \"tier\": \"standard or high-earner\"}], \"bankGroups\": [[\"names of banks that share one banking group, e.g. 'HSBC', 'First Direct'\"]]} — bankGroups comes from the sentence about banks sharing the same group (and FSCS protection)); use [] if there is none.";
$list = call_anthropic($ANTHROPIC_API_KEY, $ANTHROPIC_MODEL, $listPrompt, 4000);
if (!$list['ok']) fail(502, 'AI offer list failed: ' . $list['error']);
$names = array_values(array_filter($list['data']['offers'] ?? [], fn($o) => !empty($o['product'])));
if (!$names) fail(502, 'AI found no offers on the MSE page');
$bankGroups = array_values(array_filter(array_map(fn($g) => array_values(array_filter(array_map('strval', (array) $g))), (array) ($list['data']['bankGroups'] ?? [])), fn($g) => count($g) >= 2));

$prevCache = [];
if (is_file($CACHE_FILE)) {
    $rawPrev = file_get_contents($CACHE_FILE);
    $decodedPrev = $rawPrev !== false && $rawPrev !== '' ? json_decode($rawPrev, true) : null;
    if (is_array($decodedPrev)) $prevCache = $decodedPrev;
}

$jobs = [];
foreach (array_chunk($names, 4) as $i => $batch) {
    $wanted = implode('; ', array_map(fn($o) => ($o['bank'] ?? '') . ' — ' . $o['product'], $batch));
    $jobs["offers{$i}"] = ['maxTokens' => 12000, 'prompt' => "Today's date is {$today}. Below is text from MoneySavingExpert's bank switch-offers page. Extract the full structure for ONLY these offers: {$wanted}.\n\n{$OFFER_SCHEMA}\n\nPAGE TEXT:\n{$switchText}\n\nReturn ONLY a JSON object {\"offers\": [ ... one object per requested offer, in the shape above ... ]}, no other text, no markdown fences."];
}
if ($ongoingText !== '') {
    $jobs['ongoing'] = ['maxTokens' => 6000, 'prompt' => "Today's date is {$today}. Below is text from MoneySavingExpert's 'top accounts for ongoing cashback & perks' section — accounts worth opening or keeping for what they keep paying, NOT for a switch bonus.\n\nPAGE TEXT:\n{$ongoingText}\n\nReturn ONLY JSON: {\"accounts\": [{\"bank\": \"short bank name\", \"product\": \"the account's own name\", \"kind\": \"'bills-cashback' (pays cashback on bills paid by Direct Debit), 'spend-cashback', 'interest', 'perks' or 'other' — the main reason to hold it\", \"minPayIn\": number or null (GBP a month), \"monthlyFee\": number or null, \"directDebitsNeeded\": number or null, \"annualValue\": number or null (what it can pay in a year NET of its own fee, only when the page states it or it is a clear sum of stated figures), \"annualValueNote\": \"how that figure is made up, or ''\", \"summary\": \"one sentence: what it pays and what you must do\"}]}. Only accounts the page actually describes; no invented figures."];
}
$ai = call_anthropic_multi($ANTHROPIC_API_KEY, $ANTHROPIC_MODEL, $jobs);

$offers = [];
foreach ($ai as $key => $res) {
    if (strpos($key, 'offers') !== 0) continue;
    if (!$res['ok']) { $scanWarnings[] = "{$key}: " . $res['error']; continue; }
    foreach (($res['data']['offers'] ?? []) as $o) {
        if (!is_array($o) || !scan_offer_ok($o)) continue;
        $o['schema'] = 2;
        $o['id'] = slugify_id((string) ($o['id'] ?? '')) ?: slugify_id((string) $o['product']);
        $o['url'] = $MSE_SWITCH_URL;
        $o['amount'] = offer_total_amount($o);
        $offers[$o['id']] = $o;
    }
}
// Any offer named on the page but not structured by the batches: try each once more
// on its own (small calls, in parallel).
$missing = [];
foreach ($names as $n) {
    $have = false;
    foreach ($offers as $o) if (strcasecmp($o['product'], (string) $n['product']) === 0) $have = true;
    if (!$have) $missing[] = $n;
}
if ($missing) {
    $retryJobs = [];
    foreach ($missing as $i => $n) {
        $retryJobs["retry{$i}"] = ['maxTokens' => 8000, 'prompt' => "Today's date is {$today}. Below is text from MoneySavingExpert's bank switch-offers page. Extract the full structure for ONLY this one offer: " . ($n['bank'] ?? '') . ' — ' . $n['product'] . ".\n\n{$OFFER_SCHEMA}\n\nPAGE TEXT:\n{$switchText}\n\nReturn ONLY a JSON object {\"offers\": [ one object in the shape above ]}, no other text, no markdown fences."];
    }
    foreach (call_anthropic_multi($ANTHROPIC_API_KEY, $ANTHROPIC_MODEL, $retryJobs) as $key => $res) {
        if (!$res['ok']) { $scanWarnings[] = "{$key}: " . $res['error']; continue; }
        foreach (($res['data']['offers'] ?? []) as $o) {
            if (!is_array($o) || !scan_offer_ok($o)) continue;
            $o['schema'] = 2;
            $o['id'] = slugify_id((string) ($o['id'] ?? '')) ?: slugify_id((string) $o['product']);
            $o['url'] = $MSE_SWITCH_URL;
            $o['amount'] = offer_total_amount($o);
            $offers[$o['id']] = $o;
        }
    }
}
// An offer the AI named but did not manage to structure this week: keep last week's.
foreach ($names as $n) {
    $id = slugify_id((string) $n['product']);
    $have = false;
    foreach ($offers as $o) if (strcasecmp($o['product'], (string) $n['product']) === 0) $have = true;
    if ($have) continue;
    foreach (($prevCache['offers'] ?? []) as $po) {
        if (strcasecmp((string) ($po['product'] ?? ''), (string) $n['product']) === 0) {
            $po['stale'] = true;
            $offers[$po['id'] ?? $id] = $po;
            $scanWarnings[] = $n['product'] . ': could not be read this week, kept last week\'s';
            break;
        }
    }
}
$offers = array_values($offers);
// A deadline already in the past is a year-less date read in the wrong year: roll it forward.
foreach ($offers as &$o) {
    foreach (['startBy', 'completeBy'] as $k) {
        $d = $o['switch'][$k] ?? null;
        if (!$d || !preg_match('/^\d{4}-\d{2}-\d{2}$/', (string) $d)) { if (isset($o['switch'])) $o['switch'][$k] = null; continue; }
        while ($o['switch'][$k] < date('Y-m-d', strtotime('-10 days'))) $o['switch'][$k] = date('Y-m-d', strtotime($o['switch'][$k] . ' +1 year'));
    }
}
unset($o);
if (!$offers) fail(502, 'AI extraction produced no usable offers: ' . implode(' | ', $scanWarnings ?? []));

$ongoingAccounts = [];
if (isset($ai['ongoing']) && $ai['ongoing']['ok']) {
    foreach (($ai['ongoing']['data']['accounts'] ?? []) as $a) {
        if (!is_array($a) || empty($a['product'])) continue;
        $ongoingAccounts[] = [
            'bank' => (string) ($a['bank'] ?? ''), 'product' => (string) $a['product'], 'kind' => (string) ($a['kind'] ?? 'other'),
            'minPayIn' => is_numeric($a['minPayIn'] ?? null) ? (float) $a['minPayIn'] : null, 'monthlyFee' => is_numeric($a['monthlyFee'] ?? null) ? (float) $a['monthlyFee'] : null,
            'directDebitsNeeded' => is_numeric($a['directDebitsNeeded'] ?? null) ? (int) $a['directDebitsNeeded'] : null,
            'annualValue' => is_numeric($a['annualValue'] ?? null) ? (float) $a['annualValue'] : null,
            'annualValueNote' => (string) ($a['annualValueNote'] ?? ''), 'summary' => (string) ($a['summary'] ?? ''),
        ];
    }
}

$krakTiers = null;
$krakSalaryMin = null;
$krakSalaryCap = null;
$krakHtml = rendered_html($pages['kraken'] ?? null);
if ($krakHtml !== '') {
    $krakText = strip_html_to_text($krakHtml);
    // Krak's reward is a percentage of each SALARY PAYMENT -- the average
    // balance only picks which percentage. An earlier version of this
    // prompt asked for an "annual percent", which baked the wrong model
    // into the data. Ask for exactly what the page defines.
    $krakPrompt = "Below is text from Krak's (Kraken's UK app) Salary Match help page. Krak pays cashback as a percentage of each SALARY PAYMENT you receive; your average balance only decides which percentage tier you are in. Extract the tier table and the qualifying rules.\n\nPAGE TEXT:\n" . substr($krakText, 0, 12000) . "\n\nReturn ONLY JSON, no other text: {\"tiers\": [{\"name\": \"tier name\", \"minBalance\": numeric GBP average-balance threshold for this tier, \"percent\": numeric percentage of each salary payment paid as cashback}], \"salaryMin\": numeric minimum monthly salary in GBP needed to qualify or null, \"salaryCap\": numeric monthly salary in GBP above which nothing extra is counted or null}. Use the page's main tier table; if an example elsewhere on the page disagrees with it, trust the table.";
    $krakAi = call_anthropic($ANTHROPIC_API_KEY, $ANTHROPIC_MODEL, $krakPrompt, 8000);
    if ($krakAi['ok'] && is_array($krakAi['data']['tiers'] ?? null)) {
        // Only well-formed tiers, and at least two of them -- a malformed
        // answer must leave the existing (good) tier data in the cache
        // alone rather than replace it with garbage.
        $good = array_values(array_filter($krakAi['data']['tiers'], fn($t) => is_array($t) && isset($t['minBalance'], $t['percent']) && is_numeric($t['minBalance']) && is_numeric($t['percent'])));
        if (count($good) >= 2) {
            $krakTiers = $good;
            $krakSalaryMin = isset($krakAi['data']['salaryMin']) && is_numeric($krakAi['data']['salaryMin']) ? (float) $krakAi['data']['salaryMin'] : null;
            $krakSalaryCap = isset($krakAi['data']['salaryCap']) && is_numeric($krakAi['data']['salaryCap']) ? (float) $krakAi['data']['salaryCap'] : null;
        }
    }
}

// ---- Write the cache: flock + atomic tmp-then-rename, same shape as
// the dashboard's own sync.php. ------------------------------------------

$lock = fopen($CACHE_FILE . '.lock', 'c');
if ($lock === false) fail(500, 'Could not open lock file — check directory permissions');
flock($lock, LOCK_EX);

$current = ['scrapedAt' => null, 'history' => [], 'offers' => [], 'cassParticipants' => [], 'cashbackRates' => [], 'krakTiers' => [], 'krakSalaryMin' => null, 'krakSalaryCap' => null, 'krakTiersAsOf' => null, 'krakTiersSource' => null, 'cashbackDeals' => [], 'cashbackAsOf' => null, 'cashbackSources' => [], 'annualPerks' => [], 'bankGroups' => [], 'ongoingAccounts' => []];
if (is_file($CACHE_FILE)) {
    $raw = file_get_contents($CACHE_FILE);
    $parsed = $raw !== false && $raw !== '' ? json_decode($raw, true) : null;
    if (is_array($parsed)) $current = array_merge($current, $parsed);
}

// Yearly payments a scan can't discover, kept by hand. Used to start the list off
// when the cache has none; once the cache holds the list, edits to it win.
$DEFAULT_ANNUAL_PERKS = [[
    'id' => 'nationwide-fairer-share', 'name' => 'Nationwide Fairer Share', 'bank' => 'Nationwide', 'amount' => 100, 'guaranteed' => false,
    'windowStartMonth' => 1, 'windowEndMonth' => 3, 'payMonth' => 6, 'savingsMin' => 100,
    'note' => 'A yearly payment to Nationwide members with a current account that was open on 31 March and used in January-March, plus £100+ in a Nationwide savings account (or on a mortgage) in March. Paid for three years running (2026: about 4.4 million members, from 10 June). Nationwide decides each year with its May results. Virgin Money customers missed the 2026 round. Taxable as savings interest.',
    'lastPaid' => '2026-06', 'url' => 'https://www.moneysavingexpert.com/news/2026/01/nationwide-fairer-share-how-to/', 'readOn' => '2026-10-26',
]];

$now = gmdate('Y-m-d');
$history = $current['history'] ?? [];
// Keyed by (bank, product) when recommendations later compare "is this
// lower than before" -- switchadvisor.php's own history_max_for_offer()
// needs product here too, or two products from the same bank (e.g.
// Barclays Bank Account vs. Barclays Premier) get conflated into one
// bogus "price history".
$history[] = ['at' => $now, 'offers' => array_map(fn($o) => ['bank' => $o['bank'], 'product' => $o['product'] ?? $o['bank'], 'amount' => $o['amount']], $offers)];
if (count($history) > $HISTORY_CAP) $history = array_slice($history, -$HISTORY_CAP);

$next = [
    'scrapedAt' => $now,
    'history' => $history,
    'offers' => $offers,
    'cassParticipants' => $cassParticipants ?: ($current['cassParticipants'] ?? []),
    'cashbackRates' => $current['cashbackRates'] ?? [],
    // From the page's own "these banks share the same group" sentence; kept as it was when this scan found none.
    'bankGroups' => $bankGroups ?: ($current['bankGroups'] ?? []),
    'ongoingAccounts' => $ongoingAccounts ?: ($current['ongoingAccounts'] ?? []),
    // Hand-kept yearly payments (e.g. Nationwide Fairer Share): never produced by a scan, so carried over as they are.
    'annualPerks' => !empty($current['annualPerks']) ? $current['annualPerks'] : $DEFAULT_ANNUAL_PERKS,
    // Krak's card cashback by balance tier (support.krak.app, read 2026-10-29); hand-kept like annualPerks.
    'krakCardTiers' => !empty($current['krakCardTiers']) ? $current['krakCardTiers'] : [['name' => 'Starter', 'minBalance' => 0, 'percent' => 0], ['name' => 'Light', 'minBalance' => 200, 'percent' => 0.5], ['name' => 'Pro', 'minBalance' => 1000, 'percent' => 1], ['name' => 'Elite', 'minBalance' => 10000, 'percent' => 1.5], ['name' => 'Max', 'minBalance' => 50000, 'percent' => 2]],
    // Kept as-is when this scan found none (a site changed its markup, or
    // its page didn't come back) rather than blanked.
    'cashbackDeals' => $cashbackDeals ?: ($current['cashbackDeals'] ?? []),
    'cashbackAsOf' => $cashbackDeals ? $now : ($current['cashbackAsOf'] ?? null),
    'cashbackSources' => ['topcashback' => $TOPCASHBACK_SEARCH_URL, 'quidco' => $QUIDCO_SEARCH_URL],
    'krakTiers' => $krakTiers ?? ($current['krakTiers'] ?? []),
    'krakSalaryMin' => $krakTiers ? ($krakSalaryMin ?? ($current['krakSalaryMin'] ?? null)) : ($current['krakSalaryMin'] ?? null),
    'krakSalaryCap' => $krakTiers ? ($krakSalaryCap ?? ($current['krakSalaryCap'] ?? null)) : ($current['krakSalaryCap'] ?? null),
    'krakTiersAsOf' => $krakTiers ? $now : ($current['krakTiersAsOf'] ?? null),
    'krakTiersSource' => $krakTiers ? 'scraped ' . $now : ($current['krakTiersSource'] ?? null),
];

$tmp = $CACHE_FILE . '.tmp';
if (file_put_contents($tmp, json_encode($next)) === false) {
    flock($lock, LOCK_UN);
    fclose($lock);
    fail(500, 'Could not write cache file — check directory permissions');
}
rename($tmp, $CACHE_FILE);
flock($lock, LOCK_UN);
fclose($lock);

echo json_encode(['ok' => true, 'offersFound' => count($offers), 'cassParticipantsFound' => count($cassParticipants), 'krakTiersScraped' => (bool) $krakTiers, 'cashbackDealsFound' => count($cashbackDeals), 'ongoingAccountsFound' => count($ongoingAccounts), 'bankGroups' => count($bankGroups), 'warnings' => $scanWarnings, 'scrapedAt' => $now]);
