<?php
declare(strict_types=1);

/**
 * Bank-switch advisor — invite-only, multi-user backend.
 *
 * A completely separate app from the personal dashboard: its own data
 * file, its own secret, its own auth. Nothing here can read or write
 * dashboard-data.json, and nothing in the dashboard can read this file's
 * data either.
 *
 * Auth has no password. An invite link (?invite=<32-hex-token>) IS the
 * credential — the server only ever stores its SHA-256 hash, same as
 * pair.php's device tokens. Redeeming it the first time creates a user
 * and links the invite to them; redeeming it again (a cleared cookie, a
 * new browser) just logs the same person back in. The browser then
 * sends that same token on every call as `X-Invite-Token`.
 *
 *   POST ?action=redeem          {token}                      (public — this IS how you get in)
 *   GET  ?action=me                                            (X-Invite-Token)
 *   POST ?action=update-profile  {annualSalaryNet, annualSalaryGross, assumedBalance, email}  (X-Invite-Token)
 *   POST ?action=account-upsert  {account}                     (X-Invite-Token)
 *   POST ?action=account-delete  {id}                          (X-Invite-Token)
 *   GET  ?action=banklist                                      (public)
 *   GET  ?action=referrals                                     (public)
 *   POST ?action=invite-create   {label}                       (X-Admin-Secret)
 *   GET  ?action=invite-list                                   (X-Admin-Secret)
 *
 * Upload to your Krystal hosting (cPanel -> File Manager), same host as
 * the dashboard's own sync.php but a separate file, separate data store.
 * See server-switchadvisor/README.md.
 */

// ---- Configuration ---------------------------------------------------

// Only you know this — it authorises minting invites and viewing who
// redeemed them. Generate with the same PowerShell one-liner the
// dashboard's own README gives for sync.php's $SECRET.
$ADMIN_SECRET = 'PUT-A-LONG-RANDOM-STRING-HERE';

// Where the two documents live. Defaults to one directory ABOVE this
// script — on cPanel that's outside public_html, so neither file is
// web-reachable even if .htaccess is ever lost.
$DATA_FILE = dirname(__DIR__) . '/switchadvisor-data.json';
$CACHE_FILE = dirname(__DIR__) . '/switchadvisor-cache.json';

// A browser will only let the frontend call this endpoint from an
// origin listed here.
$ALLOWED_ORIGINS = [
    'https://philgewhite-maker.github.io',
    'http://localhost:8743',
];

// ---- End of configuration --------------------------------------------

$origin = $_SERVER['HTTP_ORIGIN'] ?? '';
if ($origin !== '' && in_array($origin, $ALLOWED_ORIGINS, true)) {
    header('Access-Control-Allow-Origin: ' . $origin);
    header('Vary: Origin');
}
header('Access-Control-Allow-Headers: Content-Type, X-Invite-Token, X-Admin-Secret');
header('Access-Control-Allow-Methods: GET, POST, OPTIONS');
header('Access-Control-Max-Age: 86400');
header('Content-Type: application/json');
header('Cache-Control: no-store');

if (($_SERVER['REQUEST_METHOD'] ?? '') === 'OPTIONS') {
    http_response_code(204);
    exit;
}

function fail(int $code, string $message): void {
    http_response_code($code);
    echo json_encode(['error' => $message]);
    exit;
}

// ---- Storage: same flock + atomic-tmp-then-rename shape as the
// dashboard's own sync.php, just with no client-supplied `rev` check —
// each call only ever touches one user's own slice of the document, so
// the lock alone (serialising concurrent requests) is enough to stop a
// lost update; there is no "whole document went stale" case to detect.

function locked_read_modify_write(string $file, array $empty, callable $modify) {
    $lock = fopen($file . '.lock', 'c');
    if ($lock === false) fail(500, 'Could not open lock file — check directory permissions');
    flock($lock, LOCK_EX);
    $current = $empty;
    if (is_file($file)) {
        $raw = file_get_contents($file);
        $parsed = $raw !== false && $raw !== '' ? json_decode($raw, true) : null;
        if (is_array($parsed)) $current = $parsed;
    }
    $result = $modify($current);
    $next = $result['doc'];
    $tmp = $file . '.tmp';
    if (file_put_contents($tmp, json_encode($next)) === false) {
        flock($lock, LOCK_UN);
        fclose($lock);
        fail(500, 'Could not write data file — check directory permissions');
    }
    rename($tmp, $file);
    flock($lock, LOCK_UN);
    fclose($lock);
    return $result['return'] ?? null;
}

function read_doc(string $file, array $empty): array {
    if (!is_file($file)) return $empty;
    $raw = file_get_contents($file);
    if ($raw === false || $raw === '') return $empty;
    $parsed = json_decode($raw, true);
    return is_array($parsed) ? $parsed : $empty;
}

$EMPTY_DATA = ['rev' => 0, 'invites' => [], 'users' => []];
$EMPTY_CACHE = ['scrapedAt' => null, 'history' => [], 'offers' => [], 'cassParticipants' => [], 'cashbackRates' => [], 'krakTiers' => [], 'krakSalaryMin' => null, 'krakSalaryCap' => null, 'krakTiersAsOf' => null, 'krakTiersSource' => null, 'cashbackDeals' => [], 'cashbackAsOf' => null, 'cashbackSources' => []];

// ---- Shared helpers ----------------------------------------------------

// Strips "Bank of", "Building Society", "plc", "Ltd", bracketed codicils
// — same cleanup js/features/switchoffers.js's normalizeBankName applies
// to the identical CASS participant list, so a name matches whether it
// came from that scrape or was typed into the account form.
function normalize_bank_name(string $name): string {
    $s = mb_strtolower($name);
    $s = preg_replace('/\([^)]*\)/', ' ', $s) ?? $s;
    $s = preg_replace('/\b(bank of|building society|bank|plc|ltd|limited|co\.?|&|group|holdings)\b/', ' ', $s) ?? $s;
    $s = preg_replace('/[^a-z0-9]+/', ' ', $s) ?? $s;
    return trim(preg_replace('/\s+/', ' ', $s) ?? $s);
}

function bank_names_match(string $a, string $b): bool {
    $na = normalize_bank_name($a);
    $nb = normalize_bank_name($b);
    if ($na === '' || $nb === '') return false;
    return $na === $nb || strpos($na, $nb) !== false || strpos($nb, $na) !== false;
}

function is_cass_participant(string $bank, array $participants): string {
    $target = normalize_bank_name($bank);
    if ($target === '') return 'unsure';
    foreach ($participants as $p) {
        if (bank_names_match($bank, (string) $p)) return 'yes';
    }
    return 'no';
}

function sanitize_user(array $u): array {
    return [
        'id' => $u['id'],
        'email' => $u['email'] ?? '',
        'createdAt' => $u['createdAt'] ?? null,
        'lastSeenAt' => $u['lastSeenAt'] ?? null,
        'annualSalaryNet' => $u['annualSalaryNet'] ?? null,
        'annualSalaryGross' => $u['annualSalaryGross'] ?? null,
        'assumedBalance' => $u['assumedBalance'] ?? null,
        'accounts' => $u['accounts'] ?? [],
    ];
}

// ---- Recommendation engine: plain rule evaluation over the shared
// cache, no AI call per request (see server-switchadvisor/README.md,
// "why deterministic matching"). ----------------------------------------

// $bonusSinceCutoff distinguishes two real, different exclusion shapes
// seen in the actual offer text: "no PREVIOUS switch bonus" (Barclays,
// First Direct, NatWest -- unconditional, any past Paid bonus excludes
// forever, cutoff null) vs. "no switch bonus SINCE <date>" (Lloyds
// "since 1 Jan 2023", Nationwide "since 2021" -- only a bonus paid ON OR
// AFTER that date excludes; an older one doesn't). Confirmed live as a
// real gap otherwise: treating every Paid bonus as a permanent
// disqualification would wrongly exclude someone forever from a current
// Lloyds offer over a bonus they got in, say, 2019. An undated Paid
// entry can't be proven old enough to ignore, so it's treated as
// blocking -- the safe default when the user hasn't recorded a date.
function account_switch_bonus_blocks(array $accounts, string $bank, ?string $bonusSinceCutoff): bool {
    foreach ($accounts as $a) {
        if (!bank_names_match((string) ($a['bank'] ?? ''), $bank)) continue;
        foreach (($a['switchBonuses'] ?? []) as $sb) {
            if (($sb['status'] ?? '') !== 'Paid') continue;
            if ($bonusSinceCutoff === null) return true;
            $date = (string) ($sb['date'] ?? '');
            if ($date === '' || $date >= $bonusSinceCutoff) return true;
        }
    }
    return false;
}

// Held accounts at this bank, most-recently-closed first. A still-open
// one has closeDate === ''.
function accounts_at_bank(array $accounts, string $bank): array {
    $out = [];
    foreach ($accounts as $a) {
        if (bank_names_match((string) ($a['bank'] ?? ''), $bank)) $out[] = $a;
    }
    usort($out, fn($x, $y) => strcmp((string) ($y['closeDate'] ?? '9999'), (string) ($x['closeDate'] ?? '9999')));
    return $out;
}

function offer_eligibility(array $offer, array $accounts): array {
    $bank = (string) ($offer['bank'] ?? '');
    $held = accounts_at_bank($accounts, $bank);
    $bonusCutoff = $offer['bonusSinceCutoff'] ?? null;
    if (account_switch_bonus_blocks($accounts, $bank, $bonusCutoff)) {
        $reason = $bonusCutoff
            ? "A {$bank} switch bonus is on file as Paid, on or after this offer's own " . substr($bonusCutoff, 0, 10) . ' exclusion cutoff (or with no date recorded against it).'
            : "A {$bank} switch bonus is already on file as Paid.";
        // The dates of the bonuses that block it, so the page can say when a
        // LATER version of this dated offer would let you back in.
        $bonusDates = [];
        if ($bonusCutoff) {
            foreach ($accounts as $a) {
                if (!bank_names_match((string) ($a['bank'] ?? ''), $bank)) continue;
                foreach (($a['switchBonuses'] ?? []) as $sb) {
                    if (($sb['status'] ?? '') === 'Paid' && !empty($sb['date'])) $bonusDates[] = (string) $sb['date'];
                }
            }
        }
        return ['eligible' => false, 'kind' => $bonusCutoff ? 'bonus-since' : 'bonus-ever', 'bonusDates' => $bonusDates, 'reason' => $reason];
    }
    if (!$held) {
        return ['eligible' => true, 'reason' => "You've never held an account with {$bank}."];
    }
    $cutoff = $offer['heldSinceCutoff'] ?? null;
    // The still-open accounts at this bank, handed back with the reason so
    // the recommendations can say whether CLOSING one would change anything
    // -- it depends on the kind of rule: with a dated "held since" cutoff,
    // closing today doesn't undo having held one since then; with a plain
    // "can't hold an open account" rule, closing it does.
    $openIds = array_values(array_map(fn($a) => $a['id'] ?? '', array_filter($held, fn($a) => empty($a['closeDate']))));
    foreach ($held as $a) {
        $closeDate = (string) ($a['closeDate'] ?? '');
        $stillOpen = $closeDate === '';
        if ($cutoff) {
            // "Not held an account since <cutoff>" — disqualified if still
            // open, or closed on/after the cutoff date.
            if ($stillOpen || $closeDate >= $cutoff) {
                return ['eligible' => false, 'kind' => 'cutoff', 'openIds' => $openIds, 'reason' => "Excluded: {$bank}'s own terms require no account held since " . substr($cutoff, 0, 10) . ", and you hold one " . ($stillOpen ? 'that is still open' : "closed {$closeDate}") . '.'];
            }
        } else if ($stillOpen) {
            // No dated cutoff captured from the offer's own wording — the
            // safe default is "can't hold one already", same as almost
            // every switch offer's baseline condition.
            return ['eligible' => false, 'kind' => 'open', 'openIds' => $openIds, 'reason' => "You already hold an open {$bank} account — most switch offers exclude existing customers."];
        }
    }
    return ['eligible' => true, 'reason' => "Your {$bank} account(s) closed before this offer's own exclusion window."];
}

// CASS-ready is derived, not a field anyone fills in: open, and not
// explicitly marked "keep" (undecided counts as fair game -- this only
// ever SUGGESTS a donor, never switches anything, so defaulting open
// costs nothing and a separate checkbox was one more thing to explain
// for no real benefit).
function is_cass_ready(array $a): bool {
    return empty($a['closeDate']) && ($a['wantToKeep'] ?? null) !== true;
}

// Banks that share a banking group, as MoneySavingExpert lists them on the
// switch-offers page ("Santander and Cahoot | HSBC and First Direct |
// NatWest and Ulster Bank | Nationwide and Virgin Money") plus the Lloyds
// and NatWest groups the offers' own terms name (Halifax / Bank of Scotland;
// Royal Bank of Scotland). Keys are normalize_bank_name() output. Two rules
// rest on it: a switch has to come from a DIFFERENT group than the one you're
// switching into (MSE: "You must switch from a different banking group"), and
// two offers from the same group are alternatives -- the second excludes you
// once you've taken the first. Anything not listed is its own group.
const BANK_GROUPS = [
    'hsbc' => 'hsbc', 'first direct' => 'hsbc',
    'lloyds' => 'lloyds', 'halifax' => 'lloyds', 'scotland' => 'lloyds',
    'natwest' => 'natwest', 'royal scotland' => 'natwest', 'ulster' => 'natwest',
    'nationwide' => 'nationwide', 'virgin money' => 'nationwide',
    'santander' => 'santander', 'cahoot' => 'santander',
];

function bank_group(string $name): string {
    $k = normalize_bank_name($name);
    if ($k === '') return '';
    if (isset(BANK_GROUPS[$k])) return BANK_GROUPS[$k];
    // Names often arrive longer than the listed form ("HSBC UK", "Lloyds
    // International"): match on a leading listed name, never a trailing one,
    // so "royal scotland" can't be mistaken for "scotland".
    foreach (BANK_GROUPS as $key => $group) {
        if (strpos($k, $key . ' ') === 0) return $group;
    }
    return $k;
}

function direct_debits_on(array $a): ?int {
    return (isset($a['directDebitCount']) && $a['directDebitCount'] !== '') ? (int) $a['directDebitCount'] : null;
}

// $needDD is how many Direct Debits the offer wants switched in. Among the
// accounts that could be the donor, prefer one that can actually supply
// them -- otherwise "first account in the list" could be picked with 1
// Direct Debit while another has 4, and a shortfall would be reported that
// doesn't exist. Order: confirmed CASS participant first (as before), then
// meets the requirement, then unknown count, then too few; ties go to the
// account with more.
function offer_donor(array $accounts, array $cassParticipants, ?string $excludeBank, ?int $needDD = null): ?array {
    $candidates = [];
    foreach ($accounts as $a) {
        if (!is_cass_ready($a)) continue;
        // Can't switch from the same bank -- or the same banking group.
        if ($excludeBank && (bank_names_match((string) ($a['bank'] ?? ''), $excludeBank) || bank_group((string) ($a['bank'] ?? '')) === bank_group($excludeBank))) continue;
        $status = is_cass_participant((string) ($a['bank'] ?? ''), $cassParticipants);
        if ($status === 'no') continue; // a dead end — can't CASS away from it at all
        $dd = direct_debits_on($a);
        $fit = ($needDD === null || ($dd !== null && $dd >= $needDD)) ? 0 : ($dd === null ? 1 : 2);
        $candidates[] = ['a' => $a, 'rank' => [$status === 'yes' ? 0 : 1, $fit, -($dd ?? 0)]];
    }
    if (!$candidates) return null;
    usort($candidates, fn($x, $y) => $x['rank'] <=> $y['rank']);
    $best = $candidates[0]['a'];
    return $best;
}

// Keyed by (bank, product), not bank alone -- a bank with several
// products on offer at once (e.g. Barclays Bank Account AND Barclays
// Premier, different amounts, same scrape) would otherwise have one
// product's price read as "history" for the other's, producing a
// nonsensical "down from £600" on a product that was never £600.
function same_product(string $a, string $b): bool {
    return mb_strtolower(trim($a)) === mb_strtolower(trim($b));
}

function history_max_for_offer(array $history, string $bank, string $product): ?float {
    $max = null;
    foreach ($history as $snap) {
        foreach (($snap['offers'] ?? []) as $o) {
            if (!bank_names_match((string) ($o['bank'] ?? ''), $bank)) continue;
            if (!same_product((string) ($o['product'] ?? $o['bank'] ?? ''), $product)) continue;
            $amt = (float) ($o['amount'] ?? 0);
            if ($max === null || $amt > $max) $max = $amt;
        }
    }
    return $max;
}

// Net vs gross: the two kinds of figure these offers mention are NOT
// interchangeable, and the profile asks for them separately.
//   minMonthlySalary  - salary that must be PAID IN each month as a condition
//                       of the bonus ("monthly salary payments of £2,000+").
//                       Real money arriving in the account, so it is compared
//                       with your NET (take-home) salary / 12.
//   minAnnualEarnings - an "earn £X a year" threshold. That is BEFORE tax, so
//                       it is compared with your GROSS salary when you've
//                       given it. With only net to go on it can't be settled
//                       either way (£75k gross is roughly £52k take-home,
//                       less with a pension or student loan): net under half
//                       the threshold is far below anything tax explains and
//                       counts as a clear miss; anything between is left for
//                       you to settle by entering your gross salary.
// This engine used to ignore salary requirements entirely (a £10k salary was
// still recommended Barclays Premier).
// incomeAltRoute names a non-salary way in the offer also allows (e.g. £100k
// saved), which this page has no way to check, so it is mentioned rather than
// assumed either way. Returns ['fail' => reason|null, 'todo' => note|null]: a
// clear shortfall makes the offer not eligible, an unknown or borderline one
// becomes a highlighted to-do.
const EARNINGS_FLOOR_RATIO = 0.5;

function offer_income_check(array $offer, array $user): array {
    $none = ['fail' => null, 'todo' => null];
    $minMonthly = !empty($offer['minMonthlySalary']) ? (float) $offer['minMonthlySalary'] : null;
    $minAnnual = !empty($offer['minAnnualEarnings']) ? (float) $offer['minAnnualEarnings'] : null;
    if (!$minMonthly && !$minAnnual) return $none;
    $alt = !empty($offer['incomeAltRoute']) ? sprintf(" (the offer also allows %s, which this page can't check)", $offer['incomeAltRoute']) : '';
    $net = (!empty($user['annualSalaryNet']) && (float) $user['annualSalaryNet'] > 0) ? (float) $user['annualSalaryNet'] : null;
    $gross = (!empty($user['annualSalaryGross']) && (float) $user['annualSalaryGross'] > 0) ? (float) $user['annualSalaryGross'] : null;

    if ($minMonthly) {
        if ($net === null) {
            return ['fail' => null, 'todo' => sprintf('Needs £%s a month of salary paid in — enter your net (take-home) annual salary in the profile section above so this can be checked.', number_format($minMonthly, 0))];
        }
        $monthly = $net / 12;
        if ($monthly < $minMonthly) {
            return ['fail' => sprintf('Needs £%s a month of salary paid in; your take-home is about £%s a month.%s', number_format($minMonthly, 0), number_format($monthly, 0), $alt), 'todo' => null];
        }
        return $none; // the pay-in is the binding test; any "earnings" figure is just MSE's guide to it
    }

    if ($gross !== null) {
        if ($gross < $minAnnual) {
            return ['fail' => sprintf('Needs earnings of £%s+ a year before tax; you have given £%s.%s', number_format($minAnnual, 0), number_format($gross, 0), $alt), 'todo' => null];
        }
        return $none;
    }
    if ($net === null) {
        return ['fail' => null, 'todo' => sprintf('Needs earnings of £%s+ a year before tax — enter your gross (before-tax) salary in the profile section above so this can be checked.', number_format($minAnnual, 0))];
    }
    if ($net < $minAnnual * EARNINGS_FLOOR_RATIO) {
        return ['fail' => sprintf('Needs earnings of £%s+ a year before tax; your take-home of £%s a year is far below that.%s', number_format($minAnnual, 0), number_format($net, 0), $alt), 'todo' => null];
    }
    if ($net < $minAnnual) {
        return ['fail' => null, 'todo' => sprintf("Needs earnings of £%s+ a year before tax. You've only given your take-home (£%s a year), which can't settle that either way — enter your gross (before-tax) salary in the profile section above.", number_format($minAnnual, 0), number_format($net, 0))];
    }
    return $none; // even take-home is at or above the pre-tax figure
}

function priority_band(float $amount): string {
    if ($amount >= 200) return 'high';
    if ($amount >= 100) return 'medium';
    return 'low';
}

// Flat-sum cashback for opening a current account at this bank through
// TopCashback or Quidco, from the weekly scan (only "current account"
// deals are ever stored, so another product from the same bank can't leak
// in). A bank can list several products (Santander Edge, Edge Student...);
// the best one per site is kept and named. Both sites can't be used for one
// application, so these are alternatives, highest first -- and Quidco's
// figure is its premium-member rate, which the page says so.
function cashback_for_bank(string $bank, array $cache): array {
    $sources = $cache['cashbackSources'] ?? [];
    $labels = ['topcashback' => 'TopCashback', 'quidco' => 'Quidco'];
    $best = [];
    foreach (($cache['cashbackDeals'] ?? []) as $d) {
        $provider = (string) ($d['provider'] ?? '');
        if (!isset($labels[$provider]) || !bank_names_match((string) ($d['name'] ?? ''), $bank)) continue;
        $amount = (float) ($d['amount'] ?? 0);
        if ($amount <= 0) continue;
        if (!isset($best[$provider]) || $amount > $best[$provider]['amount']) {
            $best[$provider] = [
                'provider' => $provider, 'label' => $labels[$provider], 'amount' => $amount,
                'name' => (string) ($d['name'] ?? ''), 'url' => (string) ($sources[$provider] ?? ''),
                'asOf' => $cache['cashbackAsOf'] ?? null,
            ];
        }
    }
    $out = array_values($best);
    usort($out, fn($a, $b) => $b['amount'] <=> $a['amount']);
    return $out;
}

function compute_recommendations(array $user, array $cache): array {
    $accounts = $user['accounts'] ?? [];
    $participants = $cache['cassParticipants'] ?? [];
    $history = $cache['history'] ?? [];

    // Pass 1: everything about an offer that doesn't depend on WHICH of your
    // accounts would fund it.
    $work = [];
    foreach (($cache['offers'] ?? []) as $offer) {
        $bank = (string) ($offer['bank'] ?? '');
        $product = (string) ($offer['product'] ?? $bank);
        $amount = (float) ($offer['amount'] ?? 0);
        // Almost every bank "switch bonus" is, by definition, conditional
        // on an actual CASS switch -- MSE's own page title is "Top
        // bonuses for SWITCHING bank". Defaulting true (rather than
        // assuming "you can just open it") matters: confirmed live as a
        // real false claim otherwise -- NatWest Premier Reward's own
        // terms require "£15,000 paid in within 90 days of the SWITCH
        // completing", yet the old fallback text said "you can still
        // open this as a fresh account" when no donor was on file. Only
        // an offer whose own conditions state a genuine no-switch
        // alternative (e.g. HSBC Premier's "£100k+ saved, no switch
        // needed" path) should set this false.
        $requiresSwitch = array_key_exists('requiresSwitch', $offer) ? (bool) $offer['requiresSwitch'] : true;
        $elig = offer_eligibility($offer, $accounts);
        // Account history can already rule an offer out; only if it hasn't
        // does the salary check get a say (and its reason replaces nothing).
        $income = ['fail' => null, 'todo' => null];
        if ($elig['eligible']) {
            $income = offer_income_check($offer, $user);
            if ($income['fail']) $elig = ['eligible' => false, 'reason' => $income['fail']];
        }
        $histMax = history_max_for_offer($history, $bank, $product);
        $band = priority_band($amount);
        $rationale = $elig['reason'];
        if ($elig['eligible'] && $histMax !== null && $amount < $histMax) {
            $band = $band === 'high' ? 'medium' : 'low';
            $lastSeenAt = null;
            foreach (array_reverse($history) as $snap) {
                foreach (($snap['offers'] ?? []) as $o) {
                    if (bank_names_match((string) ($o['bank'] ?? ''), $bank) && same_product((string) ($o['product'] ?? $o['bank'] ?? ''), $product) && (float) ($o['amount'] ?? 0) == $histMax) { $lastSeenAt = $snap['at'] ?? null; break 2; }
                }
            }
            $rationale .= sprintf(' £%s, down from £%s seen%s.', number_format($amount, 0), number_format($histMax, 0), $lastSeenAt ? ' on ' . substr($lastSeenAt, 0, 10) : ' before');
        }
        $work[] = [
            'offer' => $offer, 'bank' => $bank, 'amount' => $amount,
            'requiresSwitch' => $requiresSwitch, 'elig' => $elig,
            'needDD' => !empty($offer['ddCount']) ? (int) $offer['ddCount'] : null,
            'band' => $band, 'rationale' => $rationale,
            'todo' => $income['todo'] ? [$income['todo']] : [],
            'donor' => null, 'donorExisted' => false,
        ];
    }

    // Pass 2: hand out the accounts you could switch away from, best offer
    // first. A full CASS switch moves an account's Direct Debits and closes
    // it, so ONE account can fund ONE switch -- before this, every eligible
    // offer said "switch from your Main account", as if a single account
    // could claim all of them. An offer that doesn't need a switch (the
    // no-switch route) doesn't use one up.
    //
    // One offer per banking group: Barclays Premier and Barclays Bank Account
    // (or HSBC's two, Lloyds', NatWest's, or HSBC + First Direct) are
    // alternatives -- taking one excludes you from the other -- so the
    // better-paying one wins and the rest are marked as alternatives rather
    // than counted as extra money.
    $pool = $accounts;
    $groupTaken = [];
    $order = array_keys($work);
    usort($order, fn($i, $j) => $work[$j]['amount'] <=> $work[$i]['amount']);
    foreach ($order as $i) {
        if (!$work[$i]['elig']['eligible']) continue;
        $group = bank_group($work[$i]['bank']);
        if ($group !== '' && isset($groupTaken[$group])) {
            $work[$i]['alternativeTo'] = $groupTaken[$group];
            continue;
        }
        $donor = offer_donor($pool, $participants, $work[$i]['bank'], $work[$i]['needDD']);
        $work[$i]['donor'] = $donor;
        if ($donor && $work[$i]['requiresSwitch']) {
            $usedId = $donor['id'] ?? '';
            $pool = array_values(array_filter($pool, fn($a) => ($a['id'] ?? '') !== $usedId));
        }
        // This offer now stands for its whole group -- unless it still can't
        // be claimed (a switch is needed and there's nothing to switch from).
        if ($group !== '' && ($donor || !$work[$i]['requiresSwitch'])) {
            $groupTaken[$group] = $work[$i]['offer']['product'] ?? $work[$i]['bank'];
        }
        // No donor left: was that because none ever existed for this offer,
        // or because better offers already used them all? The advice differs.
        if (!$donor) $work[$i]['donorExisted'] = offer_donor($accounts, $participants, $work[$i]['bank'], null) !== null;
    }
    // Which account is already earmarked to be switched away (and so closed)
    // for which offer -- used below, since closing it for THAT reason may
    // also clear what blocks an offer from the same bank.
    $donorUse = [];
    foreach ($work as $w) {
        if ($w['donor'] && $w['requiresSwitch'] && $w['elig']['eligible']) $donorUse[$w['donor']['id'] ?? ''] = $w['offer']['product'] ?? $w['bank'];
    }

    // Pass 3: the rows themselves.
    $rows = [];
    foreach ($work as $w) {
        $donor = $w['donor'];
        $eligible = $w['elig']['eligible'];
        $band = $w['band'];
        $rationale = $w['rationale'];
        // Things you'd have to DO to actually meet this offer's terms, kept
        // apart from the rationale so the page can highlight them -- an
        // offer can be eligible on paper and still need work before it pays
        // out. Direct Debits are checked from what's on file (each account's
        // own count vs. the number the offer wants switched in); anything
        // the engine can't check stays in the offer's Terms rather than
        // being guessed at.
        $todo = $w['todo'];
        $alternativeTo = $w['alternativeTo'] ?? null;
        if ($eligible && $alternativeTo) {
            $band = 'alt';
            $rationale .= sprintf(' This is an alternative to %s from the same banking group — taking one rules you out of the other, and that one pays more, so only one counts.', $alternativeTo);
            $todo = []; // nothing to do for an offer you wouldn't take
        } elseif ($eligible && $donor) {
            $name = (($donor['nickname'] ?? '') ?: ($donor['bank'] ?? ''));
            $rationale .= ' Switch from your ' . $name . ' account.';
            if ($w['needDD']) {
                $have = direct_debits_on($donor);
                if ($have === null) {
                    $todo[] = sprintf("Needs %d+ Direct Debits switched in, and you haven't said how many your %s account has — add that to the account so this can be checked.", $w['needDD'], $name);
                } elseif ($have < $w['needDD']) {
                    $short = $w['needDD'] - $have;
                    $todo[] = sprintf('Needs %d+ Direct Debits switched in, but your %s account has %d — find %d more Direct Debit%s to move across.', $w['needDD'], $name, $have, $short, $short === 1 ? '' : 's');
                }
            }
        } elseif ($eligible && $w['requiresSwitch']) {
            $band = 'blocked';
            $rationale .= $w['donorExisted']
                ? " Your other accounts that can be switched away from are already lined up for better offers above — a full switch moves an account's Direct Debits and closes it, so each can fund only one. This one needs another account to switch from."
                : " This needs a CASS switch from an existing account, and you don't have one on file that can be switched from yet — add an account you're open to switching away from to make this claimable.";
        } elseif ($eligible) {
            $rationale .= ' No switch needed for this one — you can open it fresh (check the conditions for the exact non-switch route).';
        }
        // The third kind of opportunity, after "switch" and "get another
        // account to switch from": offers structured as "no account (or
        // bonus) since / on <date>", which banks re-issue with the date moved
        // forward. Against such a rule, closing an account NOW doesn't undo
        // having held it on that date, so it never qualifies you for THIS
        // version -- but it is the step that lets a LATER version's cutoff
        // pass you by, and a switch away closes it anyway. Deliberately not
        // offered for a plain undated "no open account" rule, and never
        // worded as closing "clearing" anything today.
        $ideas = [];
        $kind = $w['elig']['kind'] ?? '';
        $datePhrase = $kind === 'cutoff' ? 'since ' . substr((string) ($w['offer']['heldSinceCutoff'] ?? ''), 0, 10)
            : ($kind === 'open' && !empty($w['offer']['heldRuleText']) ? (string) $w['offer']['heldRuleText'] : '');
        if (!$eligible && $datePhrase !== '' && !empty($w['elig']['openIds'])) {
            $open = array_values(array_filter($accounts, fn($a) => in_array($a['id'] ?? '', $w['elig']['openIds'], true)));
            $keeping = count(array_filter($open, fn($a) => ($a['wantToKeep'] ?? null) === true)) > 0;
            $closingFor = [];
            foreach ($open as $a) {
                if (isset($donorUse[$a['id'] ?? ''])) $closingFor[] = $donorUse[$a['id']];
            }
            $alsoCloses = $closingFor ? sprintf(' Switching it away for %s already closes it, so this could follow that.', implode(' / ', array_unique($closingFor))) : '';
            $keepNote = $keeping ? sprintf(" You've marked it Keep, so only if the £%s is worth giving it up.", number_format($w['amount'], 0)) : '';
            $ideas[] = sprintf("This offer excludes anyone who held a %s account %s, so closing yours now won't qualify you for this version — but closing it is the step that makes a later version possible, as banks move these dates forward.%s%s", $w['bank'], $datePhrase, $alsoCloses, $keepNote);
        } elseif (!$eligible && $kind === 'bonus-since' && !empty($w['elig']['bonusDates'])) {
            $latest = max($w['elig']['bonusDates']);
            $ideas[] = sprintf("The %s bonus you recorded (%s) falls inside this version's window (bonuses since %s). A later version of this offer with a cutoff after %s would let you back in — worth re-checking when it's refreshed.", $w['bank'], substr($latest, 0, 10), substr((string) ($w['offer']['bonusSinceCutoff'] ?? ''), 0, 10), substr($latest, 0, 10));
        }
        $rows[] = [
            'bank' => $w['bank'],
            'product' => $w['offer']['product'] ?? $w['bank'],
            'action' => $donor ? 'switch' : 'open',
            'fromAccountId' => $donor['id'] ?? null,
            'amount' => $w['amount'],
            'eligible' => $eligible,
            'needsSwitch' => $eligible && $w['requiresSwitch'] && !$alternativeTo,
            'alternativeTo' => $alternativeTo,
            'priority' => $eligible ? $band : 'n/a',
            'todo' => $todo,
            'ideas' => $ideas,
            'cashback' => ($eligible && !$alternativeTo) ? cashback_for_bank($w['bank'], $cache) : [],
            'rationale' => trim($rationale),
            'url' => $w['offer']['url'] ?? '',
            'conditions' => $w['offer']['conditions'] ?? '',
        ];
    }

    // Krak row, if the cache has tier data.
    if (!empty($cache['krakTiers'])) {
        $rows[] = compute_krak_row($user, $cache);
    }

    usort($rows, function ($a, $b) {
        if ($a['eligible'] !== $b['eligible']) return $a['eligible'] ? -1 : 1;
        return $b['amount'] <=> $a['amount'];
    });
    return $rows;
}

// How many of the eligible switch offers you can actually claim with the
// accounts you have, and what to do about the rest. Read off the finished
// rows (each carries its donor) so it can never disagree with them. Null
// when there's nothing switch-shaped to talk about.
function compute_plan(array $rows, array $accounts): ?array {
    $names = [];
    foreach ($accounts as $a) $names[$a['id'] ?? ''] = (($a['nickname'] ?? '') ?: ($a['bank'] ?? ''));
    $assigned = [];
    $waiting = [];
    foreach ($rows as $r) {
        if (empty($r['needsSwitch'])) continue;
        if (!empty($r['fromAccountId'])) $assigned[] = $r; else $waiting[] = $r;
    }
    if (!$assigned && !$waiting) return null;
    $lines = [];
    foreach ($assigned as $r) {
        $lines[] = sprintf('%s (£%s) — switch from your %s account', $r['product'], number_format($r['amount'], 0), $names[$r['fromAccountId']] ?? 'spare');
    }
    $assignedTotal = array_sum(array_column($assigned, 'amount'));
    if ($assigned) {
        $headline = sprintf('You can claim %d of these with the account%s you have to switch away from: £%s in total.', count($assigned), count($assigned) === 1 ? '' : 's', number_format($assignedTotal, 0));
    } else {
        $headline = "None of these can be claimed yet — you have no account on file that can be switched away from.";
    }
    $howTo = [];
    if ($waiting) {
        $waitingTotal = array_sum(array_column($waiting, 'amount'));
        $plural = count($waiting) === 1 ? '' : 's';
        $lines[] = $assigned
            ? sprintf('%d more eligible offer%s (£%s in total) %s no account left to switch from.', count($waiting), $plural, number_format($waitingTotal, 0), count($waiting) === 1 ? 'has' : 'have')
            : sprintf('%d offer%s (£%s in total) %s waiting for an account to switch from.', count($waiting), $plural, number_format($waitingTotal, 0), count($waiting) === 1 ? 'is' : 'are');
        $howTo = [
            "Open another current account with a bank that's in CASS (the CASS map tab shows which of your banks are) and move the Direct Debits that offer needs onto it, then switch from that one. Each extra account you can switch away from is one more switch.",
            "Or take them in turn: once a switch has paid out and you've met its conditions (some need pay-ins for several months), the account you switched INTO can be the next one you switch away from.",
            "Check each offer's Terms first — they can bar switching from the same banking group, and every new account application can leave a mark on your credit file.",
        ];
    }
    return ['headline' => $headline, 'lines' => $lines, 'waiting' => count($waiting), 'howTo' => $howTo];
}

// Krak "Salary Match", per Krak's own help page (see the cache's
// krakTiersSource): the reward is a PERCENTAGE OF EACH SALARY PAYMENT,
// not of your balance. Your average balance over the last 30 days only
// decides which percentage tier you are in. At least krakSalaryMin a
// month of salary is needed to qualify, and salary above krakSalaryCap a
// month isn't counted. This used to apply the percentage to the balance
// as an annual rate -- a misreading of the plan's own wording, caught
// when the figures didn't match how the scheme actually pays out.
function compute_krak_row(array $user, array $cache): array {
    $tiers = $cache['krakTiers'] ?? [];
    usort($tiers, fn($a, $b) => ($a['minBalance'] ?? 0) <=> ($b['minBalance'] ?? 0));
    $minSalary = (float) ($cache['krakSalaryMin'] ?? 2500);
    $salaryCap = (float) ($cache['krakSalaryCap'] ?? 25000);
    $sourceNote = (string) ($cache['krakTiersSource'] ?? '');
    $row = [
        'bank' => 'Kraken',
        'product' => 'Krak Salary Match',
        'action' => 'open',
        'fromAccountId' => null,
        'amount' => 0,
        'eligible' => true,
        'priority' => 'low',
        'todo' => [],
        'ideas' => [],
        'cashback' => [],
        'rationale' => '',
        'url' => 'https://support.krak.app/articles/krak-salary-match',
        'conditions' => sprintf(
            'Needs at least £%s a month of salary paid in by Faster Payments (UK) or SEPA (EU), straight from an employer or other third party, on a regular pattern; a verified Krak account; UK or listed EU/EEA residence. Your tier uses your average total balance across Krak, Kraken and Kraken Pro over the last 30 days, recalculated monthly; the reward is paid at the start of the following month. Tiers last read %s.',
            number_format($minSalary, 0),
            $cache['krakTiersAsOf'] ?? 'unknown'
        ),
    ];
    $salary = $user['annualSalaryNet'] ?? null;
    if (!$salary || (float) $salary <= 0) {
        $row['rationale'] = 'Enter your net annual salary in the profile section above to estimate this — Krak pays a percentage of each salary payment.';
        return $row;
    }
    $monthlySalary = (float) $salary / 12;
    $assumed = $user['assumedBalance'] ?? null;
    $usedAssumed = ($assumed === null || $assumed === '');
    $balance = $usedAssumed ? $monthlySalary * 2 : (float) $assumed;
    $balanceNote = $usedAssumed
        ? sprintf("assuming a £%s average balance (2 months' net salary — enter your own figure in the profile above)", number_format($balance, 0))
        : sprintf('with your stated £%s average balance', number_format($balance, 0));
    if ($monthlySalary < $minSalary) {
        $row['rationale'] = sprintf("Krak needs at least £%s a month of salary paid in to qualify; yours is about £%s a month, so there's no reward at that level.", number_format($minSalary, 0), number_format($monthlySalary, 0));
        return $row;
    }
    $tier = null;
    foreach ($tiers as $t) {
        if ($balance >= ($t['minBalance'] ?? 0)) $tier = $t;
    }
    $percent = $tier ? (float) ($tier['percent'] ?? 0) : 0.0;
    if ($percent <= 0) {
        $firstPaying = null;
        foreach ($tiers as $t) {
            if (($t['percent'] ?? 0) > 0) { $firstPaying = $t; break; }
        }
        $row['rationale'] = $firstPaying
            ? sprintf('0%% on a £%s average balance (%s) — the first paying tier needs £%s or more, so nothing here until you hold that.', number_format($balance, 0), $usedAssumed ? 'assumed' : 'your figure', number_format((float) ($firstPaying['minBalance'] ?? 0), 0))
            : '0% at this balance.';
        return $row;
    }
    $counted = min($monthlySalary, $salaryCap);
    $monthly = $counted * $percent / 100;
    $annual = $monthly * 12;
    $tierName = (string) ($tier['name'] ?? '');
    $capNote = $monthlySalary > $salaryCap ? sprintf(' (only the first £%s of salary counts)', number_format($salaryCap, 0)) : '';
    $row['amount'] = round($annual, 2);
    $row['priority'] = priority_band($annual);
    $row['rationale'] = sprintf(
        '≈£%s a month, £%s over a year — ongoing for as long as your salary keeps landing and your balance stays up, not a one-off. That is %s%% of each ~£%s salary payment%s%s, which needs a £%s+ average balance — %s.%s',
        number_format($monthly, 2),
        number_format($annual, 0),
        rtrim(rtrim(number_format($percent, 2), '0'), '.'),
        number_format($monthlySalary, 0),
        $capNote,
        $tierName !== '' ? " at the {$tierName} tier" : '',
        number_format((float) ($tier['minBalance'] ?? 0), 0),
        $balanceNote,
        $sourceNote !== '' ? ' ' . $sourceNote : ''
    );
    return $row;
}

// A fixed, simple grid: every open account, plus CASS switch-history
// edges (donor -> recipient) between accounts that record one. The
// frontend lays this out 3-wide, wrapping — see js/cass.js.
function compute_cass_grid(array $user, array $cache): array {
    $accounts = $user['accounts'] ?? [];
    $participants = $cache['cassParticipants'] ?? [];
    $nodes = [];
    foreach ($accounts as $a) {
        $nodes[] = [
            'id' => $a['id'],
            'bank' => $a['bank'] ?? '',
            'nickname' => $a['nickname'] ?? '',
            'open' => empty($a['closeDate']),
            'cassReady' => is_cass_ready($a),
            'cassStatus' => is_cass_participant((string) ($a['bank'] ?? ''), $participants),
        ];
    }
    $edges = [];
    foreach ($accounts as $a) {
        // cassFromAccountId mirrors financeaccounts.js's own field name —
        // same "the switch date IS the CASS date" reasoning: no separate
        // date field, openDate of the recipient account already carries it.
        if (!empty($a['cassFromAccountId'])) {
            $edges[] = ['from' => $a['cassFromAccountId'], 'to' => $a['id'], 'label' => $a['openDate'] ?? ''];
        }
    }
    return ['nodes' => $nodes, 'edges' => $edges];
}

// ---- Auth ----------------------------------------------------------

function find_user_by_token(array $data, string $token): ?array {
    if ($token === '') return null;
    $hash = hash('sha256', $token);
    foreach ($data['invites'] as $inv) {
        if (!hash_equals((string) ($inv['tokenHash'] ?? ''), $hash)) continue;
        if (empty($inv['userId'])) return null;
        foreach ($data['users'] as $u) {
            if ($u['id'] === $inv['userId']) return $u;
        }
    }
    return null;
}

function require_admin(string $adminSecret, string $configured): void {
    if ($configured === '' || strpos($configured, 'PUT-') === 0) fail(500, 'Server not configured: set $ADMIN_SECRET');
    if (!hash_equals($configured, $adminSecret)) fail(401, 'Bad or missing admin secret');
}

// ---- Routing ---------------------------------------------------------

$action = $_GET['action'] ?? '';
$method = $_SERVER['REQUEST_METHOD'] ?? 'GET';
$bodyRaw = file_get_contents('php://input') ?: '';
$body = json_decode($bodyRaw, true);
if (!is_array($body)) $body = [];

// Known acronyms/brand casings generic title-casing can't get right on
// its own -- applied word-by-word after cleanup, not as whole-string
// overrides, so "hsbc uk bank plc", "HSBC Private Bank" and "HSBC
// (Channel Islands, Isle of Man)" all come out correctly cased without
// three separate entries in this table.
$BANK_WORD_OVERRIDES = [
    'aib' => 'AIB', 'ni' => 'NI', 'gb' => 'GB', 'uk' => 'UK',
    'hsbc' => 'HSBC', 'tsb' => 'TSB', 'natwest' => 'NatWest',
];
// A couple of names generic cleanup genuinely can't fix word-by-word --
// Tide's own CASS listing carries its banking partner in the name
// ("– provided by Clearbank"), which is marketing fine print, not
// something anyone would type into an account form.
$BANK_FULL_OVERRIDES = [
    'tide – provided by clearbank' => 'Tide',
    'tide - provided by clearbank' => 'Tide',
];

// Turns the raw scraped CASS participant list ("hsbc uk bank plc", all
// lowercase) into names someone would actually recognise and pick from a
// dropdown. Deliberately does NOT strip "co." as a bare corporate suffix
// -- confirmed live as a real corruption risk: "c. hoare & co." and
// "rothschild & co" both have "& Co" as part of the REAL brand name, not
// legal boilerplate, so a blanket "strip trailing co." rule would mangle
// them into "C. Hoare &" with a dangling ampersand.
function clean_bank_display_name(string $raw): string {
    global $BANK_WORD_OVERRIDES, $BANK_FULL_OVERRIDES;
    $s = trim($raw);
    if ($s === '') return '';
    $key = mb_strtolower($s);
    if (isset($BANK_FULL_OVERRIDES[$key])) return $BANK_FULL_OVERRIDES[$key];
    $s = preg_replace('/,?\s*\b(plc|ltd\.?|limited)\s*$/i', '', $s) ?? $s;
    $s = trim($s, " \t\n\r\0\x0B,.");
    if ($s === '') return '';
    $lowerConnectors = ['of', 'and', 'the', 'for'];
    $tokens = preg_split('/(\s+)/', $s, -1, PREG_SPLIT_DELIM_CAPTURE) ?: [$s];
    $out = '';
    $wordIndex = 0;
    foreach ($tokens as $tok) {
        if (trim($tok) === '') { $out .= $tok; continue; } // whitespace run between words
        if (preg_match('/^([^a-zA-Z]*)([a-zA-Z]+)([^a-zA-Z]*)$/', $tok, $m)) {
            [, $pre, $core, $post] = $m;
            $bare = mb_strtolower($core);
            if (isset($BANK_WORD_OVERRIDES[$bare])) {
                $cased = $BANK_WORD_OVERRIDES[$bare];
            } elseif ($wordIndex > 0 && in_array($bare, $lowerConnectors, true)) {
                $cased = $bare;
            } else {
                $cased = mb_strtoupper(mb_substr($core, 0, 1)) . mb_strtolower(mb_substr($core, 1));
            }
            $out .= $pre . $cased . $post;
        } elseif (preg_match('/[a-zA-Z]/', $tok)) {
            // Hyphenated ("co-operative"): the pattern above only takes a
            // single run of letters, so this would otherwise be left
            // lowercase. Capitalise the first letter only -> "Co-operative".
            $out .= mb_strtoupper(mb_substr($tok, 0, 1)) . mb_strtolower(mb_substr($tok, 1));
        } else {
            $out .= $tok; // punctuation-only token (e.g. a bare "&")
        }
        $wordIndex++;
    }
    return trim($out);
}

if ($action === 'banklist') {
    $cache = read_doc($CACHE_FILE, $EMPTY_CACHE);
    // Offer bank names first (already hand-written, cleanest casing) so
    // they win the dedupe below; cleaned CASS names fill in the rest.
    $candidates = array_merge(
        array_map(fn($o) => (string) $o['bank'], $cache['offers'] ?? []),
        array_map('clean_bank_display_name', $cache['cassParticipants'] ?? [])
    );
    // Exact match on a key, NOT bank_names_match()'s substring test: that
    // is right for eligibility (does your "HSBC" account count as the
    // offer's HSBC?) but wrong for a picker -- it folded "Royal Bank of
    // Scotland" into "Bank of Scotland", two different banks in different
    // groups, so RBS vanished from the list. This key only drops generic
    // suffixes (UK / Private / International) and parentheticals, so
    // "HSBC UK Bank", "HSBC Private Bank" and "HSBC (Channel Islands...)"
    // still collapse into "HSBC".
    $listKey = function (string $n): string {
        $k = normalize_bank_name($n);
        $k = preg_replace('/\b(uk|private|international)\b/', ' ', $k) ?? $k;
        return trim(preg_replace('/\s+/', ' ', $k) ?? $k);
    };
    $names = [];
    $seenKeys = [];
    foreach ($candidates as $name) {
        if ($name === '') continue;
        $key = $listKey($name);
        if ($key === '' || isset($seenKeys[$key])) continue;
        $seenKeys[$key] = true;
        $names[] = $name;
    }
    sort($names, SORT_FLAG_CASE | SORT_STRING);
    echo json_encode(['banks' => $names]);
    exit;
}

if ($action === 'referrals') {
    $cache = read_doc($CACHE_FILE, $EMPTY_CACHE);
    echo json_encode([
        'krakTiers' => $cache['krakTiers'] ?? [],
        'krakSalaryMin' => $cache['krakSalaryMin'] ?? null,
        'krakSalaryCap' => $cache['krakSalaryCap'] ?? null,
        'krakTiersAsOf' => $cache['krakTiersAsOf'] ?? null,
        // Surfaced so the frontend can say whether these are confirmed by
        // a real scrape or still the figures seeded at build time --
        // never present an unverified number as settled fact.
        'krakTiersSource' => $cache['krakTiersSource'] ?? null,
    ]);
    exit;
}

// Public and read-only — this is the SAME scraped MSE/CASS data this
// app's own recommendation engine uses, re-published whole. It exists so
// the personal dashboard's own js/features/switchoffers.js can read it
// too instead of running its own separate weekly scrape + AI-parse of
// the identical page — one scrape, one source of structured offers, not
// two that can quietly drift apart. Nothing here is per-user or
// sensitive: it's exactly what MSE's and CASS's own public pages already
// show anyone.
if ($action === 'offers') {
    $cache = read_doc($CACHE_FILE, $EMPTY_CACHE);
    echo json_encode([
        'offers' => $cache['offers'] ?? [],
        'history' => $cache['history'] ?? [],
        'cassParticipants' => $cache['cassParticipants'] ?? [],
        'krakTiers' => $cache['krakTiers'] ?? [],
        'scrapedAt' => $cache['scrapedAt'] ?? null,
    ]);
    exit;
}

if ($action === 'redeem' && $method === 'POST') {
    $token = (string) ($body['token'] ?? '');
    if ($token === '' || strlen($token) < 16) fail(400, 'No invite token given');
    $hash = hash('sha256', $token);
    $result = locked_read_modify_write($DATA_FILE, $EMPTY_DATA, function ($doc) use ($hash) {
        $found = null;
        foreach ($doc['invites'] as &$inv) {
            if (!hash_equals((string) ($inv['tokenHash'] ?? ''), $hash)) continue;
            $found = &$inv;
            break;
        }
        unset($inv);
        if (!$found) return ['doc' => $doc, 'return' => ['error' => 'not_found']];
        $now = gmdate('c');
        if (empty($found['userId'])) {
            $user = [
                'id' => bin2hex(random_bytes(8)),
                'email' => '', 'createdAt' => $now, 'lastSeenAt' => $now,
                'annualSalaryNet' => null, 'annualSalaryGross' => null, 'assumedBalance' => null, 'accounts' => [],
            ];
            $doc['users'][] = $user;
            $found['userId'] = $user['id'];
        }
        $found['lastRedeemedAt'] = $now;
        foreach ($doc['users'] as &$u) {
            if ($u['id'] === $found['userId']) { $u['lastSeenAt'] = $now; $user = $u; break; }
        }
        unset($u);
        return ['doc' => $doc, 'return' => ['user' => sanitize_user($user)]];
    });
    if (isset($result['error'])) fail(401, 'That invite link is not valid.');
    echo json_encode($result);
    exit;
}

if ($action === 'invite-create' && $method === 'POST') {
    require_admin((string) ($_SERVER['HTTP_X_ADMIN_SECRET'] ?? ''), $ADMIN_SECRET);
    $label = trim((string) ($body['label'] ?? ''));
    if ($label === '') $label = 'A person';
    $token = bin2hex(random_bytes(16));
    locked_read_modify_write($DATA_FILE, $EMPTY_DATA, function ($doc) use ($label, $token) {
        $doc['invites'][] = ['id' => bin2hex(random_bytes(6)), 'tokenHash' => hash('sha256', $token), 'label' => $label, 'createdAt' => gmdate('c'), 'userId' => null, 'lastRedeemedAt' => null];
        return ['doc' => $doc, 'return' => null];
    });
    echo json_encode(['token' => $token]);
    exit;
}

if ($action === 'invite-list' && $method === 'GET') {
    require_admin((string) ($_SERVER['HTTP_X_ADMIN_SECRET'] ?? ''), $ADMIN_SECRET);
    $doc = read_doc($DATA_FILE, $EMPTY_DATA);
    $usersById = [];
    foreach ($doc['users'] as $u) $usersById[$u['id']] = $u;
    $invites = array_map(function ($inv) use ($usersById) {
        $user = $inv['userId'] ? ($usersById[$inv['userId']] ?? null) : null;
        return [
            'id' => $inv['id'], 'label' => $inv['label'], 'createdAt' => $inv['createdAt'],
            'redeemed' => (bool) $inv['userId'], 'lastRedeemedAt' => $inv['lastRedeemedAt'] ?? null,
            'userEmail' => $user['email'] ?? '', 'accountCount' => $user ? count($user['accounts'] ?? []) : 0,
        ];
    }, $doc['invites']);
    echo json_encode(['invites' => $invites]);
    exit;
}

// ---- Everything below needs a resolved user ---------------------------

$token = (string) ($_SERVER['HTTP_X_INVITE_TOKEN'] ?? '');
$doc = read_doc($DATA_FILE, $EMPTY_DATA);
$user = find_user_by_token($doc, $token);
if (!$user) fail(401, 'Bad or missing invite token');

if ($action === 'me' && $method === 'GET') {
    $cache = read_doc($CACHE_FILE, $EMPTY_CACHE);
    $recommendations = compute_recommendations($user, $cache);
    echo json_encode([
        'user' => sanitize_user($user),
        'recommendations' => $recommendations,
        'plan' => compute_plan($recommendations, $user['accounts'] ?? []),
        'cassGrid' => compute_cass_grid($user, $cache),
        'cacheAsOf' => $cache['scrapedAt'] ?? null,
    ]);
    exit;
}

if ($action === 'update-profile' && $method === 'POST') {
    $userId = $user['id'];
    $result = locked_read_modify_write($DATA_FILE, $EMPTY_DATA, function ($doc) use ($userId, $body) {
        foreach ($doc['users'] as &$u) {
            if ($u['id'] !== $userId) continue;
            if (array_key_exists('annualSalaryNet', $body)) $u['annualSalaryNet'] = $body['annualSalaryNet'] === null || $body['annualSalaryNet'] === '' ? null : (float) $body['annualSalaryNet'];
            if (array_key_exists('annualSalaryGross', $body)) $u['annualSalaryGross'] = $body['annualSalaryGross'] === null || $body['annualSalaryGross'] === '' ? null : (float) $body['annualSalaryGross'];
            if (array_key_exists('assumedBalance', $body)) $u['assumedBalance'] = $body['assumedBalance'] === null || $body['assumedBalance'] === '' ? null : (float) $body['assumedBalance'];
            if (array_key_exists('email', $body)) $u['email'] = trim((string) $body['email']);
            $u['lastSeenAt'] = gmdate('c');
            return ['doc' => $doc, 'return' => sanitize_user($u)];
        }
        return ['doc' => $doc, 'return' => null];
    });
    echo json_encode(['user' => $result]);
    exit;
}

if ($action === 'account-upsert' && $method === 'POST') {
    $userId = $user['id'];
    $account = is_array($body['account'] ?? null) ? $body['account'] : null;
    if (!$account || empty($account['bank'])) fail(400, 'An account needs at least a bank');
    $result = locked_read_modify_write($DATA_FILE, $EMPTY_DATA, function ($doc) use ($userId, $account) {
        foreach ($doc['users'] as &$u) {
            if ($u['id'] !== $userId) continue;
            $id = $account['id'] ?? '';
            $clean = [
                'id' => $id ?: bin2hex(random_bytes(6)),
                'bank' => (string) $account['bank'],
                'nickname' => (string) ($account['nickname'] ?? ''),
                'openDate' => (string) ($account['openDate'] ?? ''),
                'closeDate' => (string) ($account['closeDate'] ?? ''),
                'wantToKeep' => $account['wantToKeep'] ?? null,
                'directDebitCount' => $account['directDebitCount'] ?? null,
                'cassFromAccountId' => (string) ($account['cassFromAccountId'] ?? ''),
                'switchBonuses' => $account['switchBonuses'] ?? [],
            ];
            $accounts = $u['accounts'] ?? [];
            $idx = null;
            foreach ($accounts as $i => $a) { if ($a['id'] === $clean['id']) { $idx = $i; break; } }
            if ($idx === null) $accounts[] = $clean; else $accounts[$idx] = $clean;
            $u['accounts'] = $accounts;
            $u['lastSeenAt'] = gmdate('c');
            return ['doc' => $doc, 'return' => sanitize_user($u)];
        }
        return ['doc' => $doc, 'return' => null];
    });
    echo json_encode(['user' => $result]);
    exit;
}

if ($action === 'account-delete' && $method === 'POST') {
    $userId = $user['id'];
    $id = (string) ($body['id'] ?? '');
    if ($id === '') fail(400, 'No account id given');
    $result = locked_read_modify_write($DATA_FILE, $EMPTY_DATA, function ($doc) use ($userId, $id) {
        foreach ($doc['users'] as &$u) {
            if ($u['id'] !== $userId) continue;
            $u['accounts'] = array_values(array_filter($u['accounts'] ?? [], fn($a) => $a['id'] !== $id));
            return ['doc' => $doc, 'return' => sanitize_user($u)];
        }
        return ['doc' => $doc, 'return' => null];
    });
    echo json_encode(['user' => $result]);
    exit;
}

fail(400, 'Unknown action');
