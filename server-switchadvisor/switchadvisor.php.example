<?php
declare(strict_types=1);

/**
 * Bank-switch advisor — invite-only, multi-user backend.
 *
 * A completely separate app from the personal dashboard: its own data
 * file, its own secret, its own auth. Nothing here can read or write
 * dashboard-data.json, and nothing in the dashboard can read this file's
 * data either.
 *
 * Auth has no password. An invite link (?invite=<32-hex-token>) IS the
 * credential — the server only ever stores its SHA-256 hash, same as
 * pair.php's device tokens. Redeeming it the first time creates a user
 * and links the invite to them; redeeming it again (a cleared cookie, a
 * new browser) just logs the same person back in. The browser then
 * sends that same token on every call as `X-Invite-Token`.
 *
 *   POST ?action=redeem          {token}                      (public — this IS how you get in)
 *   POST ?action=me              {annualSalaryNet, annualSalaryGross, assumedBalance}  (X-Invite-Token)
 *                                  The figures are used for this one answer and never stored.
 *   POST ?action=update-profile  {email}                       (X-Invite-Token)
 *   POST ?action=account-upsert  {account}                     (X-Invite-Token)
 *   POST ?action=account-delete  {id}                          (X-Invite-Token)
 *   GET  ?action=banklist                                      (public)
 *   GET  ?action=referrals                                     (public)
 *   POST ?action=invite-create   {label}                       (X-Admin-Secret)
 *   GET  ?action=invite-list                                   (X-Admin-Secret)
 *
 * Upload to your Krystal hosting (cPanel -> File Manager), same host as
 * the dashboard's own sync.php but a separate file, separate data store.
 * See server-switchadvisor/README.md.
 */

// ---- Configuration ---------------------------------------------------

// Only you know this — it authorises minting invites and viewing who
// redeemed them. Generate with the same PowerShell one-liner the
// dashboard's own README gives for sync.php's $SECRET.
$ADMIN_SECRET = 'PUT-A-LONG-RANDOM-STRING-HERE';

// Where the two documents live. Defaults to one directory ABOVE this
// script — on cPanel that's outside public_html, so neither file is
// web-reachable even if .htaccess is ever lost.
$DATA_FILE = dirname(__DIR__) . '/switchadvisor-data.json';
$CACHE_FILE = dirname(__DIR__) . '/switchadvisor-cache.json';

// A browser will only let the frontend call this endpoint from an
// origin listed here.
$ALLOWED_ORIGINS = [
    'https://philgewhite-maker.github.io',
    'http://localhost:8743',
];

// ---- End of configuration --------------------------------------------

$origin = $_SERVER['HTTP_ORIGIN'] ?? '';
if ($origin !== '' && in_array($origin, $ALLOWED_ORIGINS, true)) {
    header('Access-Control-Allow-Origin: ' . $origin);
    header('Vary: Origin');
}
header('Access-Control-Allow-Headers: Content-Type, X-Invite-Token, X-Admin-Secret');
header('Access-Control-Allow-Methods: GET, POST, OPTIONS');
header('Access-Control-Max-Age: 86400');
header('Content-Type: application/json');
header('Cache-Control: no-store');

if (($_SERVER['REQUEST_METHOD'] ?? '') === 'OPTIONS') {
    http_response_code(204);
    exit;
}

function fail(int $code, string $message): void {
    http_response_code($code);
    echo json_encode(['error' => $message]);
    exit;
}

// ---- Storage: same flock + atomic-tmp-then-rename shape as the
// dashboard's own sync.php, just with no client-supplied `rev` check —
// each call only ever touches one user's own slice of the document, so
// the lock alone (serialising concurrent requests) is enough to stop a
// lost update; there is no "whole document went stale" case to detect.

function locked_read_modify_write(string $file, array $empty, callable $modify) {
    $lock = fopen($file . '.lock', 'c');
    if ($lock === false) fail(500, 'Could not open lock file — check directory permissions');
    flock($lock, LOCK_EX);
    $current = $empty;
    if (is_file($file)) {
        $raw = file_get_contents($file);
        $parsed = $raw !== false && $raw !== '' ? json_decode($raw, true) : null;
        if (is_array($parsed)) $current = $parsed;
    }
    $result = $modify($current);
    $next = $result['doc'];
    $tmp = $file . '.tmp';
    if (file_put_contents($tmp, json_encode($next)) === false) {
        flock($lock, LOCK_UN);
        fclose($lock);
        fail(500, 'Could not write data file — check directory permissions');
    }
    rename($tmp, $file);
    flock($lock, LOCK_UN);
    fclose($lock);
    return $result['return'] ?? null;
}

function read_doc(string $file, array $empty): array {
    if (!is_file($file)) return $empty;
    $raw = file_get_contents($file);
    if ($raw === false || $raw === '') return $empty;
    $parsed = json_decode($raw, true);
    return is_array($parsed) ? $parsed : $empty;
}

$EMPTY_DATA = ['rev' => 0, 'invites' => [], 'users' => []];
$EMPTY_CACHE = ['scrapedAt' => null, 'history' => [], 'offers' => [], 'cassParticipants' => [], 'cashbackRates' => [], 'krakTiers' => [], 'krakSalaryMin' => null, 'krakSalaryCap' => null, 'krakTiersAsOf' => null, 'krakTiersSource' => null, 'cashbackDeals' => [], 'cashbackAsOf' => null, 'cashbackSources' => []];

// ---- Shared helpers ----------------------------------------------------

// Strips "Bank of", "Building Society", "plc", "Ltd", bracketed codicils
// — same cleanup js/features/switchoffers.js's normalizeBankName applies
// to the identical CASS participant list, so a name matches whether it
// came from that scrape or was typed into the account form.
function normalize_bank_name(string $name): string {
    $s = mb_strtolower($name);
    $s = preg_replace('/\([^)]*\)/', ' ', $s) ?? $s;
    $s = preg_replace('/\b(bank of|building society|bank|plc|ltd|limited|co\.?|&|group|holdings)\b/', ' ', $s) ?? $s;
    $s = preg_replace('/[^a-z0-9]+/', ' ', $s) ?? $s;
    return trim(preg_replace('/\s+/', ' ', $s) ?? $s);
}

function bank_names_match(string $a, string $b): bool {
    $na = normalize_bank_name($a);
    $nb = normalize_bank_name($b);
    if ($na === '' || $nb === '') return false;
    return $na === $nb || strpos($na, $nb) !== false || strpos($nb, $na) !== false;
}

function is_cass_participant(string $bank, array $participants): string {
    $target = normalize_bank_name($bank);
    if ($target === '') return 'unsure';
    foreach ($participants as $p) {
        if (bank_names_match($bank, (string) $p)) return 'yes';
    }
    return 'no';
}

function sanitize_user(array $u): array {
    return [
        'id' => $u['id'],
        'email' => $u['email'] ?? '',
        'createdAt' => $u['createdAt'] ?? null,
        'lastSeenAt' => $u['lastSeenAt'] ?? null,
        'accounts' => $u['accounts'] ?? [],
    ];
}

// ---- Structured offers (schema 2) -------------------------------------------
// The weekly scan reads MoneySavingExpert's prose into this shape, so everything
// downstream works from numbers and dates rather than from sentences:
//
//   payments    what is paid and when: [{amount, count, intervalMonths, anchor,
//               paidWithin:{value,unit}, requirementIds}]  (a staged bonus like
//               £150 then 5 x £30 is two payments)
//   requirements what has to happen, each with its own numbers: [{id, type,
//               count, amount, period, months, withinDays, source, mustStayDays}]
//   switch      the CASS switch: required, minDirectDebits, startBy/completeBy,
//               notFromGroups
//   eligibility who is excluded: heldAccount{since|dateText|ever}, bonusReceived
//               {since|ever}, otherBankRules[{group,event,since}], income{minAnnual,
//               basis,altRoute}
//   fees / perks / ongoing   what the account costs and keeps paying
//
// offer_v2_normalise() validates that, and derives the flat fields the older
// rules (eligibility, income check, the dashboard) still read -- amount,
// ddCount, minFunding, heldSinceCutoff, payInType, salaryMonths and so on --
// so there is ONE place that turns structure into those, never two. Offers
// without "schema": 2 pass through untouched.
const PLAN_MONTH_DAYS = 30;
const COND_TYPES = ['direct-debits', 'salary', 'pay-in', 'debit-card-payments', 'card-spend', 'app-login', 'min-balance', 'keep-open', 'other'];
const PAY_ANCHORS = ['switch-start', 'switch-complete', 'account-open', 'conditions-met'];

function nz_num($v): ?float { return (is_int($v) || is_float($v) || (is_string($v) && is_numeric($v))) ? (float) $v : null; }
function nz_int($v): ?int { $n = nz_num($v); return $n === null ? null : (int) round($n); }
function nz_date($v): ?string { return (is_string($v) && preg_match('/^\d{4}-\d{2}-\d{2}$/', $v)) ? $v : null; }
function nz_str($v): string { return is_string($v) ? trim($v) : ''; }

// "on or before 1 Oct", "on or after 2 Sep", "on 6 May": an offer's own wording for
// when you must not have held an account. The year is not stated, but the intent is
// clear -- it is the most recent such date, i.e. this year's (the offer's own start).
// Read as: 'on-or-after' = nothing held from that date; 'on' = nothing held on that
// day; 'on-or-before' = no account that is still open and was opened by that date.
function resolve_date_phrase(string $text, ?string $today = null): ?array {
    $today = $today ?: date('Y-m-d');
    if (!preg_match('/^\s*on(?:\s+or\s+(before|after))?\s+(\d{1,2})(?:st|nd|rd|th)?\s+([a-z]+)/i', $text, $m)) return null;
    $months = ['jan' => 1, 'feb' => 2, 'mar' => 3, 'apr' => 4, 'may' => 5, 'jun' => 6, 'jul' => 7, 'aug' => 8, 'sep' => 9, 'oct' => 10, 'nov' => 11, 'dec' => 12];
    $mon = $months[strtolower(substr($m[3], 0, 3))] ?? null;
    $day = (int) $m[2];
    if (!$mon || $day < 1 || $day > 31) return null;
    $y = (int) substr($today, 0, 4);
    $d = sprintf('%04d-%02d-%02d', $y, $mon, $day);
    if ($d > $today) $d = sprintf('%04d-%02d-%02d', $y - 1, $mon, $day);
    $mode = $m[1] === '' ? 'on' : (strtolower($m[1]) === 'before' ? 'on-or-before' : 'on-or-after');
    return ['mode' => $mode, 'date' => $d];
}

// "within 28 working days" -> calendar days, so a payout date can be worked out.
function paid_within_days($pw): int {
    if (!is_array($pw)) return 30;
    $v = nz_num($pw['value'] ?? null);
    $u = strtolower(nz_str($pw['unit'] ?? 'days'));
    if ($v === null) return 30;
    if (strpos($u, 'following') !== false) return 35;           // "by the 20th of the following month"
    if (strpos($u, 'working') !== false) return (int) ceil($v * 1.45);
    if (strpos($u, 'month') !== false) return (int) round($v * 30);
    return (int) round($v);
}

function normalise_condition($c, int $i): ?array {
    if (!is_array($c)) return null;
    $type = in_array($c['type'] ?? '', COND_TYPES, true) ? $c['type'] : 'other';
    $period = in_array($c['period'] ?? '', ['once', 'each-month', 'total'], true) ? $c['period'] : 'once';
    $assumed = !empty($c['assumed']);
    $monthsGiven = nz_int($c['months'] ?? null);
    // Salary with no month count: a one-off or first-month requirement is one month; a
    // monthly one the offer doesn't put a number on ("salary paid in each month") is
    // assumed to be 3, and flagged as an assumption.
    // (A monthly salary with no stated count is left null here and worked out from
    // the payment window in offer_v2_normalise(); a first-month-only one is 1.)
    if ($type === 'salary' && $monthsGiven === null && $period !== 'each-month') $monthsGiven = 1;
    $source = in_array($c['source'] ?? '', ['any', 'employer', 'external'], true) ? $c['source'] : null;
    return [
        'id' => nz_str($c['id'] ?? '') ?: 'c' . ($i + 1),
        'type' => $type, 'count' => nz_int($c['count'] ?? null), 'amount' => nz_num($c['amount'] ?? null),
        'period' => $period, 'months' => $monthsGiven, 'withinDays' => nz_int($c['withinDays'] ?? null),
        'source' => $source, 'mustStayDays' => nz_num($c['mustStayDays'] ?? null),
        'anchor' => in_array($c['anchor'] ?? '', ['opening', 'switch-start', 'switch-complete'], true) ? $c['anchor'] : 'opening',
        'assumed' => $assumed, 'text' => nz_str($c['text'] ?? ''),
    ];
}

function offer_v2_normalise(array $o): array {
    if ((int) ($o['schema'] ?? 1) < 2) return $o;
    $conds = [];
    foreach ((array) ($o['requirements'] ?? []) as $i => $c) {
        $n = normalise_condition($c, (int) $i);
        if ($n) $conds[$n['id']] = $n;
    }
    $payments = [];
    foreach ((array) ($o['payments'] ?? []) as $p) {
        if (!is_array($p)) continue;
        $amount = nz_num($p['amount'] ?? null);
        if ($amount === null || $amount <= 0) continue;
        $count = max(1, nz_int($p['count'] ?? 1) ?? 1);
        $interval = nz_int($p['intervalMonths'] ?? null);
        $ids = array_values(array_filter(array_map('strval', (array) ($p['requirementIds'] ?? [])), fn($id) => isset($conds[$id])));
        // Months of salary needed before this payment's LAST instalment is earned
        // (conditions count months from the first month, inclusive), and for its
        // first instalment (one interval earlier per extra instalment).
        $paidDays = paid_within_days($p['paidWithin'] ?? null);
        $anchor = in_array($p['anchor'] ?? '', PAY_ANCHORS, true) ? $p['anchor'] : 'conditions-met';
        $last = 0;
        foreach ($ids as $id) {
            if ($conds[$id]['type'] !== 'salary') continue;
            if ($conds[$id]['months'] === null) {
                // "Salary paid in each month", and the bonus is paid within N days: every payday
                // inside that window is taken to be required (at least 3, conservatively), and the
                // window itself runs from the switch, not from the last payday.
                $conds[$id]['months'] = max(3, (int) ceil($paidDays / PLAN_MONTH_DAYS));
                $conds[$id]['assumed'] = true;
                if ($anchor === 'conditions-met') $anchor = 'switch-complete';
            }
            $last = max($last, $conds[$id]['months']);
        }
        $first = $last ? max(1, $last - ($count - 1) * ($interval ?: 1)) : 0;
        $payments[] = [
            'amount' => $amount, 'count' => $count, 'intervalMonths' => $interval,
            'anchor' => $anchor,
            'conditionsWithinDays' => nz_int($p['conditionsWithinDays'] ?? null),
            'paidDays' => $paidDays, 'requirementIds' => $ids,
            'salaryMonthsLast' => $last, 'salaryMonthsFirst' => $first, 'note' => nz_str($p['note'] ?? ''),
        ];
    }
    $sw = (array) ($o['switch'] ?? []);
    $el = (array) ($o['eligibility'] ?? []);
    $held = (array) ($el['heldAccount'] ?? []);
    $bonus = (array) ($el['bonusReceived'] ?? []);
    $inc = (array) ($el['income'] ?? []);
    $other = [];
    foreach ((array) ($el['otherBankRules'] ?? []) as $r) {
        if (!is_array($r) || nz_str($r['group'] ?? '') === '') continue;
        $other[] = ['group' => nz_str($r['group']), 'event' => in_array($r['event'] ?? '', ['opened-account', 'held-account'], true) ? $r['event'] : 'opened-account', 'since' => nz_date($r['since'] ?? null)];
    }

    $o['requirements'] = array_values($conds);
    $o['payments'] = $payments;
    $o['switch'] = [
        'required' => !array_key_exists('required', $sw) || !empty($sw['required']),
        'minDirectDebits' => nz_int($sw['minDirectDebits'] ?? null), 'withinDaysOfOpening' => nz_int($sw['withinDaysOfOpening'] ?? null),
        'startBy' => nz_date($sw['startBy'] ?? null), 'completeBy' => nz_date($sw['completeBy'] ?? null),
        'notFromGroups' => array_values(array_filter(array_map('strval', (array) ($sw['notFromGroups'] ?? [])))),
    ];
    $o['eligibility'] = [
        'heldAccount' => ['since' => nz_date($held['since'] ?? null), 'dateText' => nz_str($held['dateText'] ?? ''), 'ever' => !empty($held['ever']), 'scope' => nz_str($held['scope'] ?? ''), 'mode' => in_array($held['mode'] ?? '', ['since', 'on', 'open-by'], true) ? $held['mode'] : 'since'],
        'bonusReceived' => ['since' => nz_date($bonus['since'] ?? null), 'ever' => !empty($bonus['ever']), 'scope' => nz_str($bonus['scope'] ?? '')],
        'otherBankRules' => $other,
        'income' => ['minAnnual' => nz_num($inc['minAnnual'] ?? null), 'basis' => in_array($inc['basis'] ?? '', ['gross', 'net'], true) ? $inc['basis'] : null, 'altRoute' => nz_str($inc['altRoute'] ?? ''), 'altRouteNoSwitch' => !empty($inc['altRouteNoSwitch'])],
    ];
    $fees = (array) ($o['fees'] ?? []);
    $o['fees'] = ['monthly' => nz_num($fees['monthly'] ?? null), 'waivedBy' => nz_str($fees['waivedBy'] ?? '')];
    foreach (['perks', 'ongoing'] as $k) {
        $list = [];
        foreach ((array) ($o[$k] ?? []) as $x) {
            if (!is_array($x) || nz_str($x['name'] ?? '') === '') continue;
            $list[] = ['kind' => nz_str($x['kind'] ?? 'perk') ?: 'perk', 'name' => nz_str($x['name']), 'annualValue' => nz_num($x['annualValue'] ?? null), 'needs' => nz_str($x['needs'] ?? $x['note'] ?? '')];
        }
        $o[$k] = $list;
    }

    // ---- derived flat fields -------------------------------------------------
    $total = 0.0;
    foreach ($payments as $p) $total += $p['amount'] * $p['count'];
    if ($total > 0) $o['amount'] = $total;
    $dd = $o['switch']['minDirectDebits'];
    $fund = 0.0; $salaryAmt = null; $salaryMonths = null; $notes = [];
    foreach ($o['requirements'] as $c) {
        if ($c['type'] === 'direct-debits' && $c['count']) $dd = max($dd ?? 0, $c['count']);
        if (in_array($c['type'], ['pay-in', 'salary'], true) && $c['amount']) $fund = max($fund, $c['amount']);
        if ($c['type'] === 'salary') {
            if ($c['amount']) $salaryAmt = max($salaryAmt ?? 0, $c['amount']);
            $salaryMonths = max($salaryMonths ?? 0, $c['months'] ?? 1);
        }
        if (in_array($c['type'], ['pay-in', 'salary'], true) && $c['text'] !== '') $notes[] = $c['text'];
    }
    $hasSalary = $salaryMonths !== null;
    $hasPayIn = false;
    foreach ($o['requirements'] as $c) if ($c['type'] === 'pay-in') $hasPayIn = true;
    $o['ddCount'] = $dd ?: null;
    $o['minFunding'] = $fund > 0 ? $fund : null;
    $o['payInType'] = $hasSalary ? 'salary' : ($hasPayIn ? 'deposit' : null);
    $o['salaryMonths'] = $salaryMonths;
    $o['minMonthlySalary'] = $salaryAmt;
    $firstSalary = null;
    foreach ($payments as $p) {
        if ($p['salaryMonthsLast'] && ($firstSalary === null || $p['salaryMonthsLast'] < $firstSalary['salaryMonthsLast'])) $firstSalary = $p;
    }
    $o['salaryFirstMonthAmount'] = ($hasSalary && count(array_filter($payments, fn($p) => $p['salaryMonthsLast'])) > 1 && $firstSalary) ? $firstSalary['amount'] * $firstSalary['count'] : null;
    $h = $o['eligibility']['heldAccount'];
    if ($h['dateText'] !== '' || ($h['since'] !== null && $h['since'] > date('Y-m-d'))) {
        // A "held since <date>" cutoff cannot lie in the future; that is a year-less phrase
        // ("on or before 1 Oct") that was turned into a date, so keep the phrase instead.
        if ($h['dateText'] === '' && $h['since'] !== null) $h['dateText'] = 'on or after ' . date('j M', strtotime($h['since']));
        $h['since'] = null;
        $o['eligibility']['heldAccount'] = $h;
    }
    $o['heldSinceCutoff'] = $h['since'];
    $o['heldRuleText'] = $h['since'] ? null : ($h['dateText'] ?: null);
    $o['heldOnDate'] = null;
    $o['heldOpenBy'] = null;
    // A full date can still be an "on that day" or "open by that day" rule, not "held since".
    if ($h['since'] && $h['mode'] === 'on') { $o['heldOnDate'] = $h['since']; $o['heldSinceCutoff'] = null; }
    elseif ($h['since'] && $h['mode'] === 'open-by') { $o['heldOpenBy'] = $h['since']; $o['heldSinceCutoff'] = null; }
    if (!$h['since'] && $h['dateText'] !== '') {
        $r = resolve_date_phrase($h['dateText']);
        if ($r) {
            if ($r['mode'] === 'on-or-after') { $o['heldSinceCutoff'] = $r['date']; }
            elseif ($r['mode'] === 'on') { $o['heldOnDate'] = $r['date']; }
            else { $o['heldOpenBy'] = $r['date']; $o['heldRuleText'] = null; } // closing a still-open account clears this one
            if ($r['mode'] === 'on-or-after') $o['heldRuleText'] = null;
        }
    }
    $o['heldEver'] = $h['ever'] && !$h['since'] && !$h['dateText'];
    $b = $o['eligibility']['bonusReceived'];
    $o['bonusSinceCutoff'] = $b['since'];
    $o['minAnnualEarnings'] = $o['eligibility']['income']['minAnnual'];
    $o['incomeBasis'] = $o['eligibility']['income']['basis'];
    $o['incomeAltRoute'] = $o['eligibility']['income']['altRoute'] ?: null;
    $o['requiresSwitch'] = $o['switch']['required'];
    $o['highEarner'] = ($o['tier'] ?? '') === 'high-earner';
    $o['lastSwitchDate'] = $o['switch']['startBy'] ?: $o['switch']['completeBy'];
    $o['payInNote'] = $notes ? implode(' ', array_unique($notes)) : (string) ($o['payInNote'] ?? '');
    // The prose summary (shown under "Terms"); built from the requirements if the scan left it empty.
    if (nz_str($o['conditions'] ?? '') === '') {
        $o['conditions'] = implode(' ', array_filter(array_map(fn($c) => $c['text'], $o['requirements'])));
    }
    return $o;
}

// Applied once, right after the cache is read: structured offers get their
// derived fields, and any banking groups the scan found on the MSE page are
// added to the built-in table.
function normalise_cache(array $cache): array {
    $cache['offers'] = array_map(fn($o) => is_array($o) ? offer_v2_normalise($o) : $o, $cache['offers'] ?? []);
    apply_bank_groups((array) ($cache['bankGroups'] ?? []));
    return $cache;
}

// MSE: "These banks share the same group and FSCS protection: Santander and
// Cahoot | HSBC and First Direct | ..." -- read by the scan as [[names...], ...].
function apply_bank_groups(array $groups): void {
    $map = [];
    foreach ($groups as $names) {
        $names = array_values(array_filter(array_map('strval', (array) $names)));
        if (count($names) < 2) continue;
        // Reuse a built-in key when any member already has one.
        $key = null;
        foreach ($names as $n) {
            $k = normalize_bank_name($n);
            if (isset(BANK_GROUPS[$k])) { $key = BANK_GROUPS[$k]; break; }
        }
        $key = $key ?? normalize_bank_name($names[0]);
        foreach ($names as $n) $map[normalize_bank_name($n)] = $key;
    }
    $GLOBALS['SA_BANK_GROUPS'] = $map;
}

// ---- Recommendation engine: plain rule evaluation over the shared
// cache, no AI call per request (see server-switchadvisor/README.md,
// "why deterministic matching"). ----------------------------------------

// $bonusSinceCutoff distinguishes two real, different exclusion shapes
// seen in the actual offer text: "no PREVIOUS switch bonus" (Barclays,
// First Direct, NatWest -- unconditional, any past Paid bonus excludes
// forever, cutoff null) vs. "no switch bonus SINCE <date>" (Lloyds
// "since 1 Jan 2023", Nationwide "since 2021" -- only a bonus paid ON OR
// AFTER that date excludes; an older one doesn't). Confirmed live as a
// real gap otherwise: treating every Paid bonus as a permanent
// disqualification would wrongly exclude someone forever from a current
// Lloyds offer over a bonus they got in, say, 2019. An undated Paid
// entry can't be proven old enough to ignore, so it's treated as
// blocking -- the safe default when the user hasn't recorded a date.
function account_switch_bonus_blocks(array $accounts, string $bank, ?string $bonusSinceCutoff): bool {
    foreach ($accounts as $a) {
        if (!bank_names_match((string) ($a['bank'] ?? ''), $bank)) continue;
        foreach (($a['switchBonuses'] ?? []) as $sb) {
            if (($sb['status'] ?? '') !== 'Paid') continue;
            if ($bonusSinceCutoff === null) return true;
            $date = (string) ($sb['date'] ?? '');
            if ($date === '' || $date >= $bonusSinceCutoff) return true;
        }
    }
    return false;
}

// Held accounts at this bank, most-recently-closed first. A still-open
// one has closeDate === ''.
function accounts_at_bank(array $accounts, string $bank): array {
    $out = [];
    foreach ($accounts as $a) {
        if (bank_names_match((string) ($a['bank'] ?? ''), $bank)) $out[] = $a;
    }
    usort($out, fn($x, $y) => strcmp((string) ($y['closeDate'] ?? '9999'), (string) ($x['closeDate'] ?? '9999')));
    return $out;
}

function offer_eligibility(array $offer, array $accounts): array {
    $bank = (string) ($offer['bank'] ?? '');
    $held = accounts_at_bank($accounts, $bank);
    $bonusCutoff = $offer['bonusSinceCutoff'] ?? null;
    if (account_switch_bonus_blocks($accounts, $bank, $bonusCutoff)) {
        $reason = $bonusCutoff
            ? "A {$bank} switch bonus is on file as Paid, on or after this offer's own " . substr($bonusCutoff, 0, 10) . ' exclusion cutoff (or with no date recorded against it).'
            : "A {$bank} switch bonus is already on file as Paid.";
        // The dates of the bonuses that block it, so the page can say when a
        // LATER version of this dated offer would let you back in.
        $bonusDates = [];
        if ($bonusCutoff) {
            foreach ($accounts as $a) {
                if (!bank_names_match((string) ($a['bank'] ?? ''), $bank)) continue;
                foreach (($a['switchBonuses'] ?? []) as $sb) {
                    if (($sb['status'] ?? '') === 'Paid' && !empty($sb['date'])) $bonusDates[] = (string) $sb['date'];
                }
            }
        }
        return ['eligible' => false, 'kind' => $bonusCutoff ? 'bonus-since' : 'bonus-ever', 'bonusDates' => $bonusDates, 'reason' => $reason];
    }
    // "Not opened a HSBC current account since 1 Jan 2018" and the like: a rule
    // about a DIFFERENT bank's group, read from the offer's own structure.
    foreach (($offer['eligibility']['otherBankRules'] ?? []) as $rule) {
        $ruleGroup = bank_group((string) $rule['group']);
        foreach ($accounts as $a) {
            if (bank_group((string) ($a['bank'] ?? '')) !== $ruleGroup) continue;
            $since = $rule['since'] ?? null;
            $opened = (string) ($a['openDate'] ?? '');
            if (!$since || $opened === '' || $opened >= $since) {
                return ['eligible' => false, 'kind' => 'other-bank', 'reason' => sprintf("Excluded: %s's terms rule out anyone who %s a %s account%s, and you have one (%s).", $bank, $rule['event'] === 'held-account' ? 'held' : 'opened', $rule['group'], $since ? ' since ' . substr($since, 0, 10) : '', ($a['nickname'] ?? '') ?: ($a['bank'] ?? 'account'))];
            }
        }
    }
    if (!$held) {
        return ['eligible' => true, 'reason' => "You've never held an account with {$bank}."];
    }
    if (!empty($offer['heldEver'])) {
        return ['eligible' => false, 'kind' => 'held-ever', 'reason' => "Excluded: {$bank}'s offer is for people who have never had any {$bank} product, and you have held one."];
    }
    $cutoff = $offer['heldSinceCutoff'] ?? null;
    // The still-open accounts at this bank, handed back with the reason so
    // the recommendations can say whether CLOSING one would change anything
    // -- it depends on the kind of rule: with a dated "held since" cutoff,
    // closing today doesn't undo having held one since then; with a plain
    // "can't hold an open account" rule, closing it does.
    $openIds = array_values(array_map(fn($a) => $a['id'] ?? '', array_filter($held, fn($a) => empty($a['closeDate']))));
    foreach ($held as $a) {
        $closeDate = (string) ($a['closeDate'] ?? '');
        $stillOpen = $closeDate === '';
        $opened = (string) ($a['openDate'] ?? '');
        if (!empty($offer['heldOnDate'])) {
            // "No account on 6 May": held on that day = opened by then and not closed before it.
            $day = $offer['heldOnDate'];
            if (($opened === '' || $opened <= $day) && ($stillOpen || $closeDate >= $day)) {
                return ['eligible' => false, 'kind' => 'held-on', 'openIds' => $openIds, 'reason' => "Excluded: {$bank}'s terms rule out anyone with a {$bank} account on " . date('j M Y', strtotime($day)) . ', and you held one then.'];
            }
            continue;
        }
        if (!empty($offer['heldOpenBy'])) {
            // "No currently open account on or before 1 Oct": open now, and opened by that date.
            if ($stillOpen && ($opened === '' || $opened <= $offer['heldOpenBy'])) {
                return ['eligible' => false, 'kind' => 'open', 'openIds' => $openIds, 'reason' => "You still hold a {$bank} account opened by " . date('j M Y', strtotime($offer['heldOpenBy'])) . ", which this offer excludes — closing it would clear that."];
            }
            continue;
        }
        if ($cutoff) {
            // "Not held an account since <cutoff>" — disqualified if still
            // open, or closed on/after the cutoff date.
            if ($stillOpen || $closeDate >= $cutoff) {
                return ['eligible' => false, 'kind' => 'cutoff', 'openIds' => $openIds, 'reason' => "Excluded: {$bank}'s own terms require no account held since " . substr($cutoff, 0, 10) . ", and you hold one " . ($stillOpen ? 'that is still open' : "closed {$closeDate}") . '.'];
            }
        } else if ($stillOpen) {
            // No dated cutoff captured from the offer's own wording — the
            // safe default is "can't hold one already", same as almost
            // every switch offer's baseline condition.
            return ['eligible' => false, 'kind' => 'open', 'openIds' => $openIds, 'reason' => "You already hold an open {$bank} account — most switch offers exclude existing customers."];
        }
    }
    return ['eligible' => true, 'reason' => "Your {$bank} account(s) closed before this offer's own exclusion window."];
}

// CASS-ready is derived, not a field anyone fills in: open, and not
// explicitly marked "keep" (undecided counts as fair game -- this only
// ever SUGGESTS a donor, never switches anything, so defaulting open
// costs nothing and a separate checkbox was one more thing to explain
// for no real benefit).
function is_cass_ready(array $a): bool {
    return empty($a['closeDate']) && ($a['wantToKeep'] ?? null) !== true;
}

// Banks that share a banking group, as MoneySavingExpert lists them on the
// switch-offers page ("Santander and Cahoot | HSBC and First Direct |
// NatWest and Ulster Bank | Nationwide and Virgin Money") plus the Lloyds
// and NatWest groups the offers' own terms name (Halifax / Bank of Scotland;
// Royal Bank of Scotland). Keys are normalize_bank_name() output. Two rules
// rest on it: a switch has to come from a DIFFERENT group than the one you're
// switching into (MSE: "You must switch from a different banking group"), and
// two offers from the same group are alternatives -- the second excludes you
// once you've taken the first. Anything not listed is its own group.
const BANK_GROUPS = [
    'hsbc' => 'hsbc', 'first direct' => 'hsbc',
    'lloyds' => 'lloyds', 'halifax' => 'lloyds', 'scotland' => 'lloyds',
    'natwest' => 'natwest', 'royal scotland' => 'natwest', 'ulster' => 'natwest',
    'nationwide' => 'nationwide', 'virgin money' => 'nationwide',
    'santander' => 'santander', 'cahoot' => 'santander',
];

function bank_group(string $name): string {
    $k = normalize_bank_name($name);
    if ($k === '') return '';
    $extra = $GLOBALS['SA_BANK_GROUPS'] ?? [];
    if (isset($extra[$k])) return $extra[$k];
    if (isset(BANK_GROUPS[$k])) return BANK_GROUPS[$k];
    // Names often arrive longer than the listed form ("HSBC UK", "Lloyds
    // International"): match on a leading listed name, never a trailing one,
    // so "royal scotland" can't be mistaken for "scotland".
    foreach ($extra as $key => $group) {
        if (strpos($k, $key . ' ') === 0) return $group;
    }
    foreach (BANK_GROUPS as $key => $group) {
        if (strpos($k, $key . ' ') === 0) return $group;
    }
    return $k;
}

function direct_debits_on(array $a): ?int {
    return (isset($a['directDebitCount']) && $a['directDebitCount'] !== '') ? (int) $a['directDebitCount'] : null;
}

// $needDD is how many Direct Debits the offer wants switched in. Among the
// accounts that could be the donor, prefer one that can actually supply
// them -- otherwise "first account in the list" could be picked with 1
// Direct Debit while another has 4, and a shortfall would be reported that
// doesn't exist. Order: confirmed CASS participant first (as before), then
// meets the requirement, then unknown count, then too few; ties go to the
// account with more.
function offer_donor(array $accounts, array $cassParticipants, ?string $excludeBank, ?int $needDD = null): ?array {
    $candidates = [];
    foreach ($accounts as $a) {
        if (!is_cass_ready($a)) continue;
        // Can't switch from the same bank -- or the same banking group.
        if ($excludeBank && (bank_names_match((string) ($a['bank'] ?? ''), $excludeBank) || bank_group((string) ($a['bank'] ?? '')) === bank_group($excludeBank))) continue;
        $status = is_cass_participant((string) ($a['bank'] ?? ''), $cassParticipants);
        if ($status === 'no') continue; // a dead end — can't CASS away from it at all
        $dd = direct_debits_on($a);
        $fit = ($needDD === null || ($dd !== null && $dd >= $needDD)) ? 0 : ($dd === null ? 1 : 2);
        $candidates[] = ['a' => $a, 'rank' => [$status === 'yes' ? 0 : 1, $fit, -($dd ?? 0)]];
    }
    if (!$candidates) return null;
    usort($candidates, fn($x, $y) => $x['rank'] <=> $y['rank']);
    $best = $candidates[0]['a'];
    return $best;
}

// Keyed by (bank, product), not bank alone -- a bank with several
// products on offer at once (e.g. Barclays Bank Account AND Barclays
// Premier, different amounts, same scrape) would otherwise have one
// product's price read as "history" for the other's, producing a
// nonsensical "down from £600" on a product that was never £600.
function same_product(string $a, string $b): bool {
    return mb_strtolower(trim($a)) === mb_strtolower(trim($b));
}

function history_max_for_offer(array $history, string $bank, string $product): ?float {
    $max = null;
    foreach ($history as $snap) {
        foreach (($snap['offers'] ?? []) as $o) {
            if (!bank_names_match((string) ($o['bank'] ?? ''), $bank)) continue;
            if (!same_product((string) ($o['product'] ?? $o['bank'] ?? ''), $product)) continue;
            $amt = (float) ($o['amount'] ?? 0);
            if ($max === null || $amt > $max) $max = $amt;
        }
    }
    return $max;
}

// Net vs gross: the two kinds of figure these offers mention are NOT
// interchangeable, and the profile asks for them separately.
//   minMonthlySalary  - salary that must be PAID IN each month as a condition
//                       of the bonus ("monthly salary payments of £2,000+").
//                       Real money arriving in the account, so it is compared
//                       with your NET (take-home) salary / 12.
//   minAnnualEarnings - an "earn £X a year" threshold. That is BEFORE tax, so
//                       it is compared with your GROSS salary when you've
//                       given it. With only net to go on it can't be settled
//                       either way (£75k gross is roughly £52k take-home,
//                       less with a pension or student loan): net under half
//                       the threshold is far below anything tax explains and
//                       counts as a clear miss; anything between is left for
//                       you to settle by entering your gross salary.
// This engine used to ignore salary requirements entirely (a £10k salary was
// still recommended Barclays Premier).
// incomeAltRoute names a non-salary way in the offer also allows (e.g. £100k
// saved), which this page has no way to check, so it is mentioned rather than
// assumed either way. Returns ['fail' => reason|null, 'todo' => note|null]: a
// clear shortfall makes the offer not eligible, an unknown or borderline one
// becomes a highlighted to-do.
const EARNINGS_FLOOR_RATIO = 0.5;

function offer_income_check(array $offer, array $user): array {
    $none = ['fail' => null, 'todo' => null];
    $minMonthly = !empty($offer['minMonthlySalary']) ? (float) $offer['minMonthlySalary'] : null;
    $minAnnual = !empty($offer['minAnnualEarnings']) ? (float) $offer['minAnnualEarnings'] : null;
    if (!$minMonthly && !$minAnnual) return $none;
    $alt = !empty($offer['incomeAltRoute']) ? sprintf(" (the offer also allows %s, which this page can't check)", $offer['incomeAltRoute']) : '';
    $net = (!empty($user['annualSalaryNet']) && (float) $user['annualSalaryNet'] > 0) ? (float) $user['annualSalaryNet'] : null;
    $gross = (!empty($user['annualSalaryGross']) && (float) $user['annualSalaryGross'] > 0) ? (float) $user['annualSalaryGross'] : null;

    if ($minMonthly) {
        if ($net === null) {
            return ['fail' => null, 'todo' => sprintf('Needs £%s a month of salary paid in — enter your net (take-home) annual salary in the profile section above so this can be checked.', number_format($minMonthly, 0))];
        }
        $monthly = $net / 12;
        if ($monthly < $minMonthly) {
            return ['fail' => sprintf('Needs £%s a month of salary paid in; your take-home is about £%s a month.%s', number_format($minMonthly, 0), number_format($monthly, 0), $alt), 'todo' => null];
        }
        return $none; // the pay-in is the binding test; any "earnings" figure is just MSE's guide to it
    }

    if (!empty($offer['incomeBasis']) && $offer['incomeBasis'] === 'net' && $net !== null) {
        if ($net < $minAnnual) return ['fail' => sprintf('Needs take-home pay of £%s+ a year; yours is £%s.%s', number_format($minAnnual, 0), number_format($net, 0), $alt), 'todo' => null];
        return $none;
    }
    if ($gross !== null) {
        if ($gross < $minAnnual) {
            return ['fail' => sprintf('Needs earnings of £%s+ a year before tax; you have given £%s.%s', number_format($minAnnual, 0), number_format($gross, 0), $alt), 'todo' => null];
        }
        return $none;
    }
    if ($net === null) {
        return ['fail' => null, 'todo' => sprintf('Needs earnings of £%s+ a year before tax — enter your gross (before-tax) salary in the profile section above so this can be checked.', number_format($minAnnual, 0))];
    }
    if ($net < $minAnnual * EARNINGS_FLOOR_RATIO) {
        return ['fail' => sprintf('Needs earnings of £%s+ a year before tax; your take-home of £%s a year is far below that.%s', number_format($minAnnual, 0), number_format($net, 0), $alt), 'todo' => null];
    }
    if ($net < $minAnnual) {
        return ['fail' => null, 'todo' => sprintf("Needs earnings of £%s+ a year before tax. You've only given your take-home (£%s a year), which can't settle that either way — enter your gross (before-tax) salary in the profile section above.", number_format($minAnnual, 0), number_format($net, 0))];
    }
    return $none; // even take-home is at or above the pre-tax figure
}

function priority_band(float $amount): string {
    if ($amount >= 200) return 'high';
    if ($amount >= 100) return 'medium';
    return 'low';
}

// Flat-sum cashback for opening a current account at this bank through
// TopCashback or Quidco, from the weekly scan (only "current account"
// deals are ever stored, so another product from the same bank can't leak
// in). A bank can list several products (Santander Edge, Edge Student...);
// the best one per site is kept and named. Both sites can't be used for one
// application, so these are alternatives, highest first -- and Quidco's
// figure is its premium-member rate, which the page says so.
function cashback_for_bank(string $bank, array $cache): array {
    $sources = $cache['cashbackSources'] ?? [];
    $labels = ['topcashback' => 'TopCashback', 'quidco' => 'Quidco'];
    $best = [];
    foreach (($cache['cashbackDeals'] ?? []) as $d) {
        $provider = (string) ($d['provider'] ?? '');
        if (!isset($labels[$provider]) || !bank_names_match((string) ($d['name'] ?? ''), $bank)) continue;
        $amount = (float) ($d['amount'] ?? 0);
        if ($amount <= 0) continue;
        if (!isset($best[$provider]) || $amount > $best[$provider]['amount']) {
            $best[$provider] = [
                'provider' => $provider, 'label' => $labels[$provider], 'amount' => $amount,
                'name' => (string) ($d['name'] ?? ''), 'url' => (string) ($sources[$provider] ?? ''),
                'asOf' => $cache['cashbackAsOf'] ?? null,
            ];
        }
    }
    $out = array_values($best);
    usort($out, fn($a, $b) => $b['amount'] <=> $a['amount']);
    return $out;
}

function compute_recommendations(array $user, array $cache): array {
    $accounts = $user['accounts'] ?? [];
    $participants = $cache['cassParticipants'] ?? [];
    $history = $cache['history'] ?? [];

    // Pass 1: everything about an offer that doesn't depend on WHICH of your
    // accounts would fund it.
    $work = [];
    foreach (($cache['offers'] ?? []) as $offer) {
        $bank = (string) ($offer['bank'] ?? '');
        $product = (string) ($offer['product'] ?? $bank);
        $amount = (float) ($offer['amount'] ?? 0);
        // Almost every bank "switch bonus" is, by definition, conditional
        // on an actual CASS switch -- MSE's own page title is "Top
        // bonuses for SWITCHING bank". Defaulting true (rather than
        // assuming "you can just open it") matters: confirmed live as a
        // real false claim otherwise -- NatWest Premier Reward's own
        // terms require "£15,000 paid in within 90 days of the SWITCH
        // completing", yet the old fallback text said "you can still
        // open this as a fresh account" when no donor was on file. Only
        // an offer whose own conditions state a genuine no-switch
        // alternative (e.g. HSBC Premier's "£100k+ saved, no switch
        // needed" path) should set this false.
        $requiresSwitch = array_key_exists('requiresSwitch', $offer) ? (bool) $offer['requiresSwitch'] : true;
        $elig = offer_eligibility($offer, $accounts);
        // Account history can already rule an offer out; only if it hasn't
        // does the salary check get a say (and its reason replaces nothing).
        $income = ['fail' => null, 'todo' => null];
        if ($elig['eligible']) {
            $income = offer_income_check($offer, $user);
            if ($income['fail']) $elig = ['eligible' => false, 'reason' => $income['fail']];
        }
        $histMax = history_max_for_offer($history, $bank, $product);
        $band = priority_band($amount);
        $rationale = $elig['reason'];
        if ($elig['eligible'] && $histMax !== null && $amount < $histMax) {
            $band = $band === 'high' ? 'medium' : 'low';
            $lastSeenAt = null;
            foreach (array_reverse($history) as $snap) {
                foreach (($snap['offers'] ?? []) as $o) {
                    if (bank_names_match((string) ($o['bank'] ?? ''), $bank) && same_product((string) ($o['product'] ?? $o['bank'] ?? ''), $product) && (float) ($o['amount'] ?? 0) == $histMax) { $lastSeenAt = $snap['at'] ?? null; break 2; }
                }
            }
            $rationale .= sprintf(' £%s, down from £%s seen%s.', number_format($amount, 0), number_format($histMax, 0), $lastSeenAt ? ' on ' . substr($lastSeenAt, 0, 10) : ' before');
        }
        $work[] = [
            'offer' => $offer, 'bank' => $bank, 'amount' => $amount,
            'requiresSwitch' => $requiresSwitch, 'elig' => $elig,
            'needDD' => !empty($offer['ddCount']) ? (int) $offer['ddCount'] : null,
            'band' => $band, 'rationale' => $rationale,
            'todo' => $income['todo'] ? [$income['todo']] : [],
            'donor' => null, 'donorExisted' => false,
        ];
    }

    // Pass 2: hand out the accounts you could switch away from, best offer
    // first. A full CASS switch moves an account's Direct Debits and closes
    // it, so ONE account can fund ONE switch -- before this, every eligible
    // offer said "switch from your Main account", as if a single account
    // could claim all of them. An offer that doesn't need a switch (the
    // no-switch route) doesn't use one up.
    //
    // One offer per banking group: Barclays Premier and Barclays Bank Account
    // (or HSBC's two, Lloyds', NatWest's, or HSBC + First Direct) are
    // alternatives -- taking one excludes you from the other -- so the
    // better-paying one wins and the rest are marked as alternatives rather
    // than counted as extra money.
    $pool = $accounts;
    $groupTaken = [];
    $order = array_keys($work);
    usort($order, fn($i, $j) => $work[$j]['amount'] <=> $work[$i]['amount']);
    foreach ($order as $i) {
        if (!$work[$i]['elig']['eligible']) continue;
        $group = bank_group($work[$i]['bank']);
        if ($group !== '' && isset($groupTaken[$group])) {
            $work[$i]['alternativeTo'] = $groupTaken[$group];
            continue;
        }
        $donor = offer_donor($pool, $participants, $work[$i]['bank'], $work[$i]['needDD']);
        $work[$i]['donor'] = $donor;
        if ($donor && $work[$i]['requiresSwitch']) {
            $usedId = $donor['id'] ?? '';
            $pool = array_values(array_filter($pool, fn($a) => ($a['id'] ?? '') !== $usedId));
        }
        // This offer now stands for its whole group -- unless it still can't
        // be claimed (a switch is needed and there's nothing to switch from).
        if ($group !== '' && ($donor || !$work[$i]['requiresSwitch'])) {
            $groupTaken[$group] = $work[$i]['offer']['product'] ?? $work[$i]['bank'];
        }
        // No donor left: was that because none ever existed for this offer,
        // or because better offers already used them all? The advice differs.
        if (!$donor) $work[$i]['donorExisted'] = offer_donor($accounts, $participants, $work[$i]['bank'], null) !== null;
    }
    // Which account is already earmarked to be switched away (and so closed)
    // for which offer -- used below, since closing it for THAT reason may
    // also clear what blocks an offer from the same bank.
    $donorUse = [];
    foreach ($work as $w) {
        if ($w['donor'] && $w['requiresSwitch'] && $w['elig']['eligible']) $donorUse[$w['donor']['id'] ?? ''] = $w['offer']['product'] ?? $w['bank'];
    }

    // Pass 3: the rows themselves.
    $rows = [];
    foreach ($work as $w) {
        $donor = $w['donor'];
        $eligible = $w['elig']['eligible'];
        $band = $w['band'];
        $rationale = $w['rationale'];
        // Things you'd have to DO to actually meet this offer's terms, kept
        // apart from the rationale so the page can highlight them -- an
        // offer can be eligible on paper and still need work before it pays
        // out. Direct Debits are checked from what's on file (each account's
        // own count vs. the number the offer wants switched in); anything
        // the engine can't check stays in the offer's Terms rather than
        // being guessed at.
        $todo = $w['todo'];
        $alternativeTo = $w['alternativeTo'] ?? null;
        if ($eligible && $alternativeTo) {
            $band = 'alt';
            $rationale .= sprintf(' This is an alternative to %s from the same banking group — taking one rules you out of the other, and that one pays more, so only one counts.', $alternativeTo);
            $todo = []; // nothing to do for an offer you wouldn't take
        } elseif ($eligible && $donor) {
            $name = (($donor['nickname'] ?? '') ?: ($donor['bank'] ?? ''));
            $rationale .= ' Switch from your ' . $name . ' account.';
            if ($w['needDD']) {
                $have = direct_debits_on($donor);
                if ($have === null) {
                    $todo[] = sprintf("Needs %d+ Direct Debits switched in, and you haven't said how many your %s account has — add that to the account so this can be checked.", $w['needDD'], $name);
                } elseif ($have < $w['needDD']) {
                    $short = $w['needDD'] - $have;
                    $todo[] = sprintf('Needs %d+ Direct Debits switched in, but your %s account has %d — find %d more Direct Debit%s to move across.', $w['needDD'], $name, $have, $short, $short === 1 ? '' : 's');
                }
            }
        } elseif ($eligible && $w['requiresSwitch']) {
            $band = 'blocked';
            $rationale .= $w['donorExisted']
                ? " Your other accounts that can be switched away from are already lined up for better offers above — a full switch moves an account's Direct Debits and closes it, so each can fund only one. This one needs another account to switch from."
                : " This needs a CASS switch from an existing account, and you don't have one on file that can be switched from yet — add an account you're open to switching away from to make this claimable.";
        } elseif ($eligible) {
            $rationale .= ' No switch needed for this one — you can open it fresh (check the conditions for the exact non-switch route).';
        }
        // What the offer needs PAID IN, and what that means for your salary.
        // 'salary' = real earnings must arrive (not a transfer from your own
        // account). Salary can only land in one account at a time, so such an
        // offer ties it up for a number of months and competes with every
        // other salary-tied offer and with Krak; the timeline across offers is
        // compute_salary_plan(). 'deposit' = money from anywhere will do, so a
        // transfer or standing order can meet it.
        $payIn = null;
        $tips = [];
        $payInType = $w['offer']['payInType'] ?? null;
        if ($payInType === 'salary' || $payInType === 'deposit') {
            $payIn = [
                'type' => $payInType,
                'months' => isset($w['offer']['salaryMonths']) ? (int) $w['offer']['salaryMonths'] : null,
                'firstMonthAmount' => isset($w['offer']['salaryFirstMonthAmount']) ? (float) $w['offer']['salaryFirstMonthAmount'] : null,
                'note' => (string) ($w['offer']['payInNote'] ?? ''),
            ];
            if ($eligible && !$alternativeTo) {
                $noteText = $payIn['note'] !== '' ? ' ' . $payIn['note'] : '';
                if ($payInType === 'salary') {
                    $m = $payIn['months'];
                    $todo[] = sprintf('Needs your actual salary paid into this account%s. Salary can only land in one place, so this ties it up — the plan sequences it with the other offers and Krak.%s', $m ? sprintf(' for about %d month%s', $m, $m === 1 ? '' : 's') : '', $noteText);
                } else {
                    $tips[] = sprintf("The pay-in here isn't salary-specific: money from another account counts, so a transfer or standing order into it can do the job.%s Check whether it has to stay there for any length of time before you move it back out.", $noteText);
                }
            }
        }
        if ($eligible && !$alternativeTo && is_fairer_share_bank($w['bank']) && find_fairer_share($cache)) {
            $tips[] = "This account can also earn Nationwide's yearly Fairer Share (about £100; Nationwide has paid it three years running but never promises it): keep the account open past 31 March, use it in January–March, and have £100+ in a Nationwide savings account in March. The dated steps are in the 12-month plan above.";
        }
        // The third kind of opportunity, after "switch" and "get another
        // account to switch from": offers structured as "no account (or
        // bonus) since / on <date>", which banks re-issue with the date moved
        // forward. Against such a rule, closing an account NOW doesn't undo
        // having held it on that date, so it never qualifies you for THIS
        // version -- but it is the step that lets a LATER version's cutoff
        // pass you by, and a switch away closes it anyway. Deliberately not
        // offered for a plain undated "no open account" rule, and never
        // worded as closing "clearing" anything today.
        $ideas = [];
        $kind = $w['elig']['kind'] ?? '';
        $datePhrase = $kind === 'cutoff' ? 'since ' . substr((string) ($w['offer']['heldSinceCutoff'] ?? ''), 0, 10)
            : ($kind === 'held-on' ? 'on ' . date('j M Y', strtotime((string) $w['offer']['heldOnDate']))
            : ($kind === 'open' && !empty($w['offer']['heldRuleText']) ? (string) $w['offer']['heldRuleText'] : ''));
        if (!$eligible && $datePhrase !== '' && !empty($w['elig']['openIds'])) {
            $open = array_values(array_filter($accounts, fn($a) => in_array($a['id'] ?? '', $w['elig']['openIds'], true)));
            $keeping = count(array_filter($open, fn($a) => ($a['wantToKeep'] ?? null) === true)) > 0;
            $closingFor = [];
            foreach ($open as $a) {
                if (isset($donorUse[$a['id'] ?? ''])) $closingFor[] = $donorUse[$a['id']];
            }
            $alsoCloses = $closingFor ? sprintf(' Switching it away for %s already closes it, so this could follow that.', implode(' / ', array_unique($closingFor))) : '';
            $keepNote = $keeping ? sprintf(" You've marked it Keep, so only if the £%s is worth giving it up.", number_format($w['amount'], 0)) : '';
            $ideas[] = sprintf("This offer excludes anyone who held a %s account %s, so closing yours now won't qualify you for this version — but closing it is the step that makes a later version possible, as banks move these dates forward.%s%s", $w['bank'], $datePhrase, $alsoCloses, $keepNote);
        } elseif (!$eligible && $kind === 'bonus-since' && !empty($w['elig']['bonusDates'])) {
            $latest = max($w['elig']['bonusDates']);
            $ideas[] = sprintf("The %s bonus you recorded (%s) falls inside this version's window (bonuses since %s). A later version of this offer with a cutoff after %s would let you back in — worth re-checking when it's refreshed.", $w['bank'], substr($latest, 0, 10), substr((string) ($w['offer']['bonusSinceCutoff'] ?? ''), 0, 10), substr($latest, 0, 10));
        }
        $rows[] = [
            'bank' => $w['bank'],
            'product' => $w['offer']['product'] ?? $w['bank'],
            'action' => $donor ? 'switch' : 'open',
            'fromAccountId' => $donor['id'] ?? null,
            'amount' => $w['amount'],
            'eligible' => $eligible,
            'needsSwitch' => $eligible && $w['requiresSwitch'] && !$alternativeTo,
            'alternativeTo' => $alternativeTo,
            'priority' => $eligible ? $band : 'n/a',
            'todo' => $todo,
            'ideas' => $ideas,
            'tips' => $tips,
            'payIn' => $payIn,
            'cashback' => ($eligible && !$alternativeTo) ? cashback_for_bank($w['bank'], $cache) : [],
            'rationale' => trim($rationale),
            'url' => $w['offer']['url'] ?? '',
            'conditions' => $w['offer']['conditions'] ?? '',
        ];
    }

    // Krak row, if the cache has tier data.
    if (!empty($cache['krakTiers'])) {
        $rows[] = compute_krak_row($user, $cache);
    }

    usort($rows, function ($a, $b) {
        if ($a['eligible'] !== $b['eligible']) return $a['eligible'] ? -1 : 1;
        return $b['amount'] <=> $a['amount'];
    });
    return $rows;
}

// Salary can only land in one account at a time, so every offer that needs
// REAL salary (payInType 'salary') ties it up for some months -- and Krak
// Salary Match, which only counts salary paid straight from an employer, earns
// nothing in those months. This sequences the salary-tied offers you could
// actually claim, says what each month of salary away from Krak costs, and
// compares the result with simply sending salary to Krak. Offers that only
// need money paid in (payInType 'deposit') aren't in it: a transfer or standing
// order covers those, so they don't compete for salary.
//
// A stage is taken only if it pays more than the Krak benefit it displaces, so
// a staged bonus can stop after its first month (Barclays: £150 / £450 after
// month one, then only £30 a month for five more -- less than Krak pays on a
// large salary). The months are estimates from the offers' own windows and
// say so in the notes.
const SALARY_HORIZON_MONTHS = 12;

function compute_salary_plan(array $rows): ?array {
    $krak = 0.0;
    foreach ($rows as $r) {
        if (($r['bank'] ?? '') === 'Kraken') $krak = (float) ($r['monthly'] ?? 0);
    }
    $chains = [];
    foreach ($rows as $r) {
        $pi = $r['payIn'] ?? null;
        if (!$pi || ($pi['type'] ?? '') !== 'salary') continue;
        if (empty($r['eligible']) || !empty($r['alternativeTo'])) continue;
        if (!empty($r['needsSwitch']) && empty($r['fromAccountId'])) continue; // nothing to switch from yet
        $months = max(1, (int) ($pi['months'] ?? 1));
        $first = $pi['firstMonthAmount'] ?? null;
        $amount = (float) $r['amount'];
        $stages = ($first !== null && $months > 1 && $first > 0 && $first < $amount)
            ? [['months' => 1, 'amount' => (float) $first], ['months' => $months - 1, 'amount' => $amount - (float) $first]]
            : [['months' => $months, 'amount' => $amount]];
        $chains[] = ['product' => (string) $r['product'], 'stages' => $stages, 'taken' => 0, 'note' => (string) ($pi['note'] ?? '')];
    }
    if (!$chains) return null;

    // Best-paying month of salary first, but only a stage that pays more than
    // the Krak benefit it displaces, and only what fits the horizon.
    $order = [];
    $used = 0;
    while (true) {
        $best = null;
        foreach ($chains as $c => $ch) {
            $st = $ch['stages'][$ch['taken']] ?? null;
            if (!$st) continue;
            if ($used + $st['months'] > SALARY_HORIZON_MONTHS) continue;
            if ($krak > 0 && $st['amount'] - $st['months'] * $krak <= 0) continue;
            $ratio = $st['amount'] / $st['months'];
            if ($best === null || $ratio > $best['ratio']) $best = ['c' => $c, 'st' => $st, 'ratio' => $ratio];
        }
        if ($best === null) break;
        if (!in_array($best['c'], $order, true)) $order[] = $best['c'];
        $chains[$best['c']]['taken']++;
        $used += $best['st']['months'];
    }

    $money = fn(float $n): string => '£' . number_format($n, 0);
    $kMoney = fn(float $n): string => '£' . number_format($n, 2);
    $krakAlone = $krak * SALARY_HORIZON_MONTHS;
    $headline = 'Where your salary goes — it can only land in one account, so offers that need real salary take turns, and each month away from Krak costs about ' . ($krak > 0 ? $kMoney($krak) : 'nothing (Krak is not paying you at your salary)') . '.';

    if (!$order) {
        return [
            'headline' => $headline,
            'steps' => [],
            'summary' => [sprintf('None of the salary-tied offers is worth moving salary for: each pays less per month of salary than the %s a month Krak pays. Send salary to Krak and take the offers that only need money paid in.', $kMoney($krak))],
            'notes' => [],
        ];
    }

    $steps = [];
    $month = 1;
    $bonuses = 0.0;
    $notes = [];
    foreach ($order as $c) {
        $ch = $chains[$c];
        $takenStages = array_slice($ch['stages'], 0, $ch['taken']);
        $leftStages = array_slice($ch['stages'], $ch['taken']);
        $m = (int) array_sum(array_column($takenStages, 'months'));
        $amt = (float) array_sum(array_column($takenStages, 'amount'));
        $bonuses += $amt;
        $range = $m === 1 ? sprintf('Month %d', $month) : sprintf('Months %d–%d', $month, $month + $m - 1);
        $text = sprintf('%s: %s — salary to this bank, paying %s', $range, $ch['product'], $money($amt));
        if ($leftStages) {
            $leftAmt = (float) array_sum(array_column($leftStages, 'amount'));
            $leftMonths = (int) array_sum(array_column($leftStages, 'months'));
            $text .= sprintf(' for the first month only; staying on for %d more month%s would add just %s, so move salary on', $leftMonths, $leftMonths === 1 ? '' : 's', $money($leftAmt));
        }
        $steps[] = $text . '.';
        $month += $m;
        if ($ch['note'] !== '') $notes[] = $ch['product'] . ': ' . $ch['note'];
    }

    $krakMonths = max(0, SALARY_HORIZON_MONTHS - $used);
    $summary = [];
    if ($krak > 0) {
        $krakValue = $krakMonths * $krak;
        $summary[] = $krakMonths > 0
            ? sprintf('From month %d: salary goes to Krak Salary Match, about %s a month (%s over the rest of the year).', $used + 1, $kMoney($krak), $money($krakValue))
            : 'Krak gets no salary within these 12 months.';
        $summary[] = sprintf('Over %d months that is about %s (%s of bonuses plus %s from Krak), against %s from sending salary to Krak throughout. The %s you give up while salary is elsewhere is already counted.', SALARY_HORIZON_MONTHS, $money($bonuses + $krakValue), $money($bonuses), $money($krakValue), $money($krakAlone), $money($used * $krak));
        $summary[] = 'You can open the Krak account at any time. It only pays on salary landing in it straight from your employer (a standing order from your own account does not count), and its tier follows your average balance over the last 30 days, so have the balance in place before salary starts arriving.';
    } else {
        $summary[] = sprintf('That is about %s of bonuses over %d months, with no Krak benefit lost.', $money($bonuses), SALARY_HORIZON_MONTHS);
    }
    return ['headline' => $headline, 'steps' => $steps, 'summary' => $summary, 'notes' => array_values(array_unique($notes))];
}

// ---- Yearly extras ----------------------------------------------------------
// Payments a bank makes every year to customers who simply keep an account
// and use it (the cache's hand-kept `annualPerks`; the weekly scan carries them
// over untouched). The one so far is Nationwide's "Fairer Share": about £100 to
// members with a current account that was used during January-March and £100+
// of savings (or a mortgage) in March, announced with its May results and paid
// in June -- not guaranteed, and Nationwide confirms each year only afterwards.
// It stays out of the switch-bonus rules above: a Nationwide switch bonus is a
// one-off for opening, this is a yearly payment for staying.

// Nationwide itself; Virgin Money, though it shares Nationwide's banking group,
// missed the 2026 round (the takeover completed after the cutoff).
function is_fairer_share_bank(string $bank): bool {
    return bank_group($bank) === 'nationwide' && stripos($bank, 'virgin') === false;
}

function find_fairer_share(array $cache): ?array {
    foreach (($cache['annualPerks'] ?? []) as $p) {
        if (($p['id'] ?? '') === 'nationwide-fairer-share') return $p;
    }
    return null;
}

// The next window that hasn't finished: [start, end] dates, and the month the
// payment usually lands in.
function perk_window(array $perk, string $today): array {
    $y = (int) substr($today, 0, 4);
    $endMonth = (int) ($perk['windowEndMonth'] ?? 3);
    $startMonth = (int) ($perk['windowStartMonth'] ?? 1);
    $end = date('Y-m-t', strtotime(sprintf('%04d-%02d-01', $y, $endMonth)));
    if ($today > $end) {
        $y++;
        $end = date('Y-m-t', strtotime(sprintf('%04d-%02d-01', $y, $endMonth)));
    }
    return ['year' => $y, 'start' => sprintf('%04d-%02d-01', $y, $startMonth), 'end' => $end, 'payMonth' => (int) ($perk['payMonth'] ?? 6)];
}

function fairer_share_steps_text(array $perk): array {
    return [
        'activity' => 'In at least two of January, February and March, use the account: either pay in £500+ from a non-Nationwide account and make two payments out, or make 10+ payments out (card payments, Direct Debits, bank transfers and standing orders all count; transfers to other Nationwide accounts do not). A FlexOne or FlexStudent account only needs one payment in from outside, or one payment out, in March. Last year\'s rules — Nationwide can change them.',
        'savings' => 'During March have £' . number_format((float) ($perk['savingsMin'] ?? 100), 0) . '+ in a Nationwide savings account (the Flex Regular Saver is the usual route) or owe £100+ on a Nationwide mortgage. Skip this if you already do.',
    ];
}

function compute_annual_perks(array $user, array $cache, ?string $today = null): array {
    $today = $today ?: date('Y-m-d');
    $perk = find_fairer_share($cache);
    if (!$perk) return [];
    $held = [];
    foreach (($user['accounts'] ?? []) as $a) {
        if (!empty($a['closeDate'])) continue;
        if (is_fairer_share_bank((string) ($a['bank'] ?? ''))) $held[] = (($a['nickname'] ?? '') ?: ($a['bank'] ?? 'Nationwide'));
    }
    if (!$held) return [];
    $w = perk_window($perk, $today);
    $days = (int) floor((strtotime($w['start']) - strtotime($today)) / 86400);
    $inside = $today >= $w['start'] && $today <= $w['end'];
    $status = $inside
        ? sprintf('The window is open now and runs to %s.', date('j M Y', strtotime($w['end'])))
        : sprintf('The window opens %s (in %d days) and runs to %s.', date('j M Y', strtotime($w['start'])), $days, date('j M Y', strtotime($w['end'])));
    $text = fairer_share_steps_text($perk);
    return [[
        'id' => $perk['id'], 'name' => $perk['name'] ?? 'Nationwide Fairer Share', 'amount' => (float) ($perk['amount'] ?? 100),
        'guaranteed' => !empty($perk['guaranteed']), 'status' => $status, 'accounts' => $held,
        'todo' => [
            sprintf('Keep your Nationwide account open until after %s — switching it away or closing it before then forfeits the payment.', date('j F Y', strtotime($w['end']))),
            $text['activity'],
            $text['savings'],
            sprintf('The payment is decided with Nationwide\'s results in May and usually lands in %s %d — not guaranteed, and taxable as savings interest (most basic-rate taxpayers owe nothing under the savings allowance).', date('F', mktime(0, 0, 0, $w['payMonth'], 1)), $w['year']),
        ],
        'url' => $perk['url'] ?? '',
    ]];
}

// ---- The plan: a day-by-day sketch of the most you could collect -------------
// Works from the structured offers (see "Structured offers" above): each offer
// says what it pays, when, and what has to happen first, so every switch has a
// start day, a completion day (a CASS switch takes about CASS_DAYS), conditions
// that are met on predictable days, and payouts on predictable days. The account
// has to stay open until its last payout (plus a few days' margin) and only
// then can be switched on, so one account can be passed along a chain of offers.
// The moves it can make:
//   * SWITCH: take one eligible offer, funded by a donor account from a
//     different banking group (a full switch moves the account's Direct Debits
//     and closes it);
//   * a NEW free current account opened just to be switched away from, up to
//     PLAN_MAX_NEW_DONORS, preferably one that pays cashback for opening;
//   * salary-tied offers take turns for your one salary (each costs Krak Salary
//     Match its months); one bonus per banking group; deadlines respected.
// It is a greedy sketch tried at 0..3 new donors in two orders (and, where it
// applies, with and without holding a Nationwide account over 31 March for
// Fairer Share), not a proof of the best possible plan, and says so.
const CASS_DAYS = 10;               // a full switch: 7 working days plus the days either side
const PLAN_SAFETY_DAYS = 5;         // margin after a payout before the account is switched on
const PLAN_MAX_NEW_DONORS = 3;
const PLAN_MIN_SIDE_QUEST = 50;     // a donor account must add at least this to be offered
const PLAN_NEW_DONOR_DAYS = 7;      // opening a new donor and setting up its Direct Debits
const PLAN_MIN_KRAK_MONTHS = 2;     // a stretch of salary at Krak shorter than this isn't worth two repoints

function plan_date(int $day, string $today): string { return date('Y-m-d', strtotime($today . ' +' . $day . ' days')); }
function plan_label(int $day, string $today): string { return date('j M Y', strtotime($today . ' +' . $day . ' days')); }
function plan_day_of(?string $date, string $today): ?int {
    if (!$date || !preg_match('/^\d{4}-\d{2}-\d{2}/', $date)) return null;
    return (int) round((strtotime(substr($date, 0, 10)) - strtotime($today)) / 86400);
}
function plan_money(float $n): string { return '£' . number_format($n, 0); }

// The payouts of the first $takeN payments (ordered by how much salary they
// need) if the switch starts on day $s. Salary instalments are met a salary
// month apart; everything else is assumed done a few days after the switch
// completes. Paid-by dates are measured from when the conditions are met,
// unless the offer anchors them to the switch starting.
function offer_payouts(array $o, int $s, int $takeN): array {
    $c = $s + (!empty($o['switch']['required']) ? CASS_DAYS : 0);
    $out = [];
    foreach (array_slice($o['payments'], 0, $takeN) as $p) {
        $step = PLAN_MONTH_DAYS * ($p['intervalMonths'] ?: 1);
        for ($i = 0; $i < $p['count']; $i++) {
            $met = $p['salaryMonthsLast'] > 0 ? $c + PLAN_MONTH_DAYS * ($p['salaryMonthsFirst'] + $i * ($p['intervalMonths'] ?: 1)) : $c + 3 + $i * $step;
            $base = $p['anchor'] === 'conditions-met' ? $met : ($p['anchor'] === 'switch-complete' ? $c + $i * $step : $s + $i * $step);
            $out[] = ['day' => $base + $p['paidDays'], 'amount' => $p['amount'], 'met' => $met, 'note' => $p['note']];
        }
    }
    return $out;
}

// Payments sorted so the ones needing the least salary come first; a "stage" is a
// prefix of that list.
function offer_sorted_payments(array $o): array {
    $pays = $o['payments'];
    foreach ($pays as $i => &$p) $p['_i'] = $i;
    unset($p);
    usort($pays, fn($a, $b) => [$a['salaryMonthsLast'], $a['_i']] <=> [$b['salaryMonthsLast'], $b['_i']]);
    return $pays;
}

// For a switch starting on day $s: which stage to take (how many payments), what
// that pays within the horizon, how long your salary is tied up, and when the
// account is free to move on. A staged salary bonus is cut off where the next
// stage pays less than the Krak benefit its salary-months would displace.
function plan_choose_stage(array $c, int $s, float $krak, int $H): ?array {
    $o = $c['offer'];
    $o['payments'] = offer_sorted_payments($o);
    $best = null;
    for ($n = 1; $n <= count($o['payments']); $n++) {
        $pays = array_filter(offer_payouts($o, $s, $n), fn($p) => $p['day'] <= $H);
        if (!$pays) continue;
        $value = array_sum(array_column($pays, 'amount'));
        $months = 0;
        foreach (array_slice($o['payments'], 0, $n) as $p) $months = max($months, $p['salaryMonthsLast']);
        $net = $value - ($months ? $months * $krak : 0);
        if ($months && $krak > 0 && $net <= 0) continue;
        if ($best === null || $net > $best['net']) $best = ['net' => $net, 'value' => $value, 'months' => $months, 'payouts' => array_values($pays), 'n' => $n];
    }
    if (!$best) return null;
    $last = max(array_column($best['payouts'], 'day'));
    $complete = $s + (!empty($o['switch']['required']) ? CASS_DAYS : 0);
    $best['complete'] = $complete;
    $best['freeDay'] = max($last, $complete) + PLAN_SAFETY_DAYS;
    $best['metDay'] = max(array_column($best['payouts'], 'met'));
    $best['salaryFrom'] = $best['months'] ? $complete : null;
    $best['salaryTo'] = $best['months'] ? $complete + PLAN_MONTH_DAYS * $best['months'] : null;
    return $best;
}

function plan_simulate(array $cands, array $existing, array $donorSpecs, int $newCount, float $krak, string $order, int $H, ?array $perk, bool $hold, array $locked = [], ?float $stageKrak = null): array {
    usort($cands, function ($a, $b) use ($order) {
        if ($order === 'deadline') {
            $da = $a['deadline'] ?? 99999;
            $db = $b['deadline'] ?? 99999;
            if ($da !== $db) return $da <=> $db;
        }
        return ($b['listed'] + $b['cashback']) <=> ($a['listed'] + $a['cashback']);
    });
    $donors = $existing;
    for ($i = 1; $i <= $newCount; $i++) {
        $spec = $donorSpecs[$i - 1] ?? null;
        $donors[] = [
            'label' => $spec ? 'your new ' . preg_replace('/\s+account$/i', '', $spec['product']) . ' account' : 'new donor account ' . $i,
            'bank' => $spec['product'] ?? '', 'group' => $spec['group'] ?? '', 'from' => PLAN_NEW_DONOR_DAYS, 'dds' => null, 'kind' => 'new', 'index' => $i,
            'cashback' => $spec['cashback'] ?? 0.0, 'site' => $spec['site'] ?? '', 'product' => $spec['product'] ?? '',
        ];
    }
    $perkVia = null;
    if ($hold && $perk) {
        foreach ($donors as $di => $d) {
            if (!empty($d['nationwide'])) {
                $donors[$di]['from'] = max($d['from'], $perk['apr']);
                $perkVia = ['via' => 'existing', 'day' => null];
            }
        }
    }
    $done = [];
    $groups = [];
    $salary = [];      // [from, to) salary intervals already promised
    $events = [];
    $cashback = 0.0;
    $newSeen = [];
    for ($d = 0; $d <= $H; $d++) {
        foreach ($cands as $ci => $c) {
            if (isset($done[$ci]) || isset($groups[$c['group']])) continue;
            if ($c['deadline'] !== null && $d > $c['deadline']) continue;
            // donor
            $pick = null;
            $pickRank = null;
            foreach ($donors as $di => $dn) {
                if (!empty($dn['used']) || $dn['from'] > $d) continue;
                if ($dn['group'] !== '' && $dn['group'] === $c['group']) continue;
                if (in_array($dn['group'], $c['notFromGroups'], true)) continue;
                $fit = ($dn['kind'] === 'new' || $dn['dds'] === null) ? 1 : ($dn['dds'] >= $c['dd'] ? 0 : 2);
                $rank = [$dn['kind'] === 'existing' ? 0 : ($dn['kind'] === 'chain' ? 1 : 2), $fit, -($dn['dds'] ?? 0)];
                if ($pick === null || $rank < $pickRank) {
                    $pick = $di;
                    $pickRank = $rank;
                }
            }
            if ($pick === null) continue;
            // $stageKrak = 0 takes every instalment of a staged bonus whatever Krak would have paid.
            $st = plan_choose_stage($c, $d, $stageKrak ?? $krak, $H);
            if (!$st) continue;
            if ($st['months']) {
                foreach ($salary as [$a, $b]) {
                    if ($st['salaryFrom'] < $b && $st['salaryTo'] > $a) continue 2;
                }
            }
            $dn = $donors[$pick];
            $donors[$pick]['used'] = true;
            $done[$ci] = true;
            $groups[$c['group']] = true;
            if ($st['months']) $salary[] = [$st['salaryFrom'], $st['salaryTo']];
            $cashback += $c['cashback'];
            if ($dn['kind'] === 'new' && !isset($newSeen[$dn['index']])) {
                $newSeen[$dn['index']] = true;
                $cashback += $dn['cashback'];
            }
            $freeFrom = $st['freeDay'];
            if ($hold && $perk && is_fairer_share_bank($c['bank']) && $st['complete'] <= $perk['mar']) {
                $freeFrom = max($freeFrom, $perk['apr']);
                if (!$perkVia) $perkVia = ['via' => 'switch', 'day' => $d];
            }
            $addDDs = ($dn['dds'] !== null && $dn['kind'] !== 'new' && $dn['dds'] < $c['dd']) ? $c['dd'] - $dn['dds'] : 0;
            $events[] = ['day' => $d, 'cand' => $c, 'stage' => $st, 'donor' => $dn, 'addDDs' => $addDDs, 'freeFrom' => $freeFrom];
            $donors[] = [
                'label' => 'your new ' . (preg_match('/account$/i', $c['product']) ? $c['product'] : $c['product'] . ' account'), 'bank' => $c['bank'], 'group' => $c['group'],
                'from' => in_array($c['id'], $locked, true) ? PHP_INT_MAX : $freeFrom, 'kind' => 'chain', 'product' => $c['product'], 'offerId' => $c['id'],
                'dds' => $dn['kind'] === 'new' ? $c['dd'] : ($dn['dds'] === null ? null : max($dn['dds'], $c['dd'])),
            ];
        }
    }
    // Where the salary can sit with Krak: whole salary-months between the
    // tied intervals (and after the last), each stretch is one repoint.
    usort($salary, fn($a, $b) => $a[0] <=> $b[0]);
    $krakMonths = 0;
    $krakSegments = [];
    $cursor = 0;
    foreach (array_merge($salary, [[$H, $H]]) as [$a, $b]) {
        $gap = intdiv(max(0, $a - $cursor), PLAN_MONTH_DAYS);
        if ($gap >= PLAN_MIN_KRAK_MONTHS) {
            $krakMonths += $gap;
            $krakSegments[] = [$cursor, $cursor + $gap * PLAN_MONTH_DAYS];
        }
        $cursor = max($cursor, $b);
    }
    $bonus = 0.0;
    foreach ($events as $e) $bonus += $e['stage']['value'];
    $unused = array_values(array_filter($donors, fn($dn) => empty($dn['used']) && $dn['kind'] !== 'new'));
    return [
        'events' => $events, 'bonus' => $bonus, 'cashback' => $cashback, 'krakMonths' => $krakMonths, 'krakSegments' => $krakSegments,
        'krakValue' => $krak * $krakMonths, 'salary' => $salary,
        'perk' => $perkVia, 'perkValue' => $perkVia ? (float) $perk['amount'] : 0.0,
        'total' => $bonus + $cashback + $krak * $krakMonths + ($perkVia ? (float) $perk['amount'] : 0.0),
        'newUsed' => count($newSeen), 'terminal' => $unused,
        'config' => ['order' => $order, 'hold' => $hold, 'n' => $newCount],
    ];
}

// Turns the plan's switches into cards a person can follow: what to do, in
// order, and WHY this account goes into that one. Every line is built from the
// offer's own structured numbers -- nothing here is free text from the scan.
// Sentences of a requirement's text that admit what the offer leaves unsaid.
function plan_caveat(string $text): string {
    return preg_match_all('/[^.]*(?:does not say|not stated|not say)[^.]*\./i', $text, $m) ? ' ' . trim(implode(' ', array_map('trim', $m[0]))) : '';
}

function plan_requirement_actions(array $o, array $ctx, array $e): array {
    $acts = [];
    $main = $ctx['main'];
    $prod = $o['product'];
    $c = $e['stage']['complete'];
    $today = $ctx['today'];
    // Only what the stages actually taken need: skipping the later instalments of
    // a staged bonus also skips their salary and card-payment requirements.
    $needed = [];
    foreach (array_slice(offer_sorted_payments($o), 0, $e['stage']['n']) as $p) foreach ($p['requirementIds'] as $id) $needed[$id] = true;
    foreach ($o['requirements'] as $r) {
        if ($needed && !isset($needed[$r['id']])) continue;
        $anchorText = ['opening' => 'opening the account', 'switch-start' => 'the switch starting', 'switch-complete' => 'the switch completing'][$r['anchor']] ?? 'opening the account';
        $when = $r['withinDays'] ? sprintf('within %d days of %s', $r['withinDays'], $anchorText) : '';
        switch ($r['type']) {
            case 'direct-debits':
                break; // handled with the switch itself
            case 'salary':
                $m = $r['months'] ?? 1;
                $amt = $r['amount'] ? plan_money($r['amount']) . ' a month' : 'your salary';
                $src = $r['source'] === 'employer' ? ' by Bacs from your employer (a pension or benefits payment also counts; a transfer from your own account does not)' : '';
                $acts[] = ['text' => sprintf('Salary: ask your employer to pay %s into %s from your first payday after %s — for %d month%s%s. %s', $amt, $prod, plan_label($c, $today), $m, $m === 1 ? '' : 's', $src ? ',' . $src : '', $r['assumed'] ? "The offer doesn't say how many months, so $m is assumed — check its terms." : '')];
                break;
            case 'pay-in':
                $stay = $r['mustStayDays'] ? sprintf(' Each deposit has to stay at least %s.', $r['mustStayDays'] <= 1 ? '24 hours' : round($r['mustStayDays']) . ' days') : '';
                if ($r['period'] === 'each-month') {
                    $acts[] = ['text' => sprintf('Set up a standing order of %s a month from %s into %s%s.%s', plan_money($r['amount'] ?? 0), $main, $prod, $r['months'] ? sprintf(' for %d month%s', $r['months'], $r['months'] === 1 ? '' : 's') : '', $stay)];
                } else {
                    $acts[] = ['text' => sprintf('Pay in %s%s: a standing order or transfer from %s into %s%s.%s%s', plan_money($r['amount'] ?? 0), $when ? " $when" : '', $main, $prod, $r['source'] === 'any' ? ' (it can come from your own accounts unless the offer says otherwise)' : '', $stay, plan_caveat($r['text']))];
                }
                break;
            case 'debit-card-payments':
                $n = $r['count'] ?? 1;
                $acts[] = ['text' => $r['period'] === 'each-month' && ($r['months'] ?? 0) > 1
                    ? sprintf('Make %d+ debit card payments with %s in each of the %d months after the switch.', $n, $prod, ($r['months'] ?? 2) - 1)
                    : sprintf('Make %d+ debit card payment%s with %s%s.', $n, $n === 1 ? '' : 's', $prod, $when ? " $when" : '')];
                break;
            case 'card-spend':
                $acts[] = ['text' => sprintf('Spend %s on the %s debit card%s.', plan_money($r['amount'] ?? 0), $prod, $when ? " $when" : '')];
                break;
            case 'app-login':
                $acts[] = ['text' => sprintf('Log in to the %s app%s.', $o['bank'], $when ? " $when" : '')];
                break;
            default:
                if ($r['text'] !== '') $acts[] = ['text' => $r['text']];
        }
    }
    return $acts;
}

function plan_event_why(array $e, array $ctx, int $idx, ?string $prevHolder): array {
    $c = $e['cand'];
    $o = $c['offer'];
    $d = $e['donor'];
    $today = $ctx['today'];
    $st = $e['stage'];
    $why = [];
    $donorBank = $d['bank'] !== '' ? $d['bank'] : 'the donor';
    if ($d['kind'] === 'new') {
        $why[] = sprintf('%s is a brand-new account in a different banking group from %s, so it can be switched into it. You open it only to switch away from — it earns its keep as the starting point for this chain.', $d['label'], $o['bank']);
    } else {
        $why[] = sprintf('%s and %s are different banking groups, which switch offers require.', $donorBank !== 'the donor' ? ucfirst($donorBank) : 'The donor account', $o['bank']);
    }
    if ($c['dd'] > 0) {
        if ($d['kind'] === 'new') $why[] = sprintf('It needs %d Direct Debits switched in, so you set that many small ones up on the donor first (a phone or subscription will do); a full switch carries them across.', $c['dd']);
        elseif ($d['dds'] === null) $why[] = sprintf('It needs %d Direct Debits switched in; you have not said how many %s has — check it before you start.', $c['dd'], $d['label']);
        elseif ($d['dds'] >= $c['dd']) $why[] = sprintf('It needs %d Direct Debits switched in and %s has %d, which all move across with the switch.', $c['dd'], $d['label'], $d['dds']);
        else $why[] = sprintf('It needs %d Direct Debits switched in but %s has %d — add %d more first.', $c['dd'], $d['label'], $d['dds'], $e['addDDs']);
    }
    if ($d['kind'] === 'chain' && $prevHolder) {
        $why[] = sprintf('%s has paid out by %s, so it can be switched on without losing its bonus — and its Direct Debits ride along to the next account.', ucfirst($d['label']), plan_label($d['from'], $today));
    }
    if ($st['months'] > 0) {
        $why[] = sprintf('It needs real salary for %d month%s, so your salary goes here from %s to %s. Salary can only land in one place, so this is sequenced with the other salary-tied offers and Krak.', $st['months'], $st['months'] === 1 ? '' : 's', plan_label($st['salaryFrom'], $today), plan_label($st['salaryTo'], $today));
        $full = $c['stagesTotal'] ?? null;
        if ($full !== null && $st['value'] < $full) $why[] = sprintf('The later instalments (%s more) are skipped: they would tie your salary up for longer than they pay compared with Krak. Tick "Take every instalment" under Options to include them.', plan_money($full - $st['value']));
    }
    if ($c['deadline'] !== null) $why[] = sprintf('The offer ends %s, so it is taken before offers with no deadline.', plan_label($c['deadline'], $today));
    $why[] = sprintf('Pays %s, expected by about %s%s.', plan_money($st['value']), plan_label(max(array_column($st['payouts'], 'day')), $today), count($st['payouts']) > 1 ? sprintf(' (%d payments)', count($st['payouts'])) : '');
    return $why;
}

function plan_cashback_action(array $list, array $ctx, string $what): ?array {
    if (!$list) return null;
    $links = [];
    foreach ($list as $c) {
        $links[] = ['label' => sprintf('%s (%s)', $c['label'], plan_money($c['amount'])), 'url' => $c['url'] ?? '', 'ref' => $c['provider'] ?? ''];
    }
    return ['text' => sprintf('Before you open %s, click through a cashback site — it only tracks if you do, and one site per account:', $what), 'links' => $links, 'kind' => 'cashback'];
}

function plan_build_cards(array $sim, array $ctx, array $cache, array $rows): array {
    $today = $ctx['today'];
    $events = $sim['events'];
    usort($events, fn($a, $b) => $a['day'] <=> $b['day']);
    $cards = [];
    $opened = [];
    $holder = [];      // account label -> product, for "has paid out" wording
    foreach ($events as $i => $e) {
        $c = $e['cand'];
        $o = $c['offer'];
        $d = $e['donor'];
        $st = $e['stage'];
        if ($d['kind'] === 'new' && !isset($opened[$d['index']])) {
            $opened[$d['index']] = true;
            $acts = [];
            if ($d['product'] !== '') {
                $cb = plan_cashback_action($d['cashbackList'] ?? [], $ctx, $d['product']);
                if ($cb) $acts[] = $cb;
                $acts[] = ['text' => sprintf('Open %s (it pays about %s cashback just for opening).', $d['product'], plan_money($d['cashback']))];
            } else {
                $acts[] = ['text' => 'Open a free current account with a bank that is in CASS (Monzo, Starling and Chase usually are) — any bank in a different banking group from the account you switch into.'];
            }
            $acts[] = ['text' => sprintf('Set up %d small Direct Debits on it (a phone, a subscription) — they are what the next switch carries across.', max(2, $c['dd']))];
            $cards[] = [
                'kind' => 'open-donor', 'day' => max(0, $e['day'] - PLAN_NEW_DONOR_DAYS), 'dateLabel' => plan_label(max(0, $e['day'] - PLAN_NEW_DONOR_DAYS), $today),
                'title' => $d['product'] !== '' ? 'Open ' . $d['product'] . ' as a donor account' : 'Open free donor account ' . $d['index'],
                'amount' => $d['cashback'] ?? 0, 'why' => ['A donor account is a free current account you open only to switch away from, so there is something to switch into each bonus account. Opening one adds an application to your credit file, so each is only suggested where it adds at least ' . plan_money(PLAN_MIN_SIDE_QUEST) . '.'],
                'actions' => $acts,
            ];
        }
        $actions = [];
        $cb = plan_cashback_action($c['cashbackList'], $ctx, $o['product']);
        if ($cb) $actions[] = $cb;
        $actions[] = ['text' => sprintf('Open %s. %s', $o['product'], $o['howToOpen'] ?? '')];
        $cass = sprintf('Ask %s to run a Current Account Switch (CASS) from %s — choose a switch date at least 7 working days ahead; allow about %d days in all. It closes %s and moves its Direct Debits and standing orders.', $o['bank'], $e['donor']['label'], CASS_DAYS, $e['donor']['label']);
        if ($o['switch']['startBy']) $cass .= sprintf(' The switch must be started by %s.', plan_label(plan_day_of($o['switch']['startBy'], $today), $today));
        if ($o['switch']['withinDaysOfOpening']) $cass .= sprintf(' Start it within %d days of opening.', $o['switch']['withinDaysOfOpening']);
        $actions[] = ['text' => $cass];
        if ($c['dd'] > 0) {
            $have = $e['donor']['dds'];
            if ($e['donor']['kind'] === 'new') $actions[] = ['text' => sprintf('Make sure the donor has at least %d active Direct Debits when you switch — they move across with the CASS.', $c['dd'])];
            elseif ($have === null) $actions[] = ['text' => sprintf('Check %s has at least %d active Direct Debits (they move across with the CASS) — add any that are missing.', $e['donor']['label'], $c['dd'])];
            elseif ($have >= $c['dd']) $actions[] = ['text' => sprintf('Keep the %d Direct Debits that move across with the CASS active — the offer needs %d+.', $have, $c['dd'])];
            else $actions[] = ['text' => sprintf('Add %d more Direct Debit%s to %s before the switch — the offer needs %d and it has %d.', $e['addDDs'], $e['addDDs'] === 1 ? '' : 's', $e['donor']['label'], $c['dd'], $have)];
        }
        foreach (plan_requirement_actions($o, $ctx, $e) as $a) $actions[] = $a;
        // Pay-ins from your own account can usually go straight back out.
        foreach ($o['requirements'] as $r) {
            if ($r['type'] === 'pay-in' && $r['period'] !== 'each-month' && ($r['source'] ?? 'any') === 'any') {
                $actions[] = ['text' => sprintf('Once the offer\'s conditions are met%s, set up a standing order of %s from %s back to %s (or to the account that pays your bills) — the money only has to pass through.%s', $r['mustStayDays'] ? sprintf(' and the deposit has sat for %s', $r['mustStayDays'] <= 1 ? '24 hours' : round($r['mustStayDays']) . ' days') : '', plan_money($r['amount'] ?? 0), $o['product'], $ctx['main'], $r['mustStayDays'] ? '' : ' The offer doesn\'t say the money has to stay, but check its terms first.')];
                break;
            }
        }
        $last = max(array_column($st['payouts'], 'day'));
        if (!empty($ctx['perkVia']) && $ctx['perkVia']['via'] === 'switch' && $ctx['perkVia']['day'] === $e['day'] && is_fairer_share_bank($o['bank'])) {
            $actions[] = ['text' => ($e['day'] + CASS_DAYS) >= ($ctx['perkJan'] ?? PHP_INT_MAX)
                ? 'Nationwide Fairer Share: because this switch completes in January–March it counts as the account use Fairer Share asks for — keep the account open past 31 March and have £100 in a Nationwide savings account in March (see the Fairer Share steps below).'
                : 'Nationwide Fairer Share: this account is kept open past 31 March for it (see the Fairer Share steps below), which is why it is not switched on sooner.'];
        }
        $actions[] = ['text' => sprintf('Expect %s around %s. Keep %s open until %s.%s', plan_money($st['value']), plan_label($last, $today), $o['product'], plan_label($e['freeFrom'], $today), $e['freeFrom'] > $st['freeDay'] ? ' (held longer than the bonus needs, for Nationwide Fairer Share.)' : '')];
        $prevHolder = $e['donor']['kind'] === 'chain' ? ($holder[$e['donor']['label']] ?? $e['donor']['product'] ?? null) : null;
        $cards[] = [
            'kind' => 'switch', 'day' => $e['day'], 'dateLabel' => plan_label($e['day'], $today),
            'title' => sprintf('%s → %s', preg_replace('/^your (new )?/i', '', $e['donor']['label']), $o['product']),
            'amount' => $st['value'], 'why' => plan_event_why($e, $ctx, $i, $prevHolder), 'actions' => $actions,
            'completes' => plan_label($st['complete'], $today), 'bonusBy' => plan_label($last, $today), 'freeFrom' => plan_label($e['freeFrom'], $today),
            'salary' => $st['months'] ? ['from' => plan_label($st['salaryFrom'], $today), 'to' => plan_label($st['salaryTo'], $today), 'months' => $st['months']] : null,
            'cashback' => $c['cashback'], 'url' => $o['url'] ?? '', 'bank' => $o['bank'], 'product' => $o['product'],
        ];
        $holder[$e['donor']['label']] = $o['product'];
    }
    return $cards;
}

// Krak Salary Match gets your salary in every whole month the salary-tied
// offers don't have it.
function plan_krak_cards(array $sim, array $ctx, array $cache): array {
    $krak = $ctx['krak'];
    if ($krak <= 0 || !$sim['krakSegments']) return [];
    $tiers = $cache['krakTiers'] ?? [];
    usort($tiers, fn($a, $b) => ($a['minBalance'] ?? 0) <=> ($b['minBalance'] ?? 0));
    $tier = null;
    foreach ($tiers as $t) if ($ctx['krakBalance'] >= ($t['minBalance'] ?? 0)) $tier = $t;
    $today = $ctx['today'];
    $cards = [];
    foreach ($sim['krakSegments'] as $i => [$a, $b]) {
        $months = intdiv($b - $a, PLAN_MONTH_DAYS);
        $acts = [];
        if ($i === 0) {
            $acts[] = ['text' => 'Open a Krak account (the Kraken app) and verify it.', 'link' => ['label' => 'Open Krak', 'url' => 'https://support.krak.app/articles/krak-salary-match', 'ref' => 'krak']];
        }
        $acts[] = ['text' => sprintf('Ask your employer to pay your salary into Krak by Faster Payments from %s — it has to come straight from an employer (or another third party) and be at least %s a month; a standing order from your own account does not count.', plan_label($a, $today), plan_money((float) ($cache['krakSalaryMin'] ?? 2500)))];
        $acts[] = ['text' => sprintf('Krak pays a percentage of each salary payment, set by your average balance over the last 30 days%s. Have the balance in place a month before the salary starts arriving.', $tier ? sprintf(' — at your assumed balance of %s that is %s%% (the %s tier), about %s a month', plan_money($ctx['krakBalance']), rtrim(rtrim(number_format((float) $tier['percent'], 2), '0'), '.'), $tier['name'] ?? '', plan_money($krak)) : '')];
        $cards[] = [
            'kind' => 'krak', 'day' => $a, 'dateLabel' => plan_label($a, $today),
            'title' => $i === 0 ? 'Send your salary to Krak Salary Match' : 'Move your salary back to Krak',
            'amount' => $krak * $months,
            'why' => [sprintf('Salary only lands in one account. For %d month%s nothing else in this plan needs it, and Krak pays about %s a month for it — an ongoing benefit, not a one-off.', $months, $months === 1 ? '' : 's', plan_money($krak))],
            'actions' => $acts, 'krak' => true,
        ];
    }
    return $cards;
}

// What you are left with. Keepers are chosen from the accounts the plan leaves
// open at the end, by what they keep paying (the offers' own `ongoing` and
// `perks` numbers, less any monthly fee); the rest are closed so a later round
// of offers can include them.
function plan_end_state(array $sim, array $ctx, array $cache, array $byId): array {
    $today = $ctx['today'];
    $keep = [];
    if ($ctx['krak'] > 0 && $sim['krakSegments']) {
        $keep[] = ['name' => 'Krak Salary Match', 'text' => 'Krak Salary Match — your salary lands here whenever no offer needs it, about ' . plan_money($ctx['krak']) . ' a month, and keeps paying for as long as the salary and balance do.'];
    }
    // Accounts the plan leaves open at the end, valued by what they keep paying.
    $closeAtEnd = [];
    foreach ($sim['terminal'] as $dn) {
        $o = $byId[$dn['offerId'] ?? ''] ?? null;
        if (!$o) continue;
        $value = 0.0;
        $parts = [];
        $n = 0;
        foreach (array_merge($o['ongoing'], $o['perks']) as $b) {
            if ($b['annualValue']) { $value += $b['annualValue']; $n++; $parts[] = $b['name'] . (' ' . '(' . plan_money($b['annualValue']) . ')'); }
        }
        if ($n === 1) $parts = [preg_replace('/ \(£[\d,]+\)$/', '', $parts[0])];
        if ($value > 0) $keep[] = ['name' => $o['product'], 'text' => sprintf('%s — keeps paying about %s a year: %s.', $o['product'], plan_money($value), implode('; ', $parts))];
        else $closeAtEnd[] = $o['product'];
    }
    // Accounts the plan switches ON that are worth more kept: how much of the
    // later plan does keeping each one cost?
    $alts = [];
    $terminalIds = array_column($sim['terminal'], 'offerId');
    foreach ($sim['events'] as $e) {
        if (in_array($e['cand']['id'], $terminalIds, true)) continue; // already left open at the end
        $o = $e['cand']['offer'];
        $value = 0.0;
        $parts = [];
        foreach (array_merge($o['ongoing'], $o['perks']) as $b) {
            if ($b['annualValue']) { $value += $b['annualValue']; $parts[] = $b['name']; }
        }
        if ($value < 60 || !isset($ctx['rerun'])) continue;
        $v = ($ctx['rerun'])([$e['cand']['id']]);
        $cost = $v ? max(0, $sim['total'] - $v['total']) : null;
        $alts[] = sprintf('Keep %s instead of switching it on to the next offer: it keeps paying about %s a year (%s)%s.', $o['product'], plan_money($value), implode('; ', array_slice($parts, 0, 2)),
            $cost === null ? '' : ($cost > 0 ? sprintf(', but the later switches in this plan would lose about %s', plan_money($cost)) : ' — and it costs the rest of this plan nothing'));
    }
    // A separate account for bills: where your Direct Debits finally settle.
    // A monthly pay-in test is NOT an income test: unless an offer says "salary", money
    // moved in from your own accounts normally counts, so savings can be rotated through
    // to meet it. The best account is suggested whatever your income, with the pay-in
    // named so you can check it.
    $bills = null;
    foreach (($cache['ongoingAccounts'] ?? []) as $a) {
        if (($a['kind'] ?? '') !== 'bills-cashback' || empty($a['annualValue'])) continue;
        if ($bills === null || $a['annualValue'] > $bills['annualValue']) $bills = $a;
    }
    if ($bills) {
        $inCass = is_cass_participant((string) $bills['bank'], $cache['cassParticipants'] ?? []) === 'yes';
        $needs = [];
        if (!empty($bills['minPayIn'])) $needs[] = 'pay in ' . plan_money($bills['minPayIn']) . ' a month — money moved in from your own accounts normally counts, but check the terms';
        if (!empty($bills['monthlyFee'])) $needs[] = 'a ' . plan_money($bills['monthlyFee']) . '/month fee';
        $keep[] = ['name' => $bills['product'], 'text' => sprintf('%s as your bills account (optional, one more account) — up to about %s a year%s, if your qualifying bills reach its cap. %s Move your Direct Debits onto it once the last bonus is paid%s.', $bills['product'], plan_money($bills['annualValue']), $needs ? ' (' . implode(', ', $needs) . ')' : '', $bills['summary'] ?? '', $inCass ? ', with a CASS switch' : ' (repoint them one by one — it is not on the CASS list)')];
    }
    $notes = [];
    $notes[] = 'Where your Direct Debits end up: they travel with each switch, so they sit on the last account in the chain. Before you finish, move them onto the account you keep for bills.';
    $notes[] = 'Close the accounts you no longer need: many offers exclude anyone who held an account since a date, and banks keep moving that date forward — a closed account can let you in again for a future round.';
    return ['keep' => array_map(fn($k) => $k['text'], $keep), 'alternatives' => $alts, 'close' => $closeAtEnd, 'notes' => $notes];
}
function plan_options(array $raw): array {
    $months = (int) ($raw['horizonMonths'] ?? 12);
    if (!in_array($months, [6, 12, 18, 24], true)) $months = 12;
    return [
        'horizonMonths' => $months,
        'minimise' => !empty($raw['minimiseSwitches']),
        'allowNew' => !array_key_exists('allowNewAccounts', $raw) || !empty($raw['allowNewAccounts']),
        'fullBonuses' => !empty($raw['fullBonuses']),
        'primaryId' => (!empty($raw['keepPrimary']) && is_string($raw['primaryAccountId'] ?? null)) ? $raw['primaryAccountId'] : '',
    ];
}

// $rows are compute_recommendations()' rows (one per offer, with eligibility
// and income already decided); $user's accounts supply the donors.
function compute_plan_v2(array $user, array $cache, array $rows, array $rawOptions = [], ?string $today = null): ?array {
    $today = $today ?: date('Y-m-d');
    $opt = plan_options($rawOptions);
    $H = (int) round($opt['horizonMonths'] * 30.4);
    $krak = 0.0;
    foreach ($rows as $r) if (($r['bank'] ?? '') === 'Kraken') $krak = (float) ($r['monthly'] ?? 0);
    $krakBalance = (float) ($user['assumedBalance'] ?? 0) ?: (((float) ($user['annualSalaryNet'] ?? 0)) / 12 * 2);

    $byId = [];
    $byProduct = [];
    foreach (($cache['offers'] ?? []) as $o) {
        if ((int) ($o['schema'] ?? 1) < 2 || empty($o['payments'])) continue;
        $byProduct[mb_strtolower(trim((string) $o['product']))] = $o;
        $byId[$o['id'] ?? ''] = $o;
    }
    $cands = [];
    $needIncome = [];
    $incomeKnown = !empty($user['annualSalaryNet']) || !empty($user['annualSalaryGross']);
    foreach ($rows as $r) {
        if (($r['bank'] ?? '') === 'Kraken' || empty($r['eligible'])) continue;
        $o = $byProduct[mb_strtolower(trim((string) $r['product']))] ?? null;
        if (!$o) continue;
        // An offer with an earnings or salary test can't be planned until the page knows your income (a pay-in test is not one: savings can be rotated through to meet it).
        if (!$incomeKnown && (!empty($o['minAnnualEarnings']) || !empty($o['minMonthlySalary']))) {
            $needIncome[] = (string) $o['product'];
            continue;
        }
        $deadline = plan_day_of($o['switch']['startBy'] ?? null, $today);
        if ($deadline === null && !empty($o['switch']['completeBy'])) {
            $cd = plan_day_of($o['switch']['completeBy'], $today);
            $deadline = $cd === null ? null : $cd - CASS_DAYS;
        }
        if ($deadline !== null && $deadline < 0) continue;
        $cb = 0.0;
        $cbList = $r['cashback'] ?? [];
        foreach ($cbList as $x) $cb = max($cb, (float) ($x['amount'] ?? 0));
        $total = 0.0;
        foreach ($o['payments'] as $p) $total += $p['amount'] * $p['count'];
        $notFrom = [];
        foreach ($o['switch']['notFromGroups'] as $g) $notFrom[] = bank_group($g);
        if ($opt['minimise'] && $total + $cb < 200) continue;
        $cands[] = [
            'id' => $o['id'] ?? $r['product'], 'product' => (string) $o['product'], 'bank' => (string) $o['bank'], 'group' => bank_group((string) $o['bank']),
            'offer' => $o, 'dd' => (int) ($o['ddCount'] ?? 0), 'fund' => (float) ($o['minFunding'] ?? 0), 'deadline' => $deadline,
            'cashback' => $cb, 'cashbackList' => $cbList, 'listed' => $total, 'stagesTotal' => $total,
            'notFromGroups' => $notFrom, 'history' => history_max_for_offer($cache['history'] ?? [], (string) $o['bank'], (string) $o['product']),
        ];
    }
    if (!$cands && !$needIncome) return null;
    if (!$cands) {
        return ['headline' => 'Add your income to see which offers you can plan for.', 'cards' => [], 'quests' => [], 'notes' => ['These offers need your income to be checked: ' . implode(', ', $needIncome) . '. Enter your take-home pay (and, for the premier accounts, your pay before tax) under "Your figures".'], 'endState' => ['keep' => [], 'close' => [], 'notes' => []], 'total' => 0, 'bonus' => 0, 'cashback' => 0, 'krak' => 0, 'fairerShare' => 0, 'switches' => 0, 'newDonors' => 0, 'openings' => 0, 'repoints' => 0, 'horizonMonths' => $opt['horizonMonths'], 'today' => $today, 'needsIncome' => $needIncome];
    }

    $existing = [];
    $heldGroups = [];
    $mainLabel = 'your main account';
    foreach (($user['accounts'] ?? []) as $a) {
        $heldGroups[bank_group((string) ($a['bank'] ?? ''))] = true;
        $isPrimary = $opt['primaryId'] !== '' && ($a['id'] ?? '') === $opt['primaryId'];
        $label = ($a['nickname'] ?? '') ?: ($a['bank'] ?? 'account');
        if ($isPrimary || (($a['wantToKeep'] ?? null) === true && empty($a['closeDate']) && $mainLabel === 'your main account')) $mainLabel = 'your ' . $label . ' account';
        if ($isPrimary || !is_cass_ready($a)) continue;
        if (is_cass_participant((string) ($a['bank'] ?? ''), $cache['cassParticipants'] ?? []) === 'no') continue;
        $existing[] = ['label' => 'your ' . $label . ' account', 'bank' => (string) ($a['bank'] ?? ''), 'group' => bank_group((string) ($a['bank'] ?? '')), 'from' => 0, 'dds' => direct_debits_on($a), 'kind' => 'existing', 'id' => $a['id'] ?? '', 'nationwide' => is_fairer_share_bank((string) ($a['bank'] ?? ''))];
    }
    // New donor accounts: best opened with a bank that pays cashback for opening it.
    $candGroups = array_column($cands, 'group');
    $specs = [];
    $sources = $cache['cashbackSources'] ?? [];
    foreach (($cache['cashbackDeals'] ?? []) as $d) {
        $name = (string) ($d['name'] ?? '');
        $g = bank_group($name);
        $amt = (float) ($d['amount'] ?? 0);
        if ($g === '' || $amt <= 0 || isset($heldGroups[$g]) || in_array($g, $candGroups, true) || preg_match('/student|graduate|youth|junior|child|kids|under/i', $name)) continue;
        if (!isset($specs[$g]) || $amt > $specs[$g]['cashback']) {
            $prov = ($d['provider'] ?? '') === 'quidco' ? 'quidco' : 'topcashback';
            $specs[$g] = ['product' => $name, 'group' => $g, 'cashback' => $amt, 'site' => $prov === 'quidco' ? 'Quidco' : 'TopCashback'];
        }
    }
    $donorSpecs = array_values($specs);
    usort($donorSpecs, fn($a, $b) => $b['cashback'] <=> $a['cashback']);
    foreach ($donorSpecs as $i => $sp) {
        $list = [];
        foreach (($cache['cashbackDeals'] ?? []) as $d) {
            if (bank_group((string) ($d['name'] ?? '')) !== $sp['group'] || preg_match('/student|graduate|youth|junior|child|kids|under/i', (string) ($d['name'] ?? ''))) continue;
            $prov = ($d['provider'] ?? '') === 'quidco' ? 'quidco' : 'topcashback';
            if (!isset($list[$prov]) || $d['amount'] > $list[$prov]['amount']) $list[$prov] = ['provider' => $prov, 'label' => $prov === 'quidco' ? 'Quidco' : 'TopCashback', 'amount' => (float) $d['amount'], 'url' => (string) ($sources[$prov] ?? '')];
        }
        $donorSpecs[$i]['cashbackList'] = array_values($list);
    }

    $perk = null;
    $fs = find_fairer_share($cache);
    if ($fs) {
        $w = perk_window($fs, $today);
        $mar = plan_day_of($w['end'], $today);
        if ($mar !== null && $mar >= 0 && $mar <= $H) {
            $perk = ['amount' => (float) ($fs['amount'] ?? 100), 'jan' => plan_day_of($w['start'], $today), 'mar' => $mar, 'apr' => $mar + 1, 'pay' => $mar + 75, 'def' => $fs, 'year' => $w['year']];
        }
    }

    // Offers in one banking group exclude each other, and greedily taking a small
    // one can block a bigger one; so try the best of each group on its own too.
    $bestPerGroup = [];
    foreach ($cands as $c) {
        $g = $c['group'];
        if (!isset($bestPerGroup[$g]) || $c['listed'] + $c['cashback'] > $bestPerGroup[$g]['listed'] + $bestPerGroup[$g]['cashback']) $bestPerGroup[$g] = $c;
    }
    $candSets = [$cands];
    if (count($bestPerGroup) < count($cands)) $candSets[] = array_values($bestPerGroup);
    $stageKrak = $opt['fullBonuses'] ? 0.0 : null;
    $maxNew = (!$opt['allowNew']) ? 0 : ($opt['minimise'] ? ($existing ? 0 : 1) : PLAN_MAX_NEW_DONORS);
    $sims = [];
    for ($n = 0; $n <= $maxNew; $n++) {
        $bestSim = null;
        foreach ($candSets as $si => $set) {
            foreach (['amount', 'deadline'] as $order) {
                foreach ($perk ? [false, true] : [false] as $hold) {
                    $s = plan_simulate($set, $existing, $donorSpecs, $n, $krak, $order, $H, $perk, $hold, [], $stageKrak);
                    $s['config']['setIndex'] = $si;
                    if ($bestSim === null || $s['total'] > $bestSim['total']) $bestSim = $s;
                }
            }
        }
        $sims[] = $bestSim;
    }
    $ladder = [];
    foreach ($sims as $s) {
        if ($ladder && $s['total'] < end($ladder)['total'] + PLAN_MIN_SIDE_QUEST) continue;
        $ladder[] = $s;
    }
    $chosen = end($ladder);
    $cfg = $chosen['config'];
    $rerun = function (array $locked) use ($candSets, $existing, $donorSpecs, $krak, $H, $perk, $cfg, $stageKrak) {
        return plan_simulate($candSets[$cfg['setIndex']] ?? $candSets[0], $existing, $donorSpecs, $cfg['n'], $krak, $cfg['order'], $H, $perk, $cfg['hold'], $locked, $stageKrak);
    };
    $ctx = ['rerun' => $rerun, 'today' => $today, 'main' => $mainLabel, 'krak' => $krak, 'krakBalance' => $krakBalance, 'netMonthly' => !empty($user['annualSalaryNet']) ? (float) $user['annualSalaryNet'] / 12 : null, 'perkVia' => $chosen['perk'] ?? null, 'perkJan' => $perk['jan'] ?? null];
    if (!$chosen['events'] && !$chosen['krakSegments']) return null;
    // Attach the cashback list of each new donor used.
    foreach ($chosen['events'] as $i => $e) {
        if ($e['donor']['kind'] === 'new' && isset($donorSpecs[$e['donor']['index'] - 1])) $chosen['events'][$i]['donor']['cashbackList'] = $donorSpecs[$e['donor']['index'] - 1]['cashbackList'] ?? [];
    }
    $cards = plan_build_cards($chosen, $ctx, $cache, $rows);
    foreach (plan_krak_cards($chosen, $ctx, $cache) as $k) $cards[] = $k;

    // Fairer Share: dated steps for the Nationwide account that is held.
    if ($perk && $chosen['perk']) {
        $lines = fairer_share_steps_text($perk['def']);
        $viaSwitch = $chosen['perk']['via'] === 'switch' && ($chosen['perk']['day'] + CASS_DAYS) >= $perk['jan'];
        if (!$viaSwitch) $cards[] = ['kind' => 'perk', 'day' => $perk['jan'], 'dateLabel' => plan_label($perk['jan'], $today), 'title' => 'Fairer Share: use your Nationwide account', 'amount' => 0, 'why' => ['Nationwide pays about £100 a year to members who use their account in January–March. It is not guaranteed.'], 'actions' => [['text' => $lines['activity']]]];
        $cards[] = ['kind' => 'perk', 'day' => max(0, $perk['mar'] - 30), 'dateLabel' => plan_label(max(0, $perk['mar'] - 30), $today), 'title' => 'Fairer Share: £100 in savings, keep the account open', 'amount' => 0, 'why' => ['It also needs £100+ in a Nationwide savings account in March (one more account to open if you have none), and the current account still open on 31 March.'], 'actions' => [['text' => $lines['savings']], ['text' => 'Keep the Nationwide current account open until after 31 March — this plan does not switch it on before then.']]];
        $cards[] = ['kind' => 'perk', 'day' => $perk['pay'], 'dateLabel' => plan_label($perk['pay'], $today), 'title' => 'Fairer Share arrives (if Nationwide repeats it)', 'amount' => $perk['amount'], 'why' => ['Nationwide decides with its results in May and has paid in June for three years running.'], 'actions' => [['text' => 'Check the £100 landed. If not, check Nationwide\'s May announcement.']]];
    }
    usort($cards, fn($a, $b) => $a['day'] <=> $b['day']);

    $switches = count($chosen['events']);
    $newUsed = $chosen['newUsed'];
    $krakOpen = ($krak > 0 && $chosen['krakSegments']) ? 1 : 0;
    $savingsOpen = !empty($chosen['perk']) ? 1 : 0;
    $salaryEvents = count(array_filter($chosen['events'], fn($e) => $e['stage']['months'] > 0));
    $repoints = $salaryEvents + ($krakOpen ? count($chosen['krakSegments']) : 0);
    $opens = $newUsed + $switches + $krakOpen + $savingsOpen;
    $peak = 0.0;
    foreach ($chosen['events'] as $e) $peak = max($peak, $e['cand']['fund']);
    $money = 'plan_money';

    $parts = [sprintf('%s from %d switch bonus%s', $money($chosen['bonus']), $switches, $switches === 1 ? '' : 'es')];
    if ($chosen['cashback'] > 0) $parts[] = sprintf('%s from cashback sites', $money($chosen['cashback']));
    if ($krakOpen) $parts[] = sprintf('%s from Krak Salary Match', $money($chosen['krakValue']));
    if ($chosen['perkValue'] > 0) $parts[] = sprintf('%s from Nationwide Fairer Share if it is repeated', $money($chosen['perkValue']));
    $headline = sprintf('About %s over %d months: %s — by opening %d new account%s (%d donor%s, %d bonus account%s%s%s) and repointing your salary %d time%s.',
        $money($chosen['total']), $opt['horizonMonths'], implode(', ', $parts), $opens, $opens === 1 ? '' : 's',
        $newUsed, $newUsed === 1 ? '' : 's', $switches, $switches === 1 ? '' : 's', $krakOpen ? ', 1 Krak' : '', $savingsOpen ? ', 1 Nationwide savings' : '',
        $repoints, $repoints === 1 ? '' : 's');

    $quests = [];
    for ($i = 1; $i < count($ladder); $i++) {
        $more = count($ladder[$i]['events']) - count($ladder[$i - 1]['events']);
        $quests[] = sprintf('%s: about %s more%s, taking the total to about %s.',
            $ladder[$i]['newUsed'] === 1 ? 'Open 1 donor account' : sprintf('Open %d donor accounts', $ladder[$i]['newUsed']),
            $money($ladder[$i]['total'] - $ladder[$i - 1]['total']), $more > 0 ? sprintf(' (%d more switch%s)', $more, $more === 1 ? '' : 'es') : ' (the same switches, started sooner)', $money($ladder[$i]['total']));
    }
    $notes = [
        'A sketch, not a guarantee: it tries your current accounts plus up to three new donor accounts, in two orders, and keeps the best — it does not prove nothing better exists.',
        sprintf('Timings: a CASS switch takes about %d days; each bonus is dated from the offer\'s own terms (conditions met, then "paid within N days"); and an account is kept until its last payment plus %d days before it is switched on.', CASS_DAYS, PLAN_SAFETY_DAYS),
        'A switch must come from a different banking group than the bank you switch into, and each group pays one bonus. Offers change weekly, and banks can refuse applicants who switch repeatedly; treat later months as less certain than the first ones.',
        'Not counted: interest on the balances you hold, card-spend cashback, and ongoing perks beyond those shown on the keep-list.',
    ];
    if ($peak > 0) $notes[] = sprintf('Have about %s ready to pay in for the largest single step; it can usually be moved on afterwards, but check each offer for how long it has to stay.', $money($peak));
    $unsched = [];
    foreach ($cands as $c) {
        $took = false;
        foreach ($chosen['events'] as $e) if ($e['cand']['id'] === $c['id']) $took = true;
        if (!$took) $unsched[] = $c['product'] . ' (' . $money($c['listed']) . ')';
    }
    if ($needIncome) $notes[] = 'Not included, because they depend on your income and you have not entered it: ' . implode(', ', $needIncome) . '. Add your take-home pay (and your pay before tax) under "Your figures" to include them.';
    if ($unsched) $notes[] = 'Not fitted in: ' . implode(', ', $unsched) . ' — usually because they share a banking group with an offer that pays more, the salary is already committed, or no donor was free in time.';
    $snapshots = count($cache['history'] ?? []);
    $notes[] = sprintf('The plan takes offers as they stand today and does not time them. The page holds %d weekly snapshot%s of offer history — too little to say how often offers return or rise.', $snapshots, $snapshots === 1 ? '' : 's');

    return [
        'headline' => $headline, 'cards' => $cards, 'quests' => $quests, 'notes' => $notes,
        'endState' => plan_end_state($chosen, $ctx, $cache, $byId),
        'total' => round($chosen['total']), 'bonus' => round($chosen['bonus']), 'cashback' => round($chosen['cashback']), 'krak' => round($chosen['krakValue']),
        'fairerShare' => round($chosen['perkValue']), 'switches' => $switches, 'newDonors' => $newUsed, 'openings' => $opens, 'repoints' => $repoints,
        'horizonMonths' => $opt['horizonMonths'], 'today' => $today, 'needsIncome' => $needIncome,
    ];
}

// The simple figure shown before anyone has told the page anything: the best
// plan for someone starting from no accounts, on an ordinary income and on a
// high one. "Subject to existing accounts" -- theirs can change it either way.
function compute_opportunity(array $cache, ?string $today = null): ?array {
    $out = [];
    foreach (['standard' => [32000, 42000], 'high' => [95000, 125000]] as $k => [$net, $gross]) {
        $u = ['id' => 'opportunity', 'annualSalaryNet' => $net, 'annualSalaryGross' => $gross, 'assumedBalance' => null, 'accounts' => []];
        $rows = compute_recommendations($u, $cache);
        $plan = compute_plan_v2($u, $cache, $rows, [], $today);
        if (!$plan) continue;
        $out[$k] = ['total' => $plan['total'], 'switches' => $plan['switches'], 'bonus' => $plan['bonus']];
    }
    if (!$out) return null;
    return ['standard' => $out['standard'] ?? null, 'high' => $out['high'] ?? null];
}


// How many of the eligible switch offers you can actually claim with the
// accounts you have, and what to do about the rest. Read off the finished
// rows (each carries its donor) so it can never disagree with them. Null
// when there's nothing switch-shaped to talk about.
function compute_plan(array $rows, array $accounts): ?array {
    $names = [];
    foreach ($accounts as $a) $names[$a['id'] ?? ''] = (($a['nickname'] ?? '') ?: ($a['bank'] ?? ''));
    $assigned = [];
    $waiting = [];
    foreach ($rows as $r) {
        if (empty($r['needsSwitch'])) continue;
        if (!empty($r['fromAccountId'])) $assigned[] = $r; else $waiting[] = $r;
    }
    if (!$assigned && !$waiting) return null;
    $lines = [];
    foreach ($assigned as $r) {
        $lines[] = sprintf('%s (£%s) — switch from your %s account', $r['product'], number_format($r['amount'], 0), $names[$r['fromAccountId']] ?? 'spare');
    }
    $assignedTotal = array_sum(array_column($assigned, 'amount'));
    if ($assigned) {
        $headline = sprintf('You can claim %d of these with the account%s you have to switch away from: £%s in total.', count($assigned), count($assigned) === 1 ? '' : 's', number_format($assignedTotal, 0));
    } else {
        $headline = "None of these can be claimed yet — you have no account on file that can be switched away from.";
    }
    $howTo = [];
    if ($waiting) {
        $waitingTotal = array_sum(array_column($waiting, 'amount'));
        $plural = count($waiting) === 1 ? '' : 's';
        $lines[] = $assigned
            ? sprintf('%d more eligible offer%s (£%s in total) %s no account left to switch from.', count($waiting), $plural, number_format($waitingTotal, 0), count($waiting) === 1 ? 'has' : 'have')
            : sprintf('%d offer%s (£%s in total) %s waiting for an account to switch from.', count($waiting), $plural, number_format($waitingTotal, 0), count($waiting) === 1 ? 'is' : 'are');
        $howTo = [
            "Open another current account with a bank that's in CASS (the CASS map tab shows which of your banks are) and move the Direct Debits that offer needs onto it, then switch from that one. Each extra account you can switch away from is one more switch.",
            "Or take them in turn: once a switch has paid out and you've met its conditions (some need pay-ins for several months), the account you switched INTO can be the next one you switch away from.",
            "Check each offer's Terms first — they can bar switching from the same banking group, and every new account application can leave a mark on your credit file.",
        ];
    }
    return ['headline' => $headline, 'lines' => $lines, 'waiting' => count($waiting), 'howTo' => $howTo];
}

// Krak "Salary Match", per Krak's own help page (see the cache's
// krakTiersSource): the reward is a PERCENTAGE OF EACH SALARY PAYMENT,
// not of your balance. Your average balance over the last 30 days only
// decides which percentage tier you are in. At least krakSalaryMin a
// month of salary is needed to qualify, and salary above krakSalaryCap a
// month isn't counted. This used to apply the percentage to the balance
// as an annual rate -- a misreading of the plan's own wording, caught
// when the figures didn't match how the scheme actually pays out.
function compute_krak_row(array $user, array $cache): array {
    $tiers = $cache['krakTiers'] ?? [];
    usort($tiers, fn($a, $b) => ($a['minBalance'] ?? 0) <=> ($b['minBalance'] ?? 0));
    $minSalary = (float) ($cache['krakSalaryMin'] ?? 2500);
    $salaryCap = (float) ($cache['krakSalaryCap'] ?? 25000);
    $sourceNote = (string) ($cache['krakTiersSource'] ?? '');
    $row = [
        'bank' => 'Kraken',
        'product' => 'Krak Salary Match',
        'action' => 'open',
        'fromAccountId' => null,
        'amount' => 0,
        'monthly' => 0,
        'eligible' => true,
        'priority' => 'low',
        'todo' => [],
        'ideas' => [],
        'cashback' => [],
        'rationale' => '',
        'url' => 'https://support.krak.app/articles/krak-salary-match',
        'conditions' => sprintf(
            'Needs at least £%s a month of salary paid in by Faster Payments (UK) or SEPA (EU), straight from an employer or other third party, on a regular pattern; a verified Krak account; UK or listed EU/EEA residence. Your tier uses your average total balance across Krak, Kraken and Kraken Pro over the last 30 days, recalculated monthly; the reward is paid at the start of the following month. Tiers last read %s.',
            number_format($minSalary, 0),
            $cache['krakTiersAsOf'] ?? 'unknown'
        ),
    ];
    $salary = $user['annualSalaryNet'] ?? null;
    if (!$salary || (float) $salary <= 0) {
        $row['rationale'] = 'Enter your net annual salary in the profile section above to estimate this — Krak pays a percentage of each salary payment.';
        return $row;
    }
    $monthlySalary = (float) $salary / 12;
    $assumed = $user['assumedBalance'] ?? null;
    $usedAssumed = ($assumed === null || $assumed === '');
    $balance = $usedAssumed ? $monthlySalary * 2 : (float) $assumed;
    $balanceNote = $usedAssumed
        ? sprintf("assuming a £%s average balance (2 months' net salary — enter your own figure in the profile above)", number_format($balance, 0))
        : sprintf('with your stated £%s average balance', number_format($balance, 0));
    if ($monthlySalary < $minSalary) {
        $row['rationale'] = sprintf("Krak needs at least £%s a month of salary paid in to qualify; yours is about £%s a month, so there's no reward at that level.", number_format($minSalary, 0), number_format($monthlySalary, 0));
        return $row;
    }
    $tier = null;
    foreach ($tiers as $t) {
        if ($balance >= ($t['minBalance'] ?? 0)) $tier = $t;
    }
    $percent = $tier ? (float) ($tier['percent'] ?? 0) : 0.0;
    if ($percent <= 0) {
        $firstPaying = null;
        foreach ($tiers as $t) {
            if (($t['percent'] ?? 0) > 0) { $firstPaying = $t; break; }
        }
        $row['rationale'] = $firstPaying
            ? sprintf('0%% on a £%s average balance (%s) — the first paying tier needs £%s or more, so nothing here until you hold that.', number_format($balance, 0), $usedAssumed ? 'assumed' : 'your figure', number_format((float) ($firstPaying['minBalance'] ?? 0), 0))
            : '0% at this balance.';
        return $row;
    }
    $counted = min($monthlySalary, $salaryCap);
    $monthly = $counted * $percent / 100;
    $annual = $monthly * 12;
    $tierName = (string) ($tier['name'] ?? '');
    $capNote = $monthlySalary > $salaryCap ? sprintf(' (only the first £%s of salary counts)', number_format($salaryCap, 0)) : '';
    $row['amount'] = round($annual, 2);
    $row['monthly'] = round($monthly, 2); // what the salary planner weighs a month of salary elsewhere against
    $row['priority'] = priority_band($annual);
    $row['rationale'] = sprintf(
        '≈£%s a month, £%s over a year — ongoing for as long as your salary keeps landing and your balance stays up, not a one-off. That is %s%% of each ~£%s salary payment%s%s, which needs a £%s+ average balance — %s.%s',
        number_format($monthly, 2),
        number_format($annual, 0),
        rtrim(rtrim(number_format($percent, 2), '0'), '.'),
        number_format($monthlySalary, 0),
        $capNote,
        $tierName !== '' ? " at the {$tierName} tier" : '',
        number_format((float) ($tier['minBalance'] ?? 0), 0),
        $balanceNote,
        $sourceNote !== '' ? ' ' . $sourceNote : ''
    );
    return $row;
}

// A fixed, simple grid: every open account, plus CASS switch-history
// edges (donor -> recipient) between accounts that record one. The
// frontend lays this out 3-wide, wrapping — see js/cass.js.
function compute_cass_grid(array $user, array $cache): array {
    $accounts = $user['accounts'] ?? [];
    $participants = $cache['cassParticipants'] ?? [];
    $nodes = [];
    foreach ($accounts as $a) {
        $nodes[] = [
            'id' => $a['id'],
            'bank' => $a['bank'] ?? '',
            'nickname' => $a['nickname'] ?? '',
            'open' => empty($a['closeDate']),
            'cassReady' => is_cass_ready($a),
            'cassStatus' => is_cass_participant((string) ($a['bank'] ?? ''), $participants),
        ];
    }
    $edges = [];
    foreach ($accounts as $a) {
        // cassFromAccountId mirrors financeaccounts.js's own field name —
        // same "the switch date IS the CASS date" reasoning: no separate
        // date field, openDate of the recipient account already carries it.
        if (!empty($a['cassFromAccountId'])) {
            $edges[] = ['from' => $a['cassFromAccountId'], 'to' => $a['id'], 'label' => $a['openDate'] ?? ''];
        }
    }
    return ['nodes' => $nodes, 'edges' => $edges];
}

// ---- Auth ----------------------------------------------------------

function find_user_by_token(array $data, string $token): ?array {
    if ($token === '') return null;
    $hash = hash('sha256', $token);
    foreach ($data['invites'] as $inv) {
        if (!hash_equals((string) ($inv['tokenHash'] ?? ''), $hash)) continue;
        if (empty($inv['userId'])) return null;
        foreach ($data['users'] as $u) {
            if ($u['id'] === $inv['userId']) return $u;
        }
    }
    return null;
}

function require_admin(string $adminSecret, string $configured): void {
    if ($configured === '' || strpos($configured, 'PUT-') === 0) fail(500, 'Server not configured: set $ADMIN_SECRET');
    if (!hash_equals($configured, $adminSecret)) fail(401, 'Bad or missing admin secret');
}

// ---- Routing ---------------------------------------------------------

$action = $_GET['action'] ?? '';
$method = $_SERVER['REQUEST_METHOD'] ?? 'GET';
$bodyRaw = file_get_contents('php://input') ?: '';
$body = json_decode($bodyRaw, true);
if (!is_array($body)) $body = [];

// Known acronyms/brand casings generic title-casing can't get right on
// its own -- applied word-by-word after cleanup, not as whole-string
// overrides, so "hsbc uk bank plc", "HSBC Private Bank" and "HSBC
// (Channel Islands, Isle of Man)" all come out correctly cased without
// three separate entries in this table.
$BANK_WORD_OVERRIDES = [
    'aib' => 'AIB', 'ni' => 'NI', 'gb' => 'GB', 'uk' => 'UK',
    'hsbc' => 'HSBC', 'tsb' => 'TSB', 'natwest' => 'NatWest',
];
// A couple of names generic cleanup genuinely can't fix word-by-word --
// Tide's own CASS listing carries its banking partner in the name
// ("– provided by Clearbank"), which is marketing fine print, not
// something anyone would type into an account form.
$BANK_FULL_OVERRIDES = [
    'tide – provided by clearbank' => 'Tide',
    'tide - provided by clearbank' => 'Tide',
];

// Turns the raw scraped CASS participant list ("hsbc uk bank plc", all
// lowercase) into names someone would actually recognise and pick from a
// dropdown. Deliberately does NOT strip "co." as a bare corporate suffix
// -- confirmed live as a real corruption risk: "c. hoare & co." and
// "rothschild & co" both have "& Co" as part of the REAL brand name, not
// legal boilerplate, so a blanket "strip trailing co." rule would mangle
// them into "C. Hoare &" with a dangling ampersand.
function clean_bank_display_name(string $raw): string {
    global $BANK_WORD_OVERRIDES, $BANK_FULL_OVERRIDES;
    $s = trim($raw);
    if ($s === '') return '';
    $key = mb_strtolower($s);
    if (isset($BANK_FULL_OVERRIDES[$key])) return $BANK_FULL_OVERRIDES[$key];
    $s = preg_replace('/,?\s*\b(plc|ltd\.?|limited)\s*$/i', '', $s) ?? $s;
    $s = trim($s, " \t\n\r\0\x0B,.");
    if ($s === '') return '';
    $lowerConnectors = ['of', 'and', 'the', 'for'];
    $tokens = preg_split('/(\s+)/', $s, -1, PREG_SPLIT_DELIM_CAPTURE) ?: [$s];
    $out = '';
    $wordIndex = 0;
    foreach ($tokens as $tok) {
        if (trim($tok) === '') { $out .= $tok; continue; } // whitespace run between words
        if (preg_match('/^([^a-zA-Z]*)([a-zA-Z]+)([^a-zA-Z]*)$/', $tok, $m)) {
            [, $pre, $core, $post] = $m;
            $bare = mb_strtolower($core);
            if (isset($BANK_WORD_OVERRIDES[$bare])) {
                $cased = $BANK_WORD_OVERRIDES[$bare];
            } elseif ($wordIndex > 0 && in_array($bare, $lowerConnectors, true)) {
                $cased = $bare;
            } else {
                $cased = mb_strtoupper(mb_substr($core, 0, 1)) . mb_strtolower(mb_substr($core, 1));
            }
            $out .= $pre . $cased . $post;
        } elseif (preg_match('/[a-zA-Z]/', $tok)) {
            // Hyphenated ("co-operative"): the pattern above only takes a
            // single run of letters, so this would otherwise be left
            // lowercase. Capitalise the first letter only -> "Co-operative".
            $out .= mb_strtoupper(mb_substr($tok, 0, 1)) . mb_strtolower(mb_substr($tok, 1));
        } else {
            $out .= $tok; // punctuation-only token (e.g. a bare "&")
        }
        $wordIndex++;
    }
    return trim($out);
}

if ($action === 'banklist') {
    $cache = read_doc($CACHE_FILE, $EMPTY_CACHE);
    // Offer bank names first (already hand-written, cleanest casing) so
    // they win the dedupe below; cleaned CASS names fill in the rest.
    $candidates = array_merge(
        array_map(fn($o) => (string) $o['bank'], $cache['offers'] ?? []),
        array_map('clean_bank_display_name', $cache['cassParticipants'] ?? [])
    );
    // Exact match on a key, NOT bank_names_match()'s substring test: that
    // is right for eligibility (does your "HSBC" account count as the
    // offer's HSBC?) but wrong for a picker -- it folded "Royal Bank of
    // Scotland" into "Bank of Scotland", two different banks in different
    // groups, so RBS vanished from the list. This key only drops generic
    // suffixes (UK / Private / International) and parentheticals, so
    // "HSBC UK Bank", "HSBC Private Bank" and "HSBC (Channel Islands...)"
    // still collapse into "HSBC".
    $listKey = function (string $n): string {
        $k = normalize_bank_name($n);
        $k = preg_replace('/\b(uk|private|international)\b/', ' ', $k) ?? $k;
        return trim(preg_replace('/\s+/', ' ', $k) ?? $k);
    };
    $names = [];
    $seenKeys = [];
    foreach ($candidates as $name) {
        if ($name === '') continue;
        $key = $listKey($name);
        if ($key === '' || isset($seenKeys[$key])) continue;
        $seenKeys[$key] = true;
        $names[] = $name;
    }
    sort($names, SORT_FLAG_CASE | SORT_STRING);
    echo json_encode(['banks' => $names]);
    exit;
}

if ($action === 'referrals') {
    $cache = read_doc($CACHE_FILE, $EMPTY_CACHE);
    echo json_encode([
        'krakTiers' => $cache['krakTiers'] ?? [],
        'krakSalaryMin' => $cache['krakSalaryMin'] ?? null,
        'krakSalaryCap' => $cache['krakSalaryCap'] ?? null,
        'krakTiersAsOf' => $cache['krakTiersAsOf'] ?? null,
        // Surfaced so the frontend can say whether these are confirmed by
        // a real scrape or still the figures seeded at build time --
        // never present an unverified number as settled fact.
        'krakTiersSource' => $cache['krakTiersSource'] ?? null,
    ]);
    exit;
}

// Public and read-only — this is the SAME scraped MSE/CASS data this
// app's own recommendation engine uses, re-published whole. It exists so
// the personal dashboard's own js/features/switchoffers.js can read it
// too instead of running its own separate weekly scrape + AI-parse of
// the identical page — one scrape, one source of structured offers, not
// two that can quietly drift apart. Nothing here is per-user or
// sensitive: it's exactly what MSE's and CASS's own public pages already
// show anyone.
if ($action === 'offers') {
    $cache = normalise_cache(read_doc($CACHE_FILE, $EMPTY_CACHE));
    echo json_encode([
        'offers' => $cache['offers'] ?? [],
        'bankGroups' => $cache['bankGroups'] ?? [],
        'ongoingAccounts' => $cache['ongoingAccounts'] ?? [],
        'annualPerks' => $cache['annualPerks'] ?? [],
        'history' => $cache['history'] ?? [],
        'cassParticipants' => $cache['cassParticipants'] ?? [],
        'krakTiers' => $cache['krakTiers'] ?? [],
        'scrapedAt' => $cache['scrapedAt'] ?? null,
    ]);
    exit;
}

if ($action === 'redeem' && $method === 'POST') {
    $token = (string) ($body['token'] ?? '');
    if ($token === '' || strlen($token) < 16) fail(400, 'No invite token given');
    $hash = hash('sha256', $token);
    $result = locked_read_modify_write($DATA_FILE, $EMPTY_DATA, function ($doc) use ($hash) {
        $found = null;
        foreach ($doc['invites'] as &$inv) {
            if (!hash_equals((string) ($inv['tokenHash'] ?? ''), $hash)) continue;
            $found = &$inv;
            break;
        }
        unset($inv);
        if (!$found) return ['doc' => $doc, 'return' => ['error' => 'not_found']];
        $now = gmdate('c');
        if (empty($found['userId'])) {
            $user = [
                'id' => bin2hex(random_bytes(8)),
                'email' => '', 'createdAt' => $now, 'lastSeenAt' => $now,
                'accounts' => [],
            ];
            $doc['users'][] = $user;
            $found['userId'] = $user['id'];
        }
        $found['lastRedeemedAt'] = $now;
        foreach ($doc['users'] as &$u) {
            if ($u['id'] === $found['userId']) { $u['lastSeenAt'] = $now; $user = $u; break; }
        }
        unset($u);
        return ['doc' => $doc, 'return' => ['user' => sanitize_user($user)]];
    });
    if (isset($result['error'])) fail(401, 'That invite link is not valid.');
    echo json_encode($result);
    exit;
}

if ($action === 'invite-create' && $method === 'POST') {
    require_admin((string) ($_SERVER['HTTP_X_ADMIN_SECRET'] ?? ''), $ADMIN_SECRET);
    $label = trim((string) ($body['label'] ?? ''));
    if ($label === '') $label = 'A person';
    $token = bin2hex(random_bytes(16));
    locked_read_modify_write($DATA_FILE, $EMPTY_DATA, function ($doc) use ($label, $token) {
        $doc['invites'][] = ['id' => bin2hex(random_bytes(6)), 'tokenHash' => hash('sha256', $token), 'label' => $label, 'createdAt' => gmdate('c'), 'userId' => null, 'lastRedeemedAt' => null];
        return ['doc' => $doc, 'return' => null];
    });
    echo json_encode(['token' => $token]);
    exit;
}

if ($action === 'invite-list' && $method === 'GET') {
    require_admin((string) ($_SERVER['HTTP_X_ADMIN_SECRET'] ?? ''), $ADMIN_SECRET);
    $doc = read_doc($DATA_FILE, $EMPTY_DATA);
    $usersById = [];
    foreach ($doc['users'] as $u) $usersById[$u['id']] = $u;
    $invites = array_map(function ($inv) use ($usersById) {
        $user = $inv['userId'] ? ($usersById[$inv['userId']] ?? null) : null;
        return [
            'id' => $inv['id'], 'label' => $inv['label'], 'createdAt' => $inv['createdAt'],
            'redeemed' => (bool) $inv['userId'], 'lastRedeemedAt' => $inv['lastRedeemedAt'] ?? null,
            'userEmail' => $user['email'] ?? '', 'accountCount' => $user ? count($user['accounts'] ?? []) : 0,
        ];
    }, $doc['invites']);
    echo json_encode(['invites' => $invites]);
    exit;
}

// ---- Everything below needs a resolved user ---------------------------

$token = (string) ($_SERVER['HTTP_X_INVITE_TOKEN'] ?? '');
$doc = read_doc($DATA_FILE, $EMPTY_DATA);
$user = find_user_by_token($doc, $token);
if (!$user) fail(401, 'Bad or missing invite token');

// Salary figures are used live and never kept: the browser holds them and sends
// them with each request. Anything an earlier version stored is wiped here.
if ($action === 'me') {
    if (!empty($user['annualSalaryNet']) || !empty($user['annualSalaryGross']) || !empty($user['assumedBalance'])) {
        $uid = $user['id'];
        locked_read_modify_write($DATA_FILE, $EMPTY_DATA, function ($doc) use ($uid) {
            foreach ($doc['users'] as &$u) {
                if ($u['id'] !== $uid) continue;
                unset($u['annualSalaryNet'], $u['annualSalaryGross'], $u['assumedBalance']);
            }
            return ['doc' => $doc, 'return' => null];
        });
    }
    $live = fn(string $k) => (isset($body[$k]) && is_numeric($body[$k]) && (float) $body[$k] >= 0) ? (float) $body[$k] : null;
    $user['annualSalaryNet'] = $live('annualSalaryNet');
    $user['annualSalaryGross'] = $live('annualSalaryGross');
    $user['assumedBalance'] = $live('assumedBalance');
    $cache = normalise_cache(read_doc($CACHE_FILE, $EMPTY_CACHE));
    $recommendations = compute_recommendations($user, $cache);
    // The plan options (how far ahead, fewest switches, keep a primary account...)
    // are preferences, not secrets, but like the salary figures they come with the
    // request rather than being stored.
    $options = is_array($body['options'] ?? null) ? $body['options'] : [];
    echo json_encode([
        'user' => sanitize_user($user),
        'recommendations' => $recommendations,
        'plan' => compute_plan($recommendations, $user['accounts'] ?? []),
        'actionPlan' => compute_plan_v2($user, $cache, $recommendations, $options),
        'opportunity' => compute_opportunity($cache),
        'annualPerks' => compute_annual_perks($user, $cache),
        'cassGrid' => compute_cass_grid($user, $cache),
        'cacheAsOf' => $cache['scrapedAt'] ?? null,
    ]);
    exit;
}

if ($action === 'update-profile' && $method === 'POST') {
    $userId = $user['id'];
    $result = locked_read_modify_write($DATA_FILE, $EMPTY_DATA, function ($doc) use ($userId, $body) {
        foreach ($doc['users'] as &$u) {
            if ($u['id'] !== $userId) continue;
            if (array_key_exists('email', $body)) $u['email'] = trim((string) $body['email']);
            $u['lastSeenAt'] = gmdate('c');
            return ['doc' => $doc, 'return' => sanitize_user($u)];
        }
        return ['doc' => $doc, 'return' => null];
    });
    echo json_encode(['user' => $result]);
    exit;
}

if ($action === 'account-upsert' && $method === 'POST') {
    $userId = $user['id'];
    $account = is_array($body['account'] ?? null) ? $body['account'] : null;
    if (!$account || empty($account['bank'])) fail(400, 'An account needs at least a bank');
    $result = locked_read_modify_write($DATA_FILE, $EMPTY_DATA, function ($doc) use ($userId, $account) {
        foreach ($doc['users'] as &$u) {
            if ($u['id'] !== $userId) continue;
            $id = $account['id'] ?? '';
            $clean = [
                'id' => $id ?: bin2hex(random_bytes(6)),
                'bank' => (string) $account['bank'],
                'nickname' => (string) ($account['nickname'] ?? ''),
                'openDate' => (string) ($account['openDate'] ?? ''),
                'closeDate' => (string) ($account['closeDate'] ?? ''),
                'wantToKeep' => $account['wantToKeep'] ?? null,
                'directDebitCount' => $account['directDebitCount'] ?? null,
                'cassFromAccountId' => (string) ($account['cassFromAccountId'] ?? ''),
                'switchBonuses' => $account['switchBonuses'] ?? [],
            ];
            $accounts = $u['accounts'] ?? [];
            $idx = null;
            foreach ($accounts as $i => $a) { if ($a['id'] === $clean['id']) { $idx = $i; break; } }
            if ($idx === null) $accounts[] = $clean; else $accounts[$idx] = $clean;
            $u['accounts'] = $accounts;
            $u['lastSeenAt'] = gmdate('c');
            return ['doc' => $doc, 'return' => sanitize_user($u)];
        }
        return ['doc' => $doc, 'return' => null];
    });
    echo json_encode(['user' => $result]);
    exit;
}

if ($action === 'account-delete' && $method === 'POST') {
    $userId = $user['id'];
    $id = (string) ($body['id'] ?? '');
    if ($id === '') fail(400, 'No account id given');
    $result = locked_read_modify_write($DATA_FILE, $EMPTY_DATA, function ($doc) use ($userId, $id) {
        foreach ($doc['users'] as &$u) {
            if ($u['id'] !== $userId) continue;
            $u['accounts'] = array_values(array_filter($u['accounts'] ?? [], fn($a) => $a['id'] !== $id));
            return ['doc' => $doc, 'return' => sanitize_user($u)];
        }
        return ['doc' => $doc, 'return' => null];
    });
    echo json_encode(['user' => $result]);
    exit;
}

fail(400, 'Unknown action');
