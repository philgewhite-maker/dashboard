# Copy to .env next to docker-compose.yml.

# The share holding your media. \\QNAP210-79\Media is this, seen from the
# NAS itself. Check it exists before starting anything:
#   ls /share/Media
# Some QNAPs only have the raw volume path, in which case use that instead:
#   ls /share/CACHEDEV1_DATA/Media
MEDIA_ROOT=/share/Media

# Where each app keeps its own database and settings. /share/Container is
# QNAP's usual home for this; it must NOT be inside MEDIA_ROOT.
CONFIG_ROOT=/share/Container/arr

# Who the containers run as. Get the real numbers with:
#   id admin
# and use the uid= and gid= it prints. If the apps can see files but
# can't move or rename them, this pair is almost always why.
PUID=1000
PGID=100

TZ=Europe/London
